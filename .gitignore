# Only the port's own sources: the game, its recompiled code, builds and IPAs stay out.
/*
!/.gitignore
!/.gitmodules
!/README.md
!/legends/
!/tools/
!/docs/
!/patches/
!/rexglue-sdk

legends/out/
legends/generated/*
!legends/generated/rexglue.cmake
legends/art/
legends/ios/LauncherArt.png
legends/ios/*.mobileprovision
__pycache__/
.DS_Store
