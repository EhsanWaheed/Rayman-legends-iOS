+/**
+ * @file        graphics/metal/command_processor.cpp
+ * @brief       The Xenos command processor on Metal (command_processor.h)
+ *
+ * The draw path follows the Vulkan command processor (Xenia, BSD): the same primitive processing, shader
+ * translation, system constants and render target cache; on Metal, bindings are set on the encoder
+ * (Metal 3) or its argument tables (Metal 4) directly, and constants come from a per-frame upload ring.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+
+#include <rex/assert.h>
+#include <rex/cvar.h>
+#include <rex/graphics/flags.h>
+#include <rex/graphics/metal/command_processor.h>
+#include <rex/graphics/vulkan/frame_stats.h>
+#include <rex/kernel/xboxkrnl/video.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/memory.h>
+#include <rex/ui/metal/presenter.h>
+#include <rex/ui/presenter.h>
+
+REXCVAR_DECLARE(bool, metal4);
+REXCVAR_DECLARE(bool, present_guest_output_aspect);
+REXCVAR_DECLARE(int32_t, present_guest_output_width);
+
+namespace rex::graphics::metal {
+
+using ui::metal::Ref;
+using vulkan::g_rl_stats;
+
+namespace {
+
+// The guest's gamma ramps applied to the front buffer, into the presenter's guest output texture.
+constexpr char kSwapShaderSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+// 256 entries of DC_LUT_30_COLOR: blue in bits 0:9, green 10:19, red 20:29.
+kernel void rex_swap_gamma_table(texture2d<float, access::read> source [[texture(0)]],
+                                 texture2d<float, access::write> dest [[texture(1)]],
+                                 const device uint* ramp [[buffer(0)]],
+                                 constant uint2& size [[buffer(1)]],
+                                 uint2 pixel [[thread_position_in_grid]]) {
+  if (any(pixel >= size)) {
+    return;
+  }
+  uint3 index = uint3(source.read(pixel).rgb * 255.0 + 0.5);
+  float3 color = float3(float((ramp[index.r] >> 20) & 1023u), float((ramp[index.g] >> 10) & 1023u),
+                        float(ramp[index.b] & 1023u)) *
+                 (1.0 / 1023.0);
+  dest.write(float4(color, 1.0), pixel);
+}
+
+// 128 entries per channel (interleaved RGB) of DC_LUT_PWL_DATA: base in bits 0:15, delta 16:31.
+float rex_apply_pwl(const device uint* ramp, uint value_10b, uint channel) {
+  uint entry = ramp[(value_10b >> 3) * 3 + channel];
+  float value = float(entry & 0xFFFFu) + float((value_10b & 7u) * (entry >> 16)) * 0.125;
+  return clamp(value * 1.52737048e-05, 0.0, 1.0);
+}
+
+kernel void rex_swap_gamma_pwl(texture2d<float, access::read> source [[texture(0)]],
+                               texture2d<float, access::write> dest [[texture(1)]],
+                               const device uint* ramp [[buffer(0)]],
+                               constant uint2& size [[buffer(1)]],
+                               uint2 pixel [[thread_position_in_grid]]) {
+  if (any(pixel >= size)) {
+    return;
+  }
+  uint3 value = uint3(source.read(pixel).rgb * 1023.0 + 0.5);
+  dest.write(float4(rex_apply_pwl(ramp, value.r, 0), rex_apply_pwl(ramp, value.g, 1),
+                    rex_apply_pwl(ramp, value.b, 2), 1.0),
+             pixel);
+}
+)";
+
+}  // namespace
+
+MetalCommandProcessor::MetalCommandProcessor(MetalGraphicsSystem* graphics_system,
+                                             system::KernelState* kernel_state)
+    : CommandProcessor(graphics_system, kernel_state) {}
+
+MetalCommandProcessor::~MetalCommandProcessor() = default;
+
+void MetalCommandProcessor::ClearCaches() {
+  CommandProcessor::ClearCaches();
+  InvalidateAllVertexBufferResidency();
+}
+
+void MetalCommandProcessor::InvalidateGpuMemory() {
+  if (shared_memory_) {
+    shared_memory_->InvalidateAllPages();
+  }
+}
+
+bool MetalCommandProcessor::SetupContext() {
+  if (!CommandProcessor::SetupContext()) {
+    REXGPU_ERROR("MetalCommandProcessor: the base command processor failed to set up");
+    return false;
+  }
+  if (REXCVAR_GET(metal4) && provider().supports_metal4() && !InitializeMetal4()) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to set up Metal 4, using Metal 3");
+  }
+  shared_memory_ = std::make_unique<MetalSharedMemory>(*this, *memory_);
+  if (!shared_memory_->Initialize()) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to set up the shared memory");
+    return false;
+  }
+  primitive_processor_ =
+      std::make_unique<MetalPrimitiveProcessor>(*register_file_, *memory_, *shared_memory_, *this);
+  if (!primitive_processor_->Initialize()) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to set up the primitive processor");
+    return false;
+  }
+  render_target_cache_ = std::make_unique<MetalRenderTargetCache>(*register_file_, *memory_, *this);
+  if (!render_target_cache_->Initialize()) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to set up the render target cache");
+    return false;
+  }
+  texture_cache_ = MetalTextureCache::Create(*register_file_, *shared_memory_, *this);
+  if (!texture_cache_) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to set up the texture cache");
+    return false;
+  }
+  pipeline_cache_ =
+      std::make_unique<MetalPipelineCache>(*this, *register_file_, *render_target_cache_);
+  if (!pipeline_cache_->Initialize(shared_memory_->buffer_count_log2())) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to set up the pipeline cache");
+    return false;
+  }
+  if (!InitializeSwapPipelines()) {
+    return false;
+  }
+  std::memset(&system_constants_, 0, sizeof(system_constants_));
+  current_constant_buffers_up_to_date_ = 0;
+  InvalidateAllVertexBufferResidency();
+  encoder_labels_ = std::getenv("RL_GPU_LABELS") != nullptr;
+  REXGPU_INFO("MetalCommandProcessor: native Metal GPU emulation ready (Metal {})", metal4_ ? 4 : 3);
+  return true;
+}
+
+void MetalCommandProcessor::ShutdownContext() {
+  EndSubmission();
+  AwaitAllSubmissions();
+  pipeline_cache_.reset();
+  texture_cache_.reset();
+  render_target_cache_.reset();
+  primitive_processor_.reset();
+  swap_gamma_table_pipeline_.reset();
+  swap_gamma_pwl_pipeline_.reset();
+  for (UploadChunk& chunk : upload_chunks_) {
+    ReleaseResident(chunk.buffer.get());
+  }
+  upload_chunks_.clear();
+  for (UploadChunk& chunk : scratch_chunks_) {
+    ReleaseResident(chunk.buffer.get());
+  }
+  scratch_chunks_.clear();
+  shared_memory_.reset();
+  // Everything is complete: the deferred releases too.
+  submission_completed_processed_ = 0;
+  CompletedSubmissionUpdated();
+  for (const DeferredRelease& release : deferred_releases_) {
+    release.object->release();
+  }
+  deferred_releases_.clear();
+  if (metal4_) {
+    provider().SetGuestOutputWritten(nullptr, 0);
+  }
+  guest_output_residency_set_.reset();
+  residency_set_.reset();
+  for (auto& table : argument_tables4_) {
+    table.reset();
+  }
+  allocators4_.clear();
+  command_buffer4_.reset();
+  queue4_.reset();
+  CommandProcessor::ShutdownContext();
+}
+
+bool MetalCommandProcessor::InitializeMetal4() {
+  MTL::Device* metal_device = device();
+  MTL4::CommandQueueDescriptor* queue_descriptor = MTL4::CommandQueueDescriptor::alloc()->init();
+  queue_descriptor->setLabel(NS::String::string("rex guest", NS::UTF8StringEncoding));
+  queue4_ = Ref<MTL4::CommandQueue>(metal_device->newMTL4CommandQueue(queue_descriptor, nullptr));
+  queue_descriptor->release();
+  command_buffer4_ = Ref<MTL4::CommandBuffer>(metal_device->newCommandBuffer());
+  submission_event_ = Ref<MTL::SharedEvent>(metal_device->newSharedEvent());
+  if (!queue4_ || !command_buffer4_ || !submission_event_) {
+    return false;
+  }
+  for (uint32_t i = 0; i < 3; ++i) {
+    MTL4::ArgumentTableDescriptor* descriptor = MTL4::ArgumentTableDescriptor::alloc()->init();
+    descriptor->setMaxBufferBindCount(kMetalMaxBufferBindings);
+    descriptor->setMaxTextureBindCount(kMetalMaxTextureBindings);
+    descriptor->setMaxSamplerStateBindCount(kMetalMaxSamplerBindings);
+    NS::Error* error = nullptr;
+    argument_tables4_[i] = Ref<MTL4::ArgumentTable>(metal_device->newArgumentTable(descriptor, &error));
+    descriptor->release();
+    if (!argument_tables4_[i]) {
+      REXGPU_ERROR("MetalCommandProcessor: failed to create an argument table: {}",
+                   error ? error->localizedDescription()->utf8String() : "unknown error");
+      return false;
+    }
+  }
+  for (Ref<MTL::ResidencySet>* set : {&residency_set_, &guest_output_residency_set_}) {
+    MTL::ResidencySetDescriptor* descriptor = MTL::ResidencySetDescriptor::alloc()->init();
+    descriptor->setInitialCapacity(set == &residency_set_ ? 1024 : 1);
+    NS::Error* error = nullptr;
+    *set = Ref<MTL::ResidencySet>(metal_device->newResidencySet(descriptor, &error));
+    descriptor->release();
+    if (!*set) {
+      REXGPU_ERROR("MetalCommandProcessor: failed to create a residency set: {}",
+                   error ? error->localizedDescription()->utf8String() : "unknown error");
+      return false;
+    }
+    queue4_->addResidencySet(set->get());
+  }
+  metal4_ = true;
+  return true;
+}
+
+bool MetalCommandProcessor::InitializeSwapPipelines() {
+  NS::Error* error = nullptr;
+  MTL::CompileOptions* options = MTL::CompileOptions::alloc()->init();
+  Ref<MTL::Library> library(device()->newLibrary(
+      NS::String::string(kSwapShaderSource, NS::UTF8StringEncoding), options, &error));
+  options->release();
+  if (!library) {
+    REXGPU_ERROR("MetalCommandProcessor: swap shaders: {}",
+                 error ? error->localizedDescription()->utf8String() : "unknown error");
+    return false;
+  }
+  auto make = [&](const char* name) {
+    Ref<MTL::Function> function(
+        library->newFunction(NS::String::string(name, NS::UTF8StringEncoding)));
+    NS::Error* pipeline_error = nullptr;
+    return Ref<MTL::ComputePipelineState>(
+        function ? device()->newComputePipelineState(function.get(), &pipeline_error) : nullptr);
+  };
+  swap_gamma_table_pipeline_ = make("rex_swap_gamma_table");
+  swap_gamma_pwl_pipeline_ = make("rex_swap_gamma_pwl");
+  if (!swap_gamma_table_pipeline_ || !swap_gamma_pwl_pipeline_) {
+    REXGPU_ERROR("MetalCommandProcessor: failed to create the swap pipelines");
+    return false;
+  }
+  return true;
+}
+
+// Submissions and frames.
+
+void MetalCommandProcessor::BeginSubmissionIfNeeded() {
+  if (submission_open_) {
+    return;
+  }
+  CompletedSubmissionUpdated();
+  if (metal4_) {
+    // An allocator the GPU is done with, or a new one.
+    const uint64_t completed = GetCompletedSubmission();
+    Allocator4* chosen = nullptr;
+    for (Allocator4& allocator : allocators4_) {
+      if (allocator.last_submission <= completed) {
+        chosen = &allocator;
+        chosen->allocator->reset();
+        break;
+      }
+    }
+    if (!chosen) {
+      allocators4_.emplace_back();
+      chosen = &allocators4_.back();
+      chosen->allocator = Ref<MTL4::CommandAllocator>(device()->newCommandAllocator());
+    }
+    chosen->last_submission = submission_current_;
+    command_buffer4_->beginCommandBuffer(chosen->allocator.get());
+  } else {
+    // Retained references (Metal's default): resources stay alive until the commands using them complete.
+    command_buffer_ = Ref<MTL::CommandBuffer>::Retain(queue()->commandBuffer());
+  }
+  submission_open_ = true;
+  if (texture_cache_) {
+    texture_cache_->BeginSubmission(submission_current_);
+  }
+}
+
+void MetalCommandProcessor::CompletedSubmissionUpdated() {
+  uint64_t completed = GetCompletedSubmission();
+  if (completed == submission_completed_processed_) {
+    return;
+  }
+  submission_completed_processed_ = completed;
+  while (!frame_submissions_.empty() && frame_submissions_.front().second <= completed) {
+    frame_completed_ = frame_submissions_.front().first;
+    frame_submissions_.pop_front();
+  }
+  while (!deferred_releases_.empty() && deferred_releases_.front().submission <= completed) {
+    const DeferredRelease& release = deferred_releases_.front();
+    if (release.resident) {
+      residency_set_->removeAllocation(static_cast<MTL::Allocation*>(release.object));
+      residency_set_dirty_ = true;
+    }
+    release.object->release();
+    deferred_releases_.pop_front();
+  }
+  if (texture_cache_) {
+    texture_cache_->CompletedSubmissionUpdated(completed);
+  }
+}
+
+void MetalCommandProcessor::EndSubmission() {
+  if (!submission_open_) {
+    return;
+  }
+  EndEncoding();
+  const uint64_t submission = submission_current_++;
+  if (metal4_) {
+    command_buffer4_->endCommandBuffer();
+    if (residency_set_dirty_) {
+      residency_set_->commit();
+      residency_set_dirty_ = false;
+    }
+    const MTL4::CommandBuffer* command_buffers[] = {command_buffer4_.get()};
+    queue4_->commit(command_buffers, 1);
+    queue4_->signalEvent(submission_event_.get(), submission);
+  } else {
+    command_buffer_->addCompletedHandler([this, submission](MTL::CommandBuffer*) {
+      uint64_t completed = submission_completed_.load(std::memory_order_relaxed);
+      while (completed < submission &&
+             !submission_completed_.compare_exchange_weak(completed, submission,
+                                                          std::memory_order_release)) {
+      }
+    });
+    command_buffer_->commit();
+    command_buffer_.reset();
+  }
+  submission_open_ = false;
+  ++g_rl_stats.passes;
+}
+
+void MetalCommandProcessor::AwaitSubmission(uint64_t submission) {
+  if (GetCompletedSubmission() >= submission) {
+    return;
+  }
+  if (metal4_) {
+    while (!submission_event_->waitUntilSignaledValue(submission, 1000)) {
+    }
+    return;
+  }
+  // An empty command buffer completes after everything committed before it.
+  MTL::CommandBuffer* fence = queue()->commandBuffer();
+  fence->commit();
+  fence->waitUntilCompleted();
+  uint64_t completed = submission_completed_.load(std::memory_order_relaxed);
+  const uint64_t committed = submission_current_ - 1;
+  while (completed < committed &&
+         !submission_completed_.compare_exchange_weak(completed, committed,
+                                                      std::memory_order_release)) {
+  }
+}
+
+void MetalCommandProcessor::AwaitAllSubmissions() {
+  AwaitSubmission(submission_current_ - 1);
+  CompletedSubmissionUpdated();
+}
+
+// Resource lifetimes.
+
+void MetalCommandProcessor::MakeResident(MTL::Allocation* allocation) {
+  if (!metal4_ || !allocation) {
+    return;
+  }
+  residency_set_->addAllocation(allocation);
+  residency_set_dirty_ = true;
+}
+
+void MetalCommandProcessor::ReleaseResident(MTL::Allocation* allocation) {
+  if (!metal4_ || !allocation) {
+    return;
+  }
+  allocation->retain();
+  deferred_releases_.push_back({submission_current_, allocation, true});
+}
+
+void MetalCommandProcessor::ReleaseAfterUse(NS::Object* object) {
+  if (!metal4_ || !object) {
+    return;
+  }
+  object->retain();
+  deferred_releases_.push_back({submission_current_, object, false});
+}
+
+void MetalCommandProcessor::BeginFrameIfNeeded() {
+  BeginSubmissionIfNeeded();
+  if (frame_open_) {
+    return;
+  }
+  frame_open_ = true;
+  // At most 2 frames in flight: guest memory is used in place, so the GPU mustn't fall further behind
+  // the guest's CPU, which reuses buffers once the command processor has passed them.
+  while (frame_submissions_.size() >= 2) {
+    AwaitSubmission(frame_submissions_.front().second);
+    CompletedSubmissionUpdated();
+  }
+  texture_cache_->BeginFrame();
+  render_target_cache_->BeginFrame();
+}
+
+void MetalCommandProcessor::EndFrame() {
+  if (!frame_open_) {
+    return;
+  }
+  primitive_processor_->EndFrame();
+  frame_submissions_.emplace_back(frame_current_, submission_current_);
+  ++frame_current_;
+  frame_open_ = false;
+  EndSubmission();
+}
+
+// Encoders.
+
+void MetalCommandProcessor::EndEncoding() {
+  if (render_encoder_.is_open()) {
+    render_encoder_.End();
+    // What this pass really needed is the next one's starting height.
+    render_pass_heights_[render_encoder_heights_key_] = render_encoder_required_height_;
+    render_encoder_targets_ = MetalRenderPassTargets();
+  }
+  blit_encoder_.End();
+  if (compute_encoder_.is_open()) {
+    compute_encoder_.End();
+  }
+}
+
+MetalRenderEncoder* MetalCommandProcessor::BeginRenderPass(
+    const MetalRenderPassTargets& full_targets, uint32_t required_height, const char* label) {
+  // Rows in 32-row steps, not to restart passes for small growth.
+  required_height = std::min(full_targets.height,
+                             std::max(rex::round_up(std::min(required_height, full_targets.height),
+                                                    uint32_t(32)),
+                                      uint32_t(32)));
+  if (render_encoder_.is_open()) {
+    MetalRenderPassTargets current = render_encoder_targets_;
+    current.height = full_targets.height;
+    if (current == full_targets) {
+      render_encoder_required_height_ = std::max(render_encoder_required_height_, required_height);
+      if (render_encoder_targets_.height >= required_height) {
+        return &render_encoder_;
+      }
+    }
+  }
+  EndEncoding();
+  uint64_t heights_key = uint64_t(reinterpret_cast<uintptr_t>(full_targets.color[0])) * 31 ^
+                         uint64_t(reinterpret_cast<uintptr_t>(full_targets.depth_stencil)) * 17 ^
+                         uint64_t(reinterpret_cast<uintptr_t>(full_targets.color[1])) ^
+                         (uint64_t(full_targets.width) << 48);
+  auto remembered = render_pass_heights_.find(heights_key);
+  MetalRenderPassTargets targets = full_targets;
+  targets.height = std::max(required_height,
+                            remembered != render_pass_heights_.end() ? remembered->second : 0u);
+  targets.height = std::min(targets.height, full_targets.height);
+  render_encoder_heights_key_ = heights_key;
+  render_encoder_required_height_ = required_height;
+  // The same attachment descriptors for both (MTL4RenderPassDescriptor isn't an MTLRenderPassDescriptor).
+  MTL4::RenderPassDescriptor* descriptor4 = nullptr;
+  MTL::RenderPassDescriptor* descriptor3 = nullptr;
+  if (metal4_) {
+    descriptor4 = MTL4::RenderPassDescriptor::alloc()->init();
+  } else {
+    descriptor3 = MTL::RenderPassDescriptor::renderPassDescriptor();
+  }
+  MTL::RenderPassColorAttachmentDescriptorArray* color_attachments =
+      descriptor4 ? descriptor4->colorAttachments() : descriptor3->colorAttachments();
+  NS::UInteger sample_count = 1;
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    if (!targets.color[i]) {
+      continue;
+    }
+    MTL::RenderPassColorAttachmentDescriptor* attachment = color_attachments->object(i);
+    attachment->setTexture(targets.color[i]);
+    attachment->setLoadAction(MTL::LoadActionLoad);
+    attachment->setStoreAction(MTL::StoreActionStore);
+    sample_count = targets.color[i]->sampleCount();
+  }
+  if (targets.depth_stencil) {
+    MTL::RenderPassDepthAttachmentDescriptor* depth =
+        descriptor4 ? descriptor4->depthAttachment() : descriptor3->depthAttachment();
+    depth->setTexture(targets.depth_stencil);
+    depth->setLoadAction(MTL::LoadActionLoad);
+    depth->setStoreAction(MTL::StoreActionStore);
+    MTL::RenderPassStencilAttachmentDescriptor* stencil =
+        descriptor4 ? descriptor4->stencilAttachment() : descriptor3->stencilAttachment();
+    stencil->setTexture(targets.depth_stencil);
+    stencil->setLoadAction(MTL::LoadActionLoad);
+    stencil->setStoreAction(MTL::StoreActionStore);
+    sample_count = targets.depth_stencil->sampleCount();
+  }
+  const bool no_attachments = !targets.depth_stencil && !targets.color[0] && !targets.color[1] &&
+                              !targets.color[2] && !targets.color[3];
+  BeginSubmissionIfNeeded();
+  if (descriptor4) {
+    descriptor4->setRenderTargetWidth(targets.width);
+    descriptor4->setRenderTargetHeight(targets.height);
+    if (no_attachments) {
+      descriptor4->setDefaultRasterSampleCount(sample_count);
+    }
+    render_encoder_.Begin(command_buffer4_->renderCommandEncoder(descriptor4),
+                          argument_tables4_[0].get(), argument_tables4_[1].get());
+    descriptor4->release();
+  } else {
+    descriptor3->setRenderTargetWidth(targets.width);
+    descriptor3->setRenderTargetHeight(targets.height);
+    if (no_attachments) {
+      descriptor3->setDefaultRasterSampleCount(sample_count);
+    }
+    render_encoder_.Begin(command_buffer_->renderCommandEncoder(descriptor3));
+  }
+  if (encoder_labels_) {
+    render_encoder_.setLabel(label);
+  }
+  render_encoder_targets_ = targets;
+  render_state_ = RenderState();
+  ++g_rl_stats.barriers;
+  return &render_encoder_;
+}
+
+MetalComputeEncoder* MetalCommandProcessor::BeginCompute(const char* label) {
+  if (compute_encoder_.is_open() && !blit_encoder_.is_open() &&
+      (!encoder_labels_ || compute_encoder_label_ == label)) {
+    return &compute_encoder_;
+  }
+  EndEncoding();
+  BeginSubmissionIfNeeded();
+  if (metal4_) {
+    compute_encoder_.Begin(command_buffer4_->computeCommandEncoder(), argument_tables4_[2].get());
+  } else {
+    compute_encoder_.Begin(command_buffer_->computeCommandEncoder());
+  }
+  compute_encoder_label_ = label;
+  if (encoder_labels_) {
+    compute_encoder_.setLabel(label);
+  }
+  return &compute_encoder_;
+}
+
+MetalBlitEncoder* MetalCommandProcessor::BeginBlit() {
+  if (metal4_) {
+    // In the compute encoder (continuing one that, for instance, just loaded a texture).
+    blit_encoder_.Begin(BeginCompute(compute_encoder_.is_open() ? compute_encoder_label_ : "blit"));
+    return &blit_encoder_;
+  }
+  if (blit_encoder_.is_open()) {
+    return &blit_encoder_;
+  }
+  EndEncoding();
+  BeginSubmissionIfNeeded();
+  blit_encoder_.Begin(command_buffer_->blitCommandEncoder());
+  return &blit_encoder_;
+}
