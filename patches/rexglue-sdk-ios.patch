+
+std::unique_ptr<MetalTextureCache> MetalTextureCache::Create(const RegisterFile& register_file,
+                                                             MetalSharedMemory& shared_memory,
+                                                             MetalCommandProcessor& command_processor) {
+  std::unique_ptr<MetalTextureCache> texture_cache(
+      new MetalTextureCache(register_file, shared_memory, command_processor));
+  if (!texture_cache->Initialize()) {
+    return nullptr;
+  }
+  return texture_cache;
+}
+
+MetalTextureCache::MetalTextureCache(const RegisterFile& register_file,
+                                     MetalSharedMemory& shared_memory,
+                                     MetalCommandProcessor& command_processor)
+    : TextureCache(register_file, shared_memory, 1, 1), command_processor_(command_processor) {}
+
+MetalTextureCache::~MetalTextureCache() {
+  samplers_.clear();
+  DestroyAllTextures(true);
+}
+
+bool MetalTextureCache::Initialize() {
+  MTL::Device* device = command_processor_.device();
+
+  for (size_t i = 0; i < rex::countof(host_formats_); ++i) {
+    host_formats_[i] = kBestHostFormats[i];
+  }
+
+  // Block compression: Apple silicon Macs and recent iPads / iPhones sample BC directly; elsewhere it's
+  // decompressed while loading.
+  if (!device->supportsBCTextureCompression()) {
+    REXGPU_INFO("MetalTextureCache: no BC texture compression, decompressing DXT / DXN on load");
+    auto decompress = [&](xenos::TextureFormat format, LoadShaderIndex load_shader,
+                          MTL::PixelFormat pixel_format) {
+      HostFormatPair& host_format = host_formats_[uint32_t(format)];
+      host_format.format_unsigned.load_shader = load_shader;
+      host_format.format_unsigned.format = pixel_format;
+      host_format.format_unsigned.block_compressed = false;
+      host_format.unsigned_signed_compatible = false;
+    };
+    decompress(xenos::TextureFormat::k_DXT1, kLoadShaderIndexDXT1ToRGBA8,
+               MTL::PixelFormatRGBA8Unorm);
+    decompress(xenos::TextureFormat::k_DXT1_AS_16_16_16_16, kLoadShaderIndexDXT1ToRGBA8,
+               MTL::PixelFormatRGBA8Unorm);
+    decompress(xenos::TextureFormat::k_DXT2_3, kLoadShaderIndexDXT3ToRGBA8,
+               MTL::PixelFormatRGBA8Unorm);
+    decompress(xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16, kLoadShaderIndexDXT3ToRGBA8,
+               MTL::PixelFormatRGBA8Unorm);
+    decompress(xenos::TextureFormat::k_DXT4_5, kLoadShaderIndexDXT5ToRGBA8,
+               MTL::PixelFormatRGBA8Unorm);
+    decompress(xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16, kLoadShaderIndexDXT5ToRGBA8,
+               MTL::PixelFormatRGBA8Unorm);
+    decompress(xenos::TextureFormat::k_DXN, kLoadShaderIndexDXNToRG8, MTL::PixelFormatRG8Unorm);
+    decompress(xenos::TextureFormat::k_DXT5A, kLoadShaderIndexDXT5AToR8, MTL::PixelFormatR8Unorm);
+  }
+  // Signed versions D3D12 doesn't have either.
+  constexpr xenos::TextureFormat kSignedUnsupportedFormats[] = {
+      xenos::TextureFormat::k_1_5_5_5,
+      xenos::TextureFormat::k_5_6_5,
+      xenos::TextureFormat::k_6_5_5,
+      xenos::TextureFormat::k_2_10_10_10,
+      xenos::TextureFormat::k_Cr_Y1_Cb_Y0_REP,
+      xenos::TextureFormat::k_Y1_Cr_Y0_Cb_REP,
+      xenos::TextureFormat::k_4_4_4_4,
+      xenos::TextureFormat::k_DXT1,
+      xenos::TextureFormat::k_DXT2_3,
+      xenos::TextureFormat::k_DXT4_5,
+      xenos::TextureFormat::k_DXN,
+      xenos::TextureFormat::k_DXT5A,
+      xenos::TextureFormat::k_CTX1,
+      xenos::TextureFormat::k_DXT1_AS_16_16_16_16,
+      xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16,
+      xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16,
+      xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16,
+      xenos::TextureFormat::k_DXT3A,
+      xenos::TextureFormat::k_DXT3A_AS_1_1_1_1,
+  };
+  for (xenos::TextureFormat format : kSignedUnsupportedFormats) {
+    HostFormatPair& host_format = host_formats_[uint32_t(format)];
+    host_format.format_signed.load_shader = kLoadShaderIndexUnknown;
+    host_format.format_signed.format = MTL::PixelFormatInvalid;
+    host_format.unsigned_signed_compatible = false;
+  }
+
+  // Filterability: everything sampled here is, except 32-bit float where the device can't.
+  const bool float32_filterable = device->supports32BitFloatFiltering();
+  auto is_filterable = [&](MTL::PixelFormat format) {
+    switch (format) {
+      case MTL::PixelFormatR32Float:
+      case MTL::PixelFormatRG32Float:
+      case MTL::PixelFormatRGBA32Float:
+        return float32_filterable;
+      default:
+        return format != MTL::PixelFormatInvalid;
+    }
+  };
+  for (size_t i = 0; i < rex::countof(host_formats_); ++i) {
+    HostFormatPair& host_format = host_formats_[i];
+    if (host_format.format_unsigned.format == MTL::PixelFormatInvalid) {
+      host_format.format_unsigned.load_shader = kLoadShaderIndexUnknown;
+    }
+    if (host_format.format_unsigned.load_shader == kLoadShaderIndexUnknown) {
+      host_format.format_unsigned.format = MTL::PixelFormatInvalid;
+    }
+    if (host_format.format_signed.format == MTL::PixelFormatInvalid) {
+      host_format.format_signed.load_shader = kLoadShaderIndexUnknown;
+    }
+    if (host_format.format_signed.load_shader == kLoadShaderIndexUnknown) {
+      host_format.format_signed.format = MTL::PixelFormatInvalid;
+    }
+    host_format.format_unsigned.linear_filterable = is_filterable(host_format.format_unsigned.format);
+    host_format.format_signed.linear_filterable = is_filterable(host_format.format_signed.format);
+    if (host_format.format_unsigned.format != MTL::PixelFormatInvalid &&
+        host_format.format_signed.format != MTL::PixelFormatInvalid) {
+      if (host_format.format_unsigned.load_shader == host_format.format_signed.load_shader) {
+        if (host_format.format_unsigned.format == host_format.format_signed.format) {
+          host_format.unsigned_signed_compatible = true;
+        }
+      } else {
+        host_format.unsigned_signed_compatible = false;
+      }
+    } else {
+      host_format.unsigned_signed_compatible = false;
+    }
+  }
+
+  // Load pipelines (all, they're small; the build's SPIR-V converted to MSL).
+  const std::pair<const uint32_t*, size_t> load_shader_code[kLoadShaderCount] = {
+#define REX_LOAD_SHADER(name) {shaders::name, sizeof(shaders::name)}
+      REX_LOAD_SHADER(texture_load_8bpb_cs),
+      REX_LOAD_SHADER(texture_load_16bpb_cs),
+      REX_LOAD_SHADER(texture_load_32bpb_cs),
+      REX_LOAD_SHADER(texture_load_64bpb_cs),
+      REX_LOAD_SHADER(texture_load_128bpb_cs),
+      REX_LOAD_SHADER(texture_load_r5g5b5a1_b5g5r5a1_cs),
+      REX_LOAD_SHADER(texture_load_r5g6b5_b5g6r5_cs),
+      REX_LOAD_SHADER(texture_load_r5g6b5_rgba8_cs),
+      REX_LOAD_SHADER(texture_load_r5g5b6_b5g6r5_swizzle_rbga_cs),
+      // kRGBA4ToBGRA4: not used.
+      {nullptr, 0},
+      REX_LOAD_SHADER(texture_load_r4g4b4a4_a4r4g4b4_cs),
+      REX_LOAD_SHADER(texture_load_r4g4b4a4_rgba8_cs),
+      // kGBGR8ToGRGB8: not used.
+      {nullptr, 0},
+      REX_LOAD_SHADER(texture_load_gbgr8_rgb8_cs),
+      // kBGRG8ToRGBG8: not used.
+      {nullptr, 0},
+      REX_LOAD_SHADER(texture_load_bgrg8_rgb8_cs),
+      REX_LOAD_SHADER(texture_load_r10g11b11_rgba16_cs),
+      REX_LOAD_SHADER(texture_load_r10g11b11_rgba16_snorm_cs),
+      REX_LOAD_SHADER(texture_load_r11g11b10_rgba16_cs),
+      REX_LOAD_SHADER(texture_load_r11g11b10_rgba16_snorm_cs),
+      REX_LOAD_SHADER(texture_load_r16_unorm_float_cs),
+      REX_LOAD_SHADER(texture_load_r16_snorm_float_cs),
+      REX_LOAD_SHADER(texture_load_rg16_unorm_float_cs),
+      REX_LOAD_SHADER(texture_load_rg16_snorm_float_cs),
+      REX_LOAD_SHADER(texture_load_rgba16_unorm_float_cs),
+      REX_LOAD_SHADER(texture_load_rgba16_snorm_float_cs),
+      REX_LOAD_SHADER(texture_load_dxt1_rgba8_cs),
+      REX_LOAD_SHADER(texture_load_dxt3_rgba8_cs),
+      REX_LOAD_SHADER(texture_load_dxt5_rgba8_cs),
+      REX_LOAD_SHADER(texture_load_dxn_rg8_cs),
+      REX_LOAD_SHADER(texture_load_dxt3a_cs),
+      // kDXT3AAs1111ToBGRA4: not used.
+      {nullptr, 0},
+      REX_LOAD_SHADER(texture_load_dxt3aas1111_argb4_cs),
+      REX_LOAD_SHADER(texture_load_dxt5a_r8_cs),
+      REX_LOAD_SHADER(texture_load_ctx1_cs),
+      REX_LOAD_SHADER(texture_load_depth_unorm_cs),
+      REX_LOAD_SHADER(texture_load_depth_float_cs),
+#undef REX_LOAD_SHADER
+  };
+  for (size_t i = 0; i < kLoadShaderCount; ++i) {
+    if (!load_shader_code[i].first) {
+      continue;
+    }
+    MslOptions options;
+    options.auto_slots = true;
+    std::string error;
+    uint32_t local_size[3];
+    std::string name = "rex_texture_load_" + std::to_string(i);
+    std::string msl = SpirvToMsl(load_shader_code[i].first,
+                                 load_shader_code[i].second / sizeof(uint32_t), MslStage::kCompute,
+                                 {}, options, name, &error, local_size);
+    ui::metal::Ref<MTL::Function> function;
+    if (!msl.empty()) {
+      function = ui::metal::Ref<MTL::Function>(CompileMsl(device, msl, name, &error));
+    }
+    if (function) {
+      NS::Error* ns_error = nullptr;
+      load_pipelines_[i].state = ui::metal::Ref<MTL::ComputePipelineState>(
+          device->newComputePipelineState(function.get(), &ns_error));
+      if (!load_pipelines_[i].state && ns_error) {
+        error = ns_error->localizedDescription()->utf8String();
+      }
+      load_pipelines_[i].threads_per_group = MTL::Size(local_size[0], local_size[1], local_size[2]);
+    }
+    if (!load_pipelines_[i].state) {
+      REXGPU_ERROR("MetalTextureCache: texture load shader {}: {}", i, error);
+      return false;
+    }
+  }
+
+  // Null textures, (0, 0, 0, 0).
+  {
+    static const uint8_t kZero[4 * 6] = {};
+    auto make_null = [&](MTL::TextureType type) {
+      MTL::TextureDescriptor* descriptor = MTL::TextureDescriptor::alloc()->init();
+      descriptor->setTextureType(type);
+      descriptor->setPixelFormat(MTL::PixelFormatRGBA8Unorm);
+      descriptor->setWidth(1);
+      descriptor->setHeight(1);
+      descriptor->setDepth(1);
+      descriptor->setArrayLength(1);
+      descriptor->setStorageMode(MTL::StorageModeShared);
+      descriptor->setUsage(MTL::TextureUsageShaderRead);
+      ui::metal::Ref<MTL::Texture> texture(device->newTexture(descriptor));
+      descriptor->release();
+      if (texture) {
+        const uint32_t slices = type == MTL::TextureTypeCube ? 6 : 1;
+        for (uint32_t slice = 0; slice < slices; ++slice) {
+          texture->replaceRegion(MTL::Region(0, 0, 0, 1, 1, 1), 0, slice, kZero, 4, 4);
+        }
+      }
+      return texture;
+    };
+    null_texture_2d_array_ = make_null(MTL::TextureType2DArray);
+    null_texture_cube_ = make_null(MTL::TextureTypeCube);
+    null_texture_3d_ = make_null(MTL::TextureType3D);
+    if (!null_texture_2d_array_ || !null_texture_cube_ || !null_texture_3d_) {
+      REXGPU_ERROR("MetalTextureCache: failed to create the null textures");
+      return false;
+    }
+    command_processor_.MakeResident(null_texture_2d_array_.get());
+    command_processor_.MakeResident(null_texture_cube_.get());
+    command_processor_.MakeResident(null_texture_3d_.get());
+  }
+
+  max_anisotropy_ = xenos::AnisoFilter::kMax_16_1;
+  return true;
+}
+
+void MetalTextureCache::BeginFrame() {
+  TextureCache::BeginFrame();
+  bool unsupported_header_written = false;
+  for (uint32_t i = 0; i < 64; ++i) {
+    uint32_t unsupported_features = unsupported_format_features_used_[i];
+    if (!unsupported_features) {
+      continue;
+    }
+    if (!unsupported_header_written) {
+      REXGPU_ERROR("Unsupported texture formats used in the frame:");
+      unsupported_header_written = true;
+    }
+    REXGPU_ERROR("* {}{}{}{}", FormatInfo::Get(xenos::TextureFormat(i))->name,
+                 unsupported_features & kUnsupportedResourceBit ? " resource" : "",
+                 unsupported_features & kUnsupportedUnormBit ? " unsigned" : "",
+                 unsupported_features & kUnsupportedSnormBit ? " signed" : "");
+    unsupported_format_features_used_[i] = 0;
+  }
+}
+
+MTL::Texture* MetalTextureCache::GetActiveBindingOrNullTexture(uint32_t fetch_constant_index,
+                                                               xenos::FetchOpDimension dimension,
+                                                               bool is_signed) {
+  MTL::Texture* texture = nullptr;
+  const TextureBinding* binding = GetValidTextureBinding(fetch_constant_index);
+  if (binding && AreDimensionsCompatible(dimension, binding->key.dimension)) {
+    bool force_special_view =
+        binding->key.dimension == xenos::DataDimension::k3D &&
+        (dimension == xenos::FetchOpDimension::k1D || dimension == xenos::FetchOpDimension::k2D);
+    if (force_special_view) {
+      Texture* base_texture = nullptr;
+      bool use_signed = is_signed && texture_util::IsAnySignSigned(binding->swizzled_signs);
+      if (use_signed && IsSignedVersionSeparateForFormat(binding->key)) {
+        base_texture = binding->texture_signed;
+      } else {
+        base_texture = binding->texture;
+      }
+      if (base_texture) {
+        texture = static_cast<MetalTexture*>(base_texture)
+                      ->GetOrCreate3DAs2DView(use_signed, binding->host_swizzle);
+      }
+    } else {
+      const MetalTextureBinding& metal_binding = metal_texture_bindings_[fetch_constant_index];
+      texture = is_signed ? metal_binding.texture_signed : metal_binding.texture_unsigned;
+    }
+  }
+  if (texture) {
+    return texture;
+  }
+  switch (dimension) {
+    case xenos::FetchOpDimension::k3DOrStacked:
+      return null_texture_3d_.get();
+    case xenos::FetchOpDimension::kCube:
+      return null_texture_cube_.get();
+    default:
+      return null_texture_2d_array_.get();
+  }
+}
+
+MetalTextureCache::SamplerParameters MetalTextureCache::GetSamplerParameters(
+    const SpirvShader::SamplerBinding& binding) const {
+  const auto& regs = register_file();
+  xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+
+  SamplerParameters parameters;
+
+  xenos::ClampMode fetch_clamp_x, fetch_clamp_y, fetch_clamp_z;
+  texture_util::GetClampModesForDimension(fetch, fetch_clamp_x, fetch_clamp_y, fetch_clamp_z);
+  parameters.clamp_x = NormalizeClampMode(fetch_clamp_x);
+  parameters.clamp_y = NormalizeClampMode(fetch_clamp_y);
+  parameters.clamp_z = NormalizeClampMode(fetch_clamp_z);
+  if (xenos::ClampModeUsesBorder(parameters.clamp_x) ||
+      xenos::ClampModeUsesBorder(parameters.clamp_y) ||
+      xenos::ClampModeUsesBorder(parameters.clamp_z)) {
+    parameters.border_color = fetch.border_color;
+  } else {
+    parameters.border_color = xenos::BorderColor::k_ABGR_Black;
+  }
+
+  xenos::TextureFilter mag_filter = binding.mag_filter == xenos::TextureFilter::kUseFetchConst
+                                        ? fetch.mag_filter
+                                        : binding.mag_filter;
+  parameters.mag_linear = mag_filter == xenos::TextureFilter::kLinear;
+  xenos::TextureFilter min_filter = binding.min_filter == xenos::TextureFilter::kUseFetchConst
+                                        ? fetch.min_filter
+                                        : binding.min_filter;
+  parameters.min_linear = min_filter == xenos::TextureFilter::kLinear;
+  xenos::TextureFilter mip_filter = binding.mip_filter == xenos::TextureFilter::kUseFetchConst
+                                        ? fetch.mip_filter
+                                        : binding.mip_filter;
+  parameters.mip_linear = mip_filter == xenos::TextureFilter::kLinear;
+  xenos::AnisoFilter aniso_filter = binding.aniso_filter == xenos::AnisoFilter::kUseFetchConst
+                                        ? fetch.aniso_filter
+                                        : binding.aniso_filter;
+  aniso_filter = std::min(aniso_filter, max_anisotropy_);
+  if (parameters.mag_linear || parameters.min_linear || parameters.mip_linear ||
+      aniso_filter != xenos::AnisoFilter::kDisabled) {
+    // Check if the texture is actually filterable on the host.
+    bool linear_filterable = true;
+    TextureKey texture_key;
+    uint8_t texture_swizzled_signs;
+    BindingInfoFromFetchConstant(fetch, texture_key, &texture_swizzled_signs);
+    if (texture_key.is_valid) {
+      const HostFormatPair& host_format_pair = GetHostFormatPair(texture_key);
+      if ((texture_util::IsAnySignNotSigned(texture_swizzled_signs) &&
+           !host_format_pair.format_unsigned.linear_filterable) ||
+          (texture_util::IsAnySignSigned(texture_swizzled_signs) &&
+           !host_format_pair.format_signed.linear_filterable)) {
+        linear_filterable = false;
+      }
+    } else {
+      linear_filterable = false;
+    }
+    if (!linear_filterable) {
+      parameters.mag_linear = 0;
+      parameters.min_linear = 0;
+      parameters.mip_linear = 0;
+      aniso_filter = xenos::AnisoFilter::kDisabled;
+    }
+  }
+  bool min_mag_linear = parameters.mag_linear && parameters.min_linear;
+  bool mip_filter_bilinear_or_trilinear =
+      mip_filter == xenos::TextureFilter::kPoint || mip_filter == xenos::TextureFilter::kLinear;
+  parameters.mip_base_map = mip_filter == xenos::TextureFilter::kBaseMap;
+  uint32_t mip_min_level, mip_max_level;
+  texture_util::GetSubresourcesFromFetchConstant(fetch, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                                 &mip_min_level, &mip_max_level);
+  parameters.mip_min_level = mip_min_level;
+  bool has_mips = mip_max_level > mip_min_level;
+  int32_t anisotropic_override = REXCVAR_GET(anisotropic_override);
+  if (anisotropic_override > -1 && anisotropic_override < 6 && has_mips &&
+      !parameters.mip_base_map && min_mag_linear && mip_filter_bilinear_or_trilinear) {
+    aniso_filter = xenos::AnisoFilter(anisotropic_override);
+  }
+  aniso_filter = std::min(aniso_filter, max_anisotropy_);
+  if (aniso_filter != xenos::AnisoFilter::kDisabled) {
+    // As on D3D12: anisotropic filtering forces linear min / mag / mip.
+    parameters.mag_linear = 1;
+    parameters.min_linear = 1;
+    parameters.mip_linear = 1;
+  }
+  parameters.aniso_filter = aniso_filter;
+  return parameters;
+}
+
+MTL::SamplerState* MetalTextureCache::GetSampler(SamplerParameters parameters) {
+  auto it = samplers_.find(parameters.value);
+  if (it != samplers_.end()) {
+    return it->second.get();
+  }
+  MTL::SamplerDescriptor* descriptor = MTL::SamplerDescriptor::alloc()->init();
+  // For a resource ID (Metal 4 argument tables).
+  descriptor->setSupportArgumentBuffers(command_processor_.metal4());
+  descriptor->setMagFilter(parameters.mag_linear ? MTL::SamplerMinMagFilterLinear
+                                                 : MTL::SamplerMinMagFilterNearest);
+  descriptor->setMinFilter(parameters.min_linear ? MTL::SamplerMinMagFilterLinear
+                                                 : MTL::SamplerMinMagFilterNearest);
+  descriptor->setMipFilter(parameters.mip_linear ? MTL::SamplerMipFilterLinear
+                                                 : MTL::SamplerMipFilterNearest);
+  static const MTL::SamplerAddressMode kAddressModeMap[] = {
+      // kRepeat
+      MTL::SamplerAddressModeRepeat,
+      // kMirroredRepeat
+      MTL::SamplerAddressModeMirrorRepeat,
+      // kClampToEdge
+      MTL::SamplerAddressModeClampToEdge,
+      // kMirrorClampToEdge
+      MTL::SamplerAddressModeMirrorClampToEdge,
+      // kClampToHalfway
+      MTL::SamplerAddressModeClampToEdge,
+      // kMirrorClampToHalfway
+      MTL::SamplerAddressModeMirrorClampToEdge,
+      // kClampToBorder
+      MTL::SamplerAddressModeClampToBorderColor,
+      // kMirrorClampToBorder
+      MTL::SamplerAddressModeMirrorClampToEdge,
+  };
+  descriptor->setSAddressMode(kAddressModeMap[uint32_t(parameters.clamp_x)]);
+  descriptor->setTAddressMode(kAddressModeMap[uint32_t(parameters.clamp_y)]);
+  descriptor->setRAddressMode(kAddressModeMap[uint32_t(parameters.clamp_z)]);
+  // LOD biasing is done in shaders.
+  if (parameters.aniso_filter != xenos::AnisoFilter::kDisabled) {
+    descriptor->setMaxAnisotropy(NS::UInteger(1) << (uint32_t(parameters.aniso_filter) -
+                                                     uint32_t(xenos::AnisoFilter::kMax_1_1)));
+  }
+  descriptor->setLodMinClamp(float(parameters.mip_min_level));
+  descriptor->setLodMaxClamp(parameters.mip_base_map ? float(parameters.mip_min_level) + 0.25f
+                                                     : FLT_MAX);
+  // Metal has no custom border colors: the YCbCr blacks are transparent black, as on Vulkan without them.
+  descriptor->setBorderColor(parameters.border_color == xenos::BorderColor::k_ABGR_White
+                                 ? MTL::SamplerBorderColorOpaqueWhite
+                                 : MTL::SamplerBorderColorTransparentBlack);
+  ui::metal::Ref<MTL::SamplerState> sampler(
+      command_processor_.device()->newSamplerState(descriptor));
+  descriptor->release();
+  if (!sampler) {
+    REXGPU_ERROR("MetalTextureCache: failed to create a sampler for parameters 0x{:08X}",
+                 parameters.value);
+  }
+  MTL::SamplerState* result = sampler.get();
+  samplers_.emplace(parameters.value, std::move(sampler));
+  return result;
+}
+
+MTL::Texture* MetalTextureCache::RequestSwapTexture(uint32_t& width_out, uint32_t& height_out,
+                                                    xenos::TextureFormat& format_out) {
+  const auto& regs = register_file();
+  xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(0);
+  TextureKey key;
+  BindingInfoFromFetchConstant(fetch, key, nullptr);
+  if (!key.is_valid || key.base_page == 0 || key.dimension != xenos::DataDimension::k2DOrStacked) {
+    return nullptr;
+  }
+  MetalTexture* texture = static_cast<MetalTexture*>(FindOrCreateTexture(key));
+  if (!texture) {
+    return nullptr;
+  }
+  uint32_t host_swizzle = GuestToHostSwizzle(fetch.swizzle, GetHostFormatSwizzle(key));
+  MTL::Texture* view = texture->GetView(false, host_swizzle, false);
+  if (!view || !LoadTextureData(*texture)) {
+    return nullptr;
+  }
+  texture->MarkAsUsed();
+  key = texture->key();
+  width_out = key.GetWidth();
+  height_out = key.GetHeight();
+  format_out = key.format;
+  return view;
+}
+
+bool MetalTextureCache::IsSignedVersionSeparateForFormat(TextureKey key) const {
+  const HostFormatPair& host_format_pair = GetHostFormatPair(key);
+  if (host_format_pair.format_unsigned.format == MTL::PixelFormatInvalid ||
+      host_format_pair.format_signed.format == MTL::PixelFormatInvalid) {
+    return false;
+  }
+  return !host_format_pair.unsigned_signed_compatible;
+}
+
+uint32_t MetalTextureCache::GetHostFormatSwizzle(TextureKey key) const {
+  return GetHostFormatPair(key).swizzle;
+}
+
+uint32_t MetalTextureCache::GetMaxHostTextureWidthHeight(xenos::DataDimension dimension) const {
+  switch (dimension) {
+    case xenos::DataDimension::k1D:
+    case xenos::DataDimension::k2DOrStacked:
+    case xenos::DataDimension::kCube:
+      return 16384;
+    case xenos::DataDimension::k3D:
+      return 2048;
+    default:
+      assert_unhandled_case(dimension);
+      return 0;
+  }
+}
+
+uint32_t MetalTextureCache::GetMaxHostTextureDepthOrArraySize(
+    xenos::DataDimension dimension) const {
+  switch (dimension) {
+    case xenos::DataDimension::k1D:
+    case xenos::DataDimension::k2DOrStacked:
+      return 2048;
+    case xenos::DataDimension::k3D:
+      return 2048;
+    case xenos::DataDimension::kCube:
+      return 6;
+    default:
+      assert_unhandled_case(dimension);
+      return 0;
+  }
+}
+
+std::unique_ptr<TextureCache::Texture> MetalTextureCache::CreateTexture(TextureKey key) {
+  MTL::PixelFormat formats[] = {MTL::PixelFormatInvalid, MTL::PixelFormatInvalid};
+  const HostFormatPair& host_format = GetHostFormatPair(key);
+  if (host_format.format_signed.format == MTL::PixelFormatInvalid) {
+    formats[0] = host_format.format_unsigned.format;
+  } else if (host_format.format_unsigned.format == MTL::PixelFormatInvalid) {
+    formats[0] = host_format.format_signed.format;
+  } else if (IsSignedVersionSeparateForFormat(key)) {
+    formats[0] =
+        key.signed_separate ? host_format.format_signed.format : host_format.format_unsigned.format;
+  } else {
+    formats[0] = host_format.format_unsigned.format;
+    if (host_format.format_signed.format != host_format.format_unsigned.format) {
+      formats[1] = host_format.format_signed.format;
+    }
+  }
+  if (formats[0] == MTL::PixelFormatInvalid) {
+    unsupported_format_features_used_[uint32_t(key.format)] |= kUnsupportedResourceBit;
+    return nullptr;
+  }
+
+  const uint32_t depth_or_array_size = key.GetDepthOrArraySize();
+  MTL::TextureDescriptor* descriptor = MTL::TextureDescriptor::alloc()->init();
+  switch (key.dimension) {
+    case xenos::DataDimension::k3D:
+      descriptor->setTextureType(MTL::TextureType3D);
+      descriptor->setDepth(depth_or_array_size);
+      break;
+    case xenos::DataDimension::kCube:
+      descriptor->setTextureType(MTL::TextureTypeCube);
+      break;
+    default:
+      descriptor->setTextureType(MTL::TextureType2DArray);
+      descriptor->setArrayLength(depth_or_array_size);
+      break;
+  }
+  descriptor->setPixelFormat(formats[0]);
+  descriptor->setWidth(key.GetWidth());
+  descriptor->setHeight(key.GetHeight());
+  descriptor->setMipmapLevelCount(key.mip_max_level + 1);
+  descriptor->setStorageMode(MTL::StorageModePrivate);
+  MTL::TextureUsage usage = MTL::TextureUsageShaderRead;
+  // Unsigned and signed views of one texture (keeps lossless compression otherwise).
+  if (formats[1] != MTL::PixelFormatInvalid) {
+    usage |= MTL::TextureUsagePixelFormatView;
+  }
+  descriptor->setUsage(usage);
+  ui::metal::Ref<MTL::Texture> texture(command_processor_.device()->newTexture(descriptor));
+  descriptor->release();
+  if (!texture) {
+    return nullptr;
+  }
+  return std::unique_ptr<Texture>(new MetalTexture(*this, key, std::move(texture)));
+}
+
+bool MetalTextureCache::LoadTextureDataFromResidentMemoryImpl(Texture& texture, bool load_base,
+                                                              bool load_mips) {
+  MetalTexture& metal_texture = static_cast<MetalTexture&>(texture);
+  TextureKey texture_key = metal_texture.key();
+  ++vulkan::g_rl_stats.tex_loads;
+  vulkan::g_rl_stats.tex_load_bytes +=
+      uint64_t(texture_key.GetWidth()) * texture_key.GetHeight() * 4;
+
+  const HostFormatPair& host_format_pair = GetHostFormatPair(texture_key);
+  bool host_format_is_signed;
+  if (IsSignedVersionSeparateForFormat(texture_key)) {
+    host_format_is_signed = bool(texture_key.signed_separate);
+  } else {
+    host_format_is_signed = host_format_pair.format_unsigned.load_shader == kLoadShaderIndexUnknown;
+  }
+  const HostFormat& host_format =
+      host_format_is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned;
+  LoadShaderIndex load_shader = host_format.load_shader;
+  if (load_shader == kLoadShaderIndexUnknown || !load_pipelines_[load_shader].state) {
+    return false;
+  }
+  const LoadPipeline& pipeline = load_pipelines_[load_shader];
+  const LoadShaderInfo& load_shader_info = GetLoadShaderInfo(load_shader);
+
+  // The guest layout.
+  const texture_util::TextureGuestLayout& guest_layout = metal_texture.guest_layout();
+  xenos::DataDimension dimension = texture_key.dimension;
+  bool is_3d = dimension == xenos::DataDimension::k3D;
+  bool is_3d_tiling = is_3d || metal_texture.force_load_3d_tiling();
+  uint32_t width = texture_key.GetWidth();
+  uint32_t height = texture_key.GetHeight();
+  uint32_t depth_or_array_size = texture_key.GetDepthOrArraySize();
+  uint32_t depth = is_3d ? depth_or_array_size : 1;
+  uint32_t array_size = is_3d ? 1 : depth_or_array_size;
+  xenos::TextureFormat guest_format = texture_key.format;
+  const FormatInfo* guest_format_info = FormatInfo::Get(guest_format);
+  uint32_t block_width = guest_format_info->block_width;
+  uint32_t block_height = guest_format_info->block_height;
+  uint32_t bytes_per_block = guest_format_info->bytes_per_block();
+  uint32_t level_first = load_base ? 0 : 1;
+  uint32_t level_last = load_mips ? texture_key.mip_max_level : 0;
+  assert_true(level_first <= level_last);
+  uint32_t level_packed = guest_layout.packed_level;
+  uint32_t level_stored_first = std::min(level_first, level_packed);
+  uint32_t level_stored_last = std::min(level_last, level_packed);
+
+  // With the packed mip tail as level 0, loop iteration 0 is the base tail and 1 the mips tail; otherwise
+  // the iteration is the level.
+  uint32_t loop_level_first, loop_level_last;
+  if (level_packed == 0) {
+    loop_level_first = uint32_t(level_first != 0);
+    loop_level_last = uint32_t(level_last != 0);
+  } else {
+    loop_level_first = level_stored_first;
+    loop_level_last = level_stored_last;
+  }
+
+  // The host layout in the scratch buffer.
+  uint32_t host_block_width = host_format.block_compressed ? block_width : 1;
+  uint32_t host_block_height = host_format.block_compressed ? block_height : 1;
+  uint32_t host_x_blocks_per_thread = UINT32_C(1)
+                                      << load_shader_info.guest_x_blocks_per_thread_log2;
+  if (!host_format.block_compressed) {
+    host_x_blocks_per_thread *= block_width;
+  }
+  uint64_t host_buffer_size = 0;
+  struct HostLayout {
+    uint64_t offset_bytes;
+    uint64_t slice_size_bytes;
+    uint32_t x_pitch_blocks;
+    uint32_t y_pitch_blocks;
+  };
+  HostLayout host_layout_base;
+  HostLayout host_layout_mips[xenos::kTextureMaxMips];
+  for (uint32_t loop_level = loop_level_first; loop_level <= loop_level_last; ++loop_level) {
+    bool is_base = loop_level == 0;
+    uint32_t level = (level_packed == 0) ? 0 : loop_level;
+    HostLayout& level_host_layout = is_base ? host_layout_base : host_layout_mips[level];
+    level_host_layout.offset_bytes = host_buffer_size;
+    uint32_t level_guest_x_extent_texels;
+    uint32_t level_guest_y_extent_texels;
+    uint32_t level_guest_z_extent_texels;
+    if (level == level_packed) {
+      const texture_util::TextureGuestLayout::Level& guest_layout_packed =
+          is_base ? guest_layout.base : guest_layout.mips[level];
+      level_guest_x_extent_texels = guest_layout_packed.x_extent_blocks * block_width;
+      level_guest_y_extent_texels = guest_layout_packed.y_extent_blocks * block_height;
+      level_guest_z_extent_texels = guest_layout_packed.z_extent;
+    } else {
+      level_guest_x_extent_texels = std::max(width >> level, UINT32_C(1));
+      level_guest_y_extent_texels = std::max(height >> level, UINT32_C(1));
+      level_guest_z_extent_texels = std::max(depth >> level, UINT32_C(1));
+    }
+    level_host_layout.x_pitch_blocks = rex::round_up(
+        (level_guest_x_extent_texels + (host_block_width - 1)) / host_block_width,
+        host_x_blocks_per_thread);
+    level_host_layout.y_pitch_blocks =
+        (level_guest_y_extent_texels + (host_block_height - 1)) / host_block_height;
+    level_host_layout.slice_size_bytes = uint64_t(load_shader_info.bytes_per_host_block) *
+                                         level_host_layout.x_pitch_blocks *
+                                         level_host_layout.y_pitch_blocks *
+                                         level_guest_z_extent_texels;
+    host_buffer_size += level_host_layout.slice_size_bytes * array_size;
+  }
+  MTL::Buffer* scratch_buffer;
+  size_t scratch_offset;
+  if (!command_processor_.RequestScratchBuffer(host_buffer_size, scratch_buffer, scratch_offset)) {
+    return false;
+  }
+
+  // The sources: guest memory in place.
+  MetalSharedMemory& metal_shared_memory = static_cast<MetalSharedMemory&>(shared_memory());
+  const uint32_t segment_size = uint32_t(1) << metal_shared_memory.segment_size_log2();
+  uint32_t source_length_alignment = UINT32_C(1) << load_shader_info.source_bpe_log2;
+  std::pair<MTL::Buffer*, uint32_t> source_base(nullptr, 0), source_mips(nullptr, 0);
+  if (level_first == 0) {
+    uint32_t start = texture_key.base_page << 12;
+    uint64_t range = rex::align(uint64_t(metal_texture.GetGuestBaseSize()),
+                                uint64_t(source_length_alignment));
+    if (range > uint64_t(SharedMemory::kBufferSize) - start) {
+      return false;
+    }
+    source_base = metal_shared_memory.BufferAndOffset(start);
+    if (range > uint64_t(segment_size) - source_base.second) {
+      return false;  // crosses a shared memory segment
+    }
+  }
+  if (level_last != 0) {
+    uint32_t start = texture_key.mip_page << 12;
+    uint64_t range = rex::align(uint64_t(metal_texture.GetGuestMipsSize()),
+                                uint64_t(source_length_alignment));
+    if (range > uint64_t(SharedMemory::kBufferSize) - start) {
+      return false;
+    }
+    source_mips = metal_shared_memory.BufferAndOffset(start);
+    if (range > uint64_t(segment_size) - source_mips.second) {
+      return false;
+    }
+  }
+
+  // Untile / convert into the scratch buffer. Set 0: the destination, set 1: the source.
+  MetalComputeEncoder* encoder = command_processor_.BeginCompute("texture load");
+  encoder->setComputePipelineState(pipeline.state.get());
+  encoder->setBuffer(scratch_buffer, scratch_offset, 0 * kMslSlotsPerSet);
+
+  LoadConstants load_constants;
+  load_constants.is_tiled_3d_endian_scale = uint32_t(texture_key.tiled) |
+                                            (uint32_t(is_3d_tiling) << 1) |
+                                            (uint32_t(texture_key.endianness) << 2) |
+                                            (UINT32_C(1) << 4) | (UINT32_C(1) << 7);
+
+  uint32_t guest_x_blocks_per_group_log2 = load_shader_info.GetGuestXBlocksPerGroupLog2();
+  for (uint32_t loop_level = loop_level_first; loop_level <= loop_level_last; ++loop_level) {
+    bool is_base = loop_level == 0;
+    uint32_t level = (level_packed == 0) ? 0 : loop_level;
+
+    const std::pair<MTL::Buffer*, uint32_t>& source = is_base ? source_base : source_mips;
+    encoder->setBuffer(source.first, source.second, 1 * kMslSlotsPerSet);
+
+    load_constants.guest_offset = 0;
+    if (!is_base) {
+      load_constants.guest_offset += guest_layout.mip_offsets_bytes[level];
+    }
+    const texture_util::TextureGuestLayout::Level& level_guest_layout =
+        is_base ? guest_layout.base : guest_layout.mips[level];
+    uint32_t level_guest_pitch = level_guest_layout.row_pitch_bytes;
+    if (texture_key.tiled) {
+      // Shaders expect the pitch in blocks for tiled textures.
+      level_guest_pitch /= bytes_per_block;
+      assert_zero(level_guest_pitch & (xenos::kTextureTileWidthHeight - 1));
+    }
+    load_constants.guest_pitch_aligned = level_guest_pitch;
+    load_constants.guest_z_stride_block_rows_aligned = level_guest_layout.z_slice_stride_block_rows;
+
+    uint32_t level_width, level_height, level_depth;
+    if (level == level_packed) {
+      // The packed mip tail: the whole extent, holding other levels too.
+      level_width = level_guest_layout.x_extent_blocks * block_width;
+      level_height = level_guest_layout.y_extent_blocks * block_height;
+      level_depth = level_guest_layout.z_extent;
+    } else {
+      level_width = std::max(width >> level, UINT32_C(1));
+      level_height = std::max(height >> level, UINT32_C(1));
+      level_depth = std::max(depth >> level, UINT32_C(1));
+    }
+    load_constants.size_blocks[0] = (level_width + (block_width - 1)) / block_width;
+    load_constants.size_blocks[1] = (level_height + (block_height - 1)) / block_height;
+    load_constants.size_blocks[2] = level_depth;
+    load_constants.height_texels = level_height;
+
+    uint32_t group_count_x =
+        (load_constants.size_blocks[0] + ((UINT32_C(1) << guest_x_blocks_per_group_log2) - 1)) >>
+        guest_x_blocks_per_group_log2;
+    uint32_t group_count_y =
+        (load_constants.size_blocks[1] + ((UINT32_C(1) << kLoadGuestYBlocksPerGroupLog2) - 1)) >>
+        kLoadGuestYBlocksPerGroupLog2;
+
+    const HostLayout& level_host_layout = is_base ? host_layout_base : host_layout_mips[level];
+    load_constants.host_offset = uint32_t(level_host_layout.offset_bytes);
+    load_constants.host_pitch =
+        load_shader_info.bytes_per_host_block * level_host_layout.x_pitch_blocks;
+
+    for (uint32_t slice = 0; slice < array_size; ++slice) {
+      encoder->setBytes(&load_constants, sizeof(load_constants), kMslPushConstantsBufferSlot);
+      encoder->dispatchThreadgroups(
+          MTL::Size(group_count_x, group_count_y, load_constants.size_blocks[2]),
+          pipeline.threads_per_group);
+      load_constants.guest_offset += level_guest_layout.array_slice_stride_bytes;
+      load_constants.host_offset += uint32_t(level_host_layout.slice_size_bytes);
+    }
+  }
+
+  // Copy from the scratch buffer to the texture.
+  MetalBlitEncoder* blit = command_processor_.BeginBlit();
+  MTL::Texture* destination = metal_texture.texture();
+  for (uint32_t level = level_first; level <= level_last; ++level) {
+    const HostLayout& level_host_layout =
+        level != 0 ? host_layout_mips[std::min(level, level_packed)] : host_layout_base;
+    uint64_t buffer_offset = level_host_layout.offset_bytes;
+    if (level >= level_packed) {
+      uint32_t level_offset_blocks_x, level_offset_blocks_y, level_offset_z;
+      texture_util::GetPackedMipOffset(width, height, depth, guest_format, level,
+                                       level_offset_blocks_x, level_offset_blocks_y,
+                                       level_offset_z);
+      uint32_t level_offset_host_blocks_x = level_offset_blocks_x;
+      uint32_t level_offset_host_blocks_y = level_offset_blocks_y;
+      if (!host_format.block_compressed) {
+        level_offset_host_blocks_x *= block_width;
+        level_offset_host_blocks_y *= block_height;
+      }
+      buffer_offset += load_shader_info.bytes_per_host_block *
+                       (level_offset_host_blocks_x +
+                        level_host_layout.x_pitch_blocks *
+                            (level_offset_host_blocks_y +
+                             level_host_layout.y_pitch_blocks * uint64_t(level_offset_z)));
+    }
+    const NS::UInteger bytes_per_row =
+        NS::UInteger(load_shader_info.bytes_per_host_block) * level_host_layout.x_pitch_blocks;
+    const NS::UInteger bytes_per_image = bytes_per_row * level_host_layout.y_pitch_blocks;
+    const MTL::Size size(std::max(width >> level, UINT32_C(1)),
+                         std::max(height >> level, UINT32_C(1)),
+                         std::max(depth >> level, UINT32_C(1)));
+    for (uint32_t slice = 0; slice < array_size; ++slice) {
+      blit->copyFromBuffer(scratch_buffer,
+                           scratch_offset + buffer_offset + level_host_layout.slice_size_bytes * slice,
+                           bytes_per_row, is_3d ? bytes_per_image : 0, size, destination, slice,
+                           level, MTL::Origin(0, 0, 0));
+    }
+  }
+  metal_texture.MarkAsUsed();
+  return true;
+}
+
+void MetalTextureCache::UpdateTextureBindingsImpl(uint32_t fetch_constant_mask) {
+  uint32_t bindings_remaining = fetch_constant_mask;
+  uint32_t binding_index;
+  while (rex::bit_scan_forward(bindings_remaining, &binding_index)) {
+    bindings_remaining &= ~(UINT32_C(1) << binding_index);
+    MetalTextureBinding& metal_binding = metal_texture_bindings_[binding_index];
+    metal_binding.Reset();
+    const TextureBinding* binding = GetValidTextureBinding(binding_index);
+    if (!binding) {
+      continue;
+    }
+    const HostFormatPair& host_format_pair = GetHostFormatPair(binding->key);
+    bool uses_unsigned = texture_util::IsAnySignNotSigned(binding->swizzled_signs);
+    bool uses_signed = texture_util::IsAnySignSigned(binding->swizzled_signs);
+    xenos::TextureFormat format = binding->key.format;
+    if (uses_unsigned && host_format_pair.format_unsigned.format == MTL::PixelFormatInvalid) {
+      unsupported_format_features_used_[uint32_t(format)] |= kUnsupportedUnormBit;
+    }
+    if (uses_signed && host_format_pair.format_signed.format == MTL::PixelFormatInvalid) {
+      unsupported_format_features_used_[uint32_t(format)] |= kUnsupportedSnormBit;
+    }
+    if (IsSignedVersionSeparateForFormat(binding->key)) {
+      if (binding->texture && uses_unsigned &&
+          host_format_pair.format_unsigned.format != MTL::PixelFormatInvalid) {
+        metal_binding.texture_unsigned =
+            static_cast<MetalTexture*>(binding->texture)->GetView(false, binding->host_swizzle);
+      }
+      if (binding->texture_signed && uses_signed &&
+          host_format_pair.format_signed.format != MTL::PixelFormatInvalid) {
+        metal_binding.texture_signed =
+            static_cast<MetalTexture*>(binding->texture_signed)->GetView(true, binding->host_swizzle);
+      }
+    } else {
+      MetalTexture* texture = static_cast<MetalTexture*>(binding->texture);
+      if (texture) {
+        if (uses_unsigned && host_format_pair.format_unsigned.format != MTL::PixelFormatInvalid) {
+          metal_binding.texture_unsigned = texture->GetView(false, binding->host_swizzle);
+        }
+        if (uses_signed && host_format_pair.format_signed.format != MTL::PixelFormatInvalid) {
+          metal_binding.texture_signed = texture->GetView(true, binding->host_swizzle);
+        }
+      }
+    }
+  }
+}
+
+MetalTextureCache::MetalTexture::MetalTexture(MetalTextureCache& texture_cache,
+                                              const TextureKey& key,
+                                              ui::metal::Ref<MTL::Texture> texture,
+                                              bool track_usage)
+    : Texture(texture_cache, key, track_usage), texture_(std::move(texture)) {
+  SetHostMemoryUsage(uint64_t(texture_->allocatedSize()));
+  static_cast<MetalTextureCache&>(texture_cache).command_processor_.MakeResident(texture_.get());
+}
+
+MetalTextureCache::MetalTexture::~MetalTexture() {
+  // Destroyed once unused by the GPU, except when the cache is cleared.
+  MetalCommandProcessor& command_processor =
+      static_cast<MetalTextureCache&>(texture_cache()).command_processor_;
+  for (auto& view : views_) {
+    command_processor.ReleaseAfterUse(view.second.get());
+  }
+  command_processor.ReleaseResident(texture_.get());
+}
