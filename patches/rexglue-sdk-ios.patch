diff --git a/include/rex/graphics/metal/shared_memory.h b/include/rex/graphics/metal/shared_memory.h
new file mode 100644
index 0000000..dfb1901
--- /dev/null
+++ b/include/rex/graphics/metal/shared_memory.h
@@ -0,0 +1,61 @@
+/**
+ * @file        graphics/metal/shared_memory.h
+ * @brief       The guest's physical memory as Metal buffers, without copies
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <utility>
+
+#include <rex/graphics/shared_memory.h>
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+
+// Apple GPUs share memory with the CPU, as the Xenos did: the guest's 512 MB of physical memory is wrapped
+// as Metal buffers in place (newBufferWithBytesNoCopy), so the GPU reads vertices, indices, constants and
+// textures, and writes resolves and memory exports, directly in guest memory. Nothing is uploaded; the base
+// class's page tracking remains for what is derived from memory (textures), which CPU writes invalidate.
+class MetalSharedMemory : public SharedMemory {
+ public:
+  MetalSharedMemory(MetalCommandProcessor& command_processor, memory::Memory& memory);
+  ~MetalSharedMemory() override;
+
+  bool Initialize();
+  void Shutdown(bool from_destructor = false);
+
+  // One buffer where the device allows a buffer of kBufferSize, or else 2^buffer_count_log2() equal
+  // segments; shader bindings of shared memory never cross a segment.
+  uint32_t buffer_count_log2() const { return buffer_count_log2_; }
+  uint32_t buffer_count() const { return uint32_t(1) << buffer_count_log2_; }
+  uint32_t segment_size_log2() const { return kBufferSizeLog2 - buffer_count_log2_; }
+  MTL::Buffer* buffer(uint32_t index = 0) const { return buffers_[index].get(); }
+  std::pair<MTL::Buffer*, uint32_t> BufferAndOffset(uint32_t address) const {
+    return {buffers_[address >> segment_size_log2()].get(),
+            address & ((uint32_t(1) << segment_size_log2()) - 1)};
+  }
+
+ protected:
+  // The memory is the guest's own: nothing to bring over, but the pages become valid and watched, so CPU
+  // writes invalidate what was made from them (textures).
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>& upload_page_ranges) override {
+    for (const std::pair<uint32_t, uint32_t>& range : upload_page_ranges) {
+      MakeRangeValid(range.first << page_size_log2(), range.second << page_size_log2(), false);
+    }
+    return true;
+  }
+
+ private:
+  MetalCommandProcessor& command_processor_;
+  static constexpr uint32_t kMaxBufferCountLog2 = 3;
+  ui::metal::Ref<MTL::Buffer> buffers_[uint32_t(1) << kMaxBufferCountLog2];
+  uint32_t buffer_count_log2_ = 0;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/include/rex/graphics/metal/texture_cache.h b/include/rex/graphics/metal/texture_cache.h
new file mode 100644
index 0000000..a364415
--- /dev/null
+++ b/include/rex/graphics/metal/texture_cache.h
@@ -0,0 +1,201 @@
+/**
+ * @file        graphics/metal/texture_cache.h
+ * @brief       Guest textures as Metal textures
+ *
+ * The Vulkan texture cache's design on Metal: guest textures are untiled and converted by the same compute
+ * shaders (the build's SPIR-V, converted to MSL) into a scratch buffer, then blitted into the texture.
+ * Swizzles are texture view swizzles; 1D and 2D textures are 2D arrays, as the shader translator expects.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+
+#include <rex/graphics/pipeline/shader/spirv.h>
+#include <rex/graphics/pipeline/texture/cache.h>
+#include <rex/graphics/xenos.h>
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+class MetalSharedMemory;
+
+class MetalTextureCache final : public TextureCache {
+ public:
+  // Sampler parameters that can be converted to a Metal sampler directly.
+  union SamplerParameters {
+    uint32_t value;
+    struct {
+      xenos::ClampMode clamp_x : 3;         // 3
+      xenos::ClampMode clamp_y : 3;         // 6
+      xenos::ClampMode clamp_z : 3;         // 9
+      xenos::BorderColor border_color : 2;  // 11
+      uint32_t mag_linear : 1;              // 12
+      uint32_t min_linear : 1;              // 13
+      uint32_t mip_linear : 1;              // 14
+      xenos::AnisoFilter aniso_filter : 3;  // 17
+      uint32_t mip_min_level : 4;           // 21
+      uint32_t mip_base_map : 1;            // 22
+    };
+    SamplerParameters() : value(0) { static_assert_size(*this, sizeof(value)); }
+    bool operator==(const SamplerParameters& parameters) const { return value == parameters.value; }
+    bool operator!=(const SamplerParameters& parameters) const { return value != parameters.value; }
+  };
+
+  static std::unique_ptr<MetalTextureCache> Create(const RegisterFile& register_file,
+                                                   MetalSharedMemory& shared_memory,
+                                                   MetalCommandProcessor& command_processor);
+  ~MetalTextureCache();
+
+  void BeginFrame() override;
+
+  // The texture for a fetch constant as the shader binds it (dimension, signedness), or the null texture of
+  // that dimension.
+  MTL::Texture* GetActiveBindingOrNullTexture(uint32_t fetch_constant_index,
+                                              xenos::FetchOpDimension dimension, bool is_signed);
+
+  SamplerParameters GetSamplerParameters(const SpirvShader::SamplerBinding& binding) const;
+  MTL::SamplerState* GetSampler(SamplerParameters parameters);
+
+  // The 2D view of the front buffer texture for presenting, or null. May load the texture.
+  MTL::Texture* RequestSwapTexture(uint32_t& width_out, uint32_t& height_out,
+                                   xenos::TextureFormat& format_out);
+
+ protected:
+  bool IsSignedVersionSeparateForFormat(TextureKey key) const override;
+  uint32_t GetHostFormatSwizzle(TextureKey key) const override;
+
+  uint32_t GetMaxHostTextureWidthHeight(xenos::DataDimension dimension) const override;
+  uint32_t GetMaxHostTextureDepthOrArraySize(xenos::DataDimension dimension) const override;
+
+  std::unique_ptr<Texture> CreateTexture(TextureKey key) override;
+
+  bool LoadTextureDataFromResidentMemoryImpl(Texture& texture, bool load_base,
+                                             bool load_mips) override;
+
+  void UpdateTextureBindingsImpl(uint32_t fetch_constant_mask) override;
+
+ private:
+  struct HostFormat {
+    LoadShaderIndex load_shader;
+    MTL::PixelFormat format;
+    // Block-compressed on the host (the host block size is the guest's), not decompressed on load.
+    bool block_compressed;
+    bool linear_filterable;
+  };
+
+  struct HostFormatPair {
+    HostFormat format_unsigned;
+    HostFormat format_signed;
+    // Mapping of Xenos swizzle components to host format components.
+    uint32_t swizzle;
+    // Whether the unsigned and the signed formats can be views of one texture with the same data.
+    bool unsigned_signed_compatible;
+  };
+
+  class MetalTexture final : public Texture {
+   public:
+    MetalTexture(MetalTextureCache& texture_cache, const TextureKey& key,
+                 ui::metal::Ref<MTL::Texture> texture, bool track_usage = true);
+    ~MetalTexture();
+
+    MTL::Texture* texture() const { return texture_.get(); }
+    // A view in the format of the signedness, with the swizzle, as a 2D array (or 2D, cube, 3D).
+    MTL::Texture* GetView(bool is_signed, uint32_t host_swizzle, bool is_array = true);
+    // 3D textures sampled as 2D: a 2D copy of the first slice (gpu_3d_to_2d_texture).
+    MTL::Texture* GetOrCreate3DAs2DView(bool is_signed, uint32_t host_swizzle);
+
+   private:
+    union ViewKey {
+      uint32_t key;
+      struct {
+        uint32_t is_signed_separate_view : 1;
+        uint32_t host_swizzle : 12;
+        uint32_t is_array : 1;
+      };
+      ViewKey() : key(0) { static_assert_size(*this, sizeof(key)); }
+    };
+
+    ui::metal::Ref<MTL::Texture> texture_;
+    std::unordered_map<uint32_t, ui::metal::Ref<MTL::Texture>> views_;
+    std::unique_ptr<MetalTexture> texture_3d_as_2d_;
+  };
+
+  struct MetalTextureBinding {
+    MTL::Texture* texture_unsigned = nullptr;
+    MTL::Texture* texture_signed = nullptr;
+    void Reset() {
+      texture_unsigned = nullptr;
+      texture_signed = nullptr;
+    }
+  };
+
+  static constexpr bool AreDimensionsCompatible(xenos::FetchOpDimension binding_dimension,
+                                                xenos::DataDimension resource_dimension) {
+    switch (binding_dimension) {
+      case xenos::FetchOpDimension::k1D:
+      case xenos::FetchOpDimension::k2D:
+        return resource_dimension == xenos::DataDimension::k1D ||
+               resource_dimension == xenos::DataDimension::k2DOrStacked ||
+               resource_dimension == xenos::DataDimension::k3D;
+      case xenos::FetchOpDimension::k3DOrStacked:
+        return resource_dimension == xenos::DataDimension::k3D;
+      case xenos::FetchOpDimension::kCube:
+        return resource_dimension == xenos::DataDimension::kCube;
+      default:
+        return false;
+    }
+  }
+
+  MetalTextureCache(const RegisterFile& register_file, MetalSharedMemory& shared_memory,
+                    MetalCommandProcessor& command_processor);
+  bool Initialize();
+
+  const HostFormatPair& GetHostFormatPair(TextureKey key) const;
+  xenos::ClampMode NormalizeClampMode(xenos::ClampMode clamp_mode) const;
+
+  MetalCommandProcessor& command_processor_;
+
+  static const HostFormatPair kBestHostFormats[64];
+  static const HostFormatPair kHostFormatGBGRUnaligned;
+  static const HostFormatPair kHostFormatBGRGUnaligned;
+  static const HostFormatPair kHostFormatDXT1Unaligned;
+  static const HostFormatPair kHostFormatDXT2_3Unaligned;
+  static const HostFormatPair kHostFormatDXT4_5Unaligned;
+  static const HostFormatPair kHostFormatDXNUnaligned;
+  static const HostFormatPair kHostFormatDXT5AUnaligned;
+  HostFormatPair host_formats_[64];
+
+  struct LoadPipeline {
