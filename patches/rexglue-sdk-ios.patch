+    xenos::XE_GPU_TEXTURE_SWIZZLE_RGBA,
+    false};
+
+const MetalTextureCache::HostFormatPair MetalTextureCache::kHostFormatDXT2_3Unaligned = {
+    {kLoadShaderIndexDXT3ToRGBA8, MTL::PixelFormatRGBA8Unorm, false, true},
+    {kLoadShaderIndexUnknown},
+    xenos::XE_GPU_TEXTURE_SWIZZLE_RGBA,
+    false};
+
+const MetalTextureCache::HostFormatPair MetalTextureCache::kHostFormatDXT4_5Unaligned = {
+    {kLoadShaderIndexDXT5ToRGBA8, MTL::PixelFormatRGBA8Unorm, false, true},
+    {kLoadShaderIndexUnknown},
+    xenos::XE_GPU_TEXTURE_SWIZZLE_RGBA,
+    false};
+
