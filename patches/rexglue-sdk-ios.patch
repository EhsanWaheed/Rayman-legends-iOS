+  REX_METAL_RENDER_CALL(setBlendColor(red, green, blue, alpha));
+}
+
+#undef REX_METAL_RENDER_CALL
+
+void MetalRenderEncoder::SetBuffer(uint32_t stage, MTL::Buffer* buffer, size_t offset,
+                                   uint32_t slot) {
+  if (m3_) {
+    if (stage) {
+      m3_->setFragmentBuffer(buffer, offset, slot);
+    } else {
+      m3_->setVertexBuffer(buffer, offset, slot);
+    }
+    return;
+  }
+  buffers_[stage][slot] = buffer;
+  tables_[stage]->setAddress(buffer ? buffer->gpuAddress() + offset : 0, slot);
+}
+
+void MetalRenderEncoder::SetBufferOffset(uint32_t stage, size_t offset, uint32_t slot) {
+  if (m3_) {
+    if (stage) {
+      m3_->setFragmentBufferOffset(offset, slot);
+    } else {
+      m3_->setVertexBufferOffset(offset, slot);
+    }
+    return;
+  }
+  SetBuffer(stage, buffers_[stage][slot], offset, slot);
+}
+
+void MetalRenderEncoder::SetBytes(uint32_t stage, const void* data, size_t size, uint32_t slot) {
+  if (m3_ && size <= kMaxInlineBytes) {
+    if (stage) {
+      m3_->setFragmentBytes(data, size, slot);
+    } else {
+      m3_->setVertexBytes(data, size, slot);
+    }
+    return;
+  }
+  MTL::Buffer* buffer;
+  size_t offset;
+  void* mapping = command_processor_.RequestUploadSpace(size, 16, buffer, offset);
+  if (!mapping) {
+    return;
+  }
+  std::memcpy(mapping, data, size);
+  SetBuffer(stage, buffer, offset, slot);
+}
+
+void MetalRenderEncoder::SetTexture(uint32_t stage, MTL::Texture* texture, uint32_t slot) {
+  if (m3_) {
+    if (stage) {
+      m3_->setFragmentTexture(texture, slot);
+    } else {
+      m3_->setVertexTexture(texture, slot);
+    }
+    return;
+  }
+  tables_[stage]->setTexture(texture ? texture->gpuResourceID() : MTL::ResourceID{0}, slot);
+}
+
+void MetalRenderEncoder::SetSampler(uint32_t stage, MTL::SamplerState* sampler, uint32_t slot) {
+  if (m3_) {
+    if (stage) {
+      m3_->setFragmentSamplerState(sampler, slot);
+    } else {
+      m3_->setVertexSamplerState(sampler, slot);
+    }
+    return;
+  }
+  tables_[stage]->setSamplerState(sampler ? sampler->gpuResourceID() : MTL::ResourceID{0}, slot);
+}
+
+void MetalRenderEncoder::drawPrimitives(MTL::PrimitiveType type, NS::UInteger vertex_start,
+                                        NS::UInteger vertex_count) {
+  if (m3_) {
+    m3_->drawPrimitives(type, vertex_start, vertex_count);
+  } else {
+    m4_->drawPrimitives(type, vertex_start, vertex_count);
+  }
+}
+
+void MetalRenderEncoder::drawIndexedPrimitives(MTL::PrimitiveType type, NS::UInteger index_count,
+                                               MTL::IndexType index_type, MTL::Buffer* index_buffer,
+                                               NS::UInteger index_buffer_offset) {
+  if (m3_) {
+    m3_->drawIndexedPrimitives(type, index_count, index_type, index_buffer, index_buffer_offset);
+  } else {
+    m4_->drawIndexedPrimitives(type, index_count, index_type,
+                               index_buffer->gpuAddress() + index_buffer_offset,
+                               (index_buffer->length() - index_buffer_offset) & ~NS::UInteger(3));
+  }
+}
+
+// Compute.
+
+void MetalComputeEncoder::Begin(MTL::ComputeCommandEncoder* encoder) {
+  m3_ = encoder;
+  m4_ = nullptr;
+}
+
+void MetalComputeEncoder::Begin(MTL4::ComputeCommandEncoder* encoder, MTL4::ArgumentTable* table) {
+  m3_ = nullptr;
+  m4_ = encoder;
+  table_ = table;
+  m4_commands_ = false;
+  m4_->barrierAfterQueueStages(kAllStages, kComputeStages, MTL4::VisibilityOptionDevice);
+  m4_->setArgumentTable(table);
+}
+
+void MetalComputeEncoder::End() {
+  if (m3_) {
+    m3_->endEncoding();
+    m3_ = nullptr;
+  }
+  if (m4_) {
+    m4_->endEncoding();
+    m4_ = nullptr;
+  }
+}
+
+void MetalComputeEncoder::setLabel(const char* label) {
+  if (m3_) {
+    m3_->setLabel(Label(label));
+  } else {
+    m4_->setLabel(Label(label));
+  }
+}
+
+void MetalComputeEncoder::Serialize() {
+  if (m4_commands_) {
+    m4_->barrierAfterEncoderStages(kComputeStages, kComputeStages, MTL4::VisibilityOptionDevice);
+  }
+  m4_commands_ = true;
+}
+
+void MetalComputeEncoder::setComputePipelineState(MTL::ComputePipelineState* pipeline) {
+  if (m3_) {
+    m3_->setComputePipelineState(pipeline);
+  } else {
+    m4_->setComputePipelineState(pipeline);
+  }
+}
+
+void MetalComputeEncoder::setBuffer(MTL::Buffer* buffer, size_t offset, uint32_t slot) {
+  if (m3_) {
+    m3_->setBuffer(buffer, offset, slot);
+  } else {
+    table_->setAddress(buffer ? buffer->gpuAddress() + offset : 0, slot);
+  }
+}
+
+void MetalComputeEncoder::setBytes(const void* data, size_t size, uint32_t slot) {
+  if (m3_ && size <= kMaxInlineBytes) {
+    m3_->setBytes(data, size, slot);
+    return;
+  }
+  MTL::Buffer* buffer;
+  size_t offset;
+  void* mapping = command_processor_.RequestUploadSpace(size, 16, buffer, offset);
+  if (!mapping) {
+    return;
+  }
+  std::memcpy(mapping, data, size);
+  setBuffer(buffer, offset, slot);
+}
+
+void MetalComputeEncoder::setTexture(MTL::Texture* texture, uint32_t slot) {
+  if (m3_) {
+    m3_->setTexture(texture, slot);
+  } else {
+    table_->setTexture(texture ? texture->gpuResourceID() : MTL::ResourceID{0}, slot);
+  }
+}
+
+void MetalComputeEncoder::dispatchThreadgroups(MTL::Size threadgroups,
+                                               MTL::Size threads_per_threadgroup) {
+  if (m3_) {
+    m3_->dispatchThreadgroups(threadgroups, threads_per_threadgroup);
+    return;
+  }
+  Serialize();
+  m4_->dispatchThreadgroups(threadgroups, threads_per_threadgroup);
+}
+
+void MetalComputeEncoder::copyFromBuffer(MTL::Buffer* source, NS::UInteger source_offset,
+                                         NS::UInteger bytes_per_row, NS::UInteger bytes_per_image,
+                                         MTL::Size size, MTL::Texture* destination,
+                                         NS::UInteger slice, NS::UInteger level,
+                                         MTL::Origin origin) {
+  Serialize();
+  m4_->copyFromBuffer(source, source_offset, bytes_per_row, bytes_per_image, size, destination,
+                      slice, level, origin);
+}
+
+// Blit.
+
+void MetalBlitEncoder::End() {
+  if (m3_) {
+    m3_->endEncoding();
+    m3_ = nullptr;
+  }
+  compute_ = nullptr;
+}
+
+void MetalBlitEncoder::copyFromBuffer(MTL::Buffer* source, NS::UInteger source_offset,
+                                      NS::UInteger bytes_per_row, NS::UInteger bytes_per_image,
+                                      MTL::Size size, MTL::Texture* destination, NS::UInteger slice,
+                                      NS::UInteger level, MTL::Origin origin) {
+  if (m3_) {
+    m3_->copyFromBuffer(source, source_offset, bytes_per_row, bytes_per_image, size, destination,
+                        slice, level, origin);
+  } else {
+    compute_->copyFromBuffer(source, source_offset, bytes_per_row, bytes_per_image, size,
+                             destination, slice, level, origin);
+  }
+}
+
+}  // namespace rex::graphics::metal
