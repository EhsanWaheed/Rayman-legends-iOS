+/**
+ * @file        graphics/metal/primitive_processor.cpp
+ * @brief       Primitive processing (index conversion) for Metal (primitive_processor.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <cstring>
+
+#include <rex/graphics/metal/command_processor.h>
+#include <rex/graphics/metal/primitive_processor.h>
+#include <rex/logging.h>
+
+namespace rex::graphics::metal {
+
+MetalPrimitiveProcessor::~MetalPrimitiveProcessor() {
+  Shutdown(true);
+}
+
+bool MetalPrimitiveProcessor::Initialize() {
+  // Full 32-bit indices; no triangle fans, line loops or quads (converted); points and rectangles are
+  // expanded in the vertex shader (no geometry shaders on Metal).
+  if (!InitializeCommon(true, false, false, false, false, false)) {
+    Shutdown();
+    return false;
+  }
+  return true;
+}
+
+void MetalPrimitiveProcessor::Shutdown(bool from_destructor) {
+  frame_index_buffers_.clear();
+  builtin_index_buffer_.reset();
+  if (!from_destructor) {
+    ShutdownCommon();
+  }
+}
+
+void MetalPrimitiveProcessor::EndFrame() {
+  ClearPerFrameCache();
+  frame_index_buffers_.clear();
+}
+
+bool MetalPrimitiveProcessor::InitializeBuiltinIndexBuffer(
+    size_t size_bytes, std::function<void(void*)> fill_callback) {
+  builtin_index_buffer_ = ui::metal::Ref<MTL::Buffer>(command_processor_.device()->newBuffer(
+      size_bytes, MTL::ResourceStorageModeShared | MTL::ResourceCPUCacheModeWriteCombined));
+  if (!builtin_index_buffer_) {
+    REXGPU_ERROR("MetalPrimitiveProcessor: failed to create the {}-byte built-in index buffer",
+                 size_bytes);
+    return false;
+  }
+  command_processor_.MakeResident(builtin_index_buffer_.get());
+  fill_callback(builtin_index_buffer_->contents());
+  return true;
+}
+
+void* MetalPrimitiveProcessor::RequestHostConvertedIndexBufferForCurrentFrame(
+    xenos::IndexFormat format, uint32_t index_count, bool coalign_for_simd,
+    uint32_t coalignment_original_address, size_t& backend_handle_out) {
+  size_t index_size = format == xenos::IndexFormat::kInt16 ? sizeof(uint16_t) : sizeof(uint32_t);
+  MTL::Buffer* buffer;
+  size_t offset;
+  uint8_t* mapping = static_cast<uint8_t*>(command_processor_.RequestUploadSpace(
+      index_size * index_count + (coalign_for_simd ? XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE : 0),
+      index_size, buffer, offset));
+  if (!mapping) {
+    return nullptr;
+  }
+  if (coalign_for_simd) {
+    ptrdiff_t coalignment_offset = GetSimdCoalignmentOffset(mapping, coalignment_original_address);
+    mapping += coalignment_offset;
+    offset = size_t(offset + coalignment_offset);
+  }
+  backend_handle_out = frame_index_buffers_.size();
+  frame_index_buffers_.emplace_back(buffer, offset);
+  return mapping;
+}
+
+}  // namespace rex::graphics::metal
