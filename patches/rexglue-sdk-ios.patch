+
+bool MetalPipelineCache::CreatePipeline(const PipelineCreationRequest& request) {
+  const PipelineDescription& description = *request.description;
+  const MetalRenderTargetCache::RenderPassKey key = description.render_pass_key;
+  const bool has_depth = (key.depth_and_color_used & 1) != 0;
+  const uint32_t color_mask = (key.depth_and_color_used >> 1) & 0b1111;
+
+  MTL::Function* vertex_function = GetFunction(*request.vertex_shader, 0, false);
+  MTL::Function* fragment_function = nullptr;
+  bool ok = vertex_function != nullptr;
+  if (ok && !description.rasterizer_discard) {
+    if (request.pixel_shader) {
+      fragment_function = GetFunction(*request.pixel_shader, color_mask, has_depth);
+      ok = fragment_function != nullptr;
+    } else if (description.depth_float24_shader) {
+      fragment_function = GetDepthFloat24Function(description.depth_float24_shader == 2);
+      ok = fragment_function != nullptr;
+    }
+  }
+
+  Ref<MTL::RenderPipelineState> state;
+  if (ok) {
+    MTL::RenderPipelineDescriptor* descriptor = MTL::RenderPipelineDescriptor::alloc()->init();
+    descriptor->setVertexFunction(vertex_function);
+    descriptor->setFragmentFunction(fragment_function);
+    descriptor->setRasterSampleCount(render_target_cache_.GetHostSampleCount(key.msaa_samples));
+    if (description.rasterizer_discard) {
+      descriptor->setRasterizationEnabled(false);
+    } else {
+      for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+        if (!(color_mask & (1u << i))) {
+          continue;
+        }
+        MTL::RenderPipelineColorAttachmentDescriptor* attachment =
+            descriptor->colorAttachments()->object(i);
+        attachment->setPixelFormat(
+            render_target_cache_.GetColorPixelFormat(key.color_view_format(i)));
+        const PipelineRenderTarget& rt = description.render_targets[i];
+        MTL::ColorWriteMask write_mask = MTL::ColorWriteMaskNone;
+        if (rt.color_write_mask & 0b0001) write_mask |= MTL::ColorWriteMaskRed;
+        if (rt.color_write_mask & 0b0010) write_mask |= MTL::ColorWriteMaskGreen;
+        if (rt.color_write_mask & 0b0100) write_mask |= MTL::ColorWriteMaskBlue;
+        if (rt.color_write_mask & 0b1000) write_mask |= MTL::ColorWriteMaskAlpha;
+        attachment->setWriteMask(write_mask);
+        bool blending =
+            rt.color_write_mask &&
+            (rt.src_color_blend_factor != PipelineBlendFactor::kOne ||
+             rt.dst_color_blend_factor != PipelineBlendFactor::kZero ||
+             rt.color_blend_op != xenos::BlendOp::kAdd ||
+             rt.src_alpha_blend_factor != PipelineBlendFactor::kOne ||
+             rt.dst_alpha_blend_factor != PipelineBlendFactor::kZero ||
+             rt.alpha_blend_op != xenos::BlendOp::kAdd);
+        attachment->setBlendingEnabled(blending);
+        if (blending) {
+          attachment->setSourceRGBBlendFactor(ToMetalBlendFactor(uint32_t(rt.src_color_blend_factor)));
+          attachment->setDestinationRGBBlendFactor(
+              ToMetalBlendFactor(uint32_t(rt.dst_color_blend_factor)));
+          attachment->setRgbBlendOperation(ToMetalBlendOp(rt.color_blend_op));
+          attachment->setSourceAlphaBlendFactor(
+              ToMetalBlendFactor(uint32_t(rt.src_alpha_blend_factor)));
+          attachment->setDestinationAlphaBlendFactor(
+              ToMetalBlendFactor(uint32_t(rt.dst_alpha_blend_factor)));
+          attachment->setAlphaBlendOperation(ToMetalBlendOp(rt.alpha_blend_op));
+        }
+      }
+      if (has_depth) {
+        MTL::PixelFormat depth_format = MetalRenderTargetCache::GetDepthPixelFormat(key.depth_format);
+        descriptor->setDepthAttachmentPixelFormat(depth_format);
+        descriptor->setStencilAttachmentPixelFormat(depth_format);
+      }
+    }
+    NS::Error* error = nullptr;
+    state = Ref<MTL::RenderPipelineState>(
+        command_processor_.device()->newRenderPipelineState(descriptor, &error));
+    descriptor->release();
+    if (!state) {
+      REXGPU_ERROR("MetalPipelineCache: pipeline for VS {:016X} PS {:016X}: {}",
+                   description.vertex_shader_hash, description.pixel_shader_hash,
+                   error ? error->localizedDescription()->utf8String() : "unknown error");
+    }
+  }
+  request.pipeline->pipeline = std::move(state);
+  bool created = bool(request.pipeline->pipeline);
+  request.pipeline->state.store(created ? 1 : 2, std::memory_order_release);
+  return created;
+}
+
+void MetalPipelineCache::CreationThread() {
+  rex::thread::set_current_thread_name("Metal Pipelines");
+  while (true) {
+    PipelineCreationRequest request;
+    {
+      std::unique_lock<std::mutex> lock(creation_mutex_);
+      creation_cond_.wait(lock,
+                          [this]() { return creation_threads_shutdown_ || !creation_queue_.empty(); });
+      if (creation_threads_shutdown_) {
+        return;
+      }
+      request = creation_queue_.front();
+      creation_queue_.pop_front();
+      ++creation_threads_busy_;
+    }
+    NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+    CreatePipeline(request);
+    pool->release();
+    {
+      std::lock_guard<std::mutex> lock(creation_mutex_);
+      --creation_threads_busy_;
+    }
+  }
+}
+
+bool MetalPipelineCache::IsCreatingPipelines() const {
+  std::lock_guard<std::mutex> lock(creation_mutex_);
+  return !creation_queue_.empty() || creation_threads_busy_ != 0;
+}
+
+MTL::DepthStencilState* MetalPipelineCache::GetDepthStencilState(
+    reg::RB_DEPTHCONTROL normalized_depth_control, bool primitive_polygonal,
+    bool has_depth_attachment) {
+  if (!has_depth_attachment) {
+    // Metal wants a state even without depth / stencil: nothing tested or written (key 7: always).
+    normalized_depth_control.value = 0;
+  }
+  const RegisterFile& regs = register_file_;
+  // Key: the normalized depth control bits that matter, and the stencil masks.
+  uint64_t key = 0;
+  bool stencil = normalized_depth_control.stencil_enable;
+  bool backface = stencil && primitive_polygonal && normalized_depth_control.backface_enable;
+  reg::RB_STENCILREFMASK front_masks = regs.Get<reg::RB_STENCILREFMASK>();
+  reg::RB_STENCILREFMASK back_masks =
+      backface ? regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF) : front_masks;
+  xenos::CompareFunction depth_func =
+      normalized_depth_control.z_enable ? normalized_depth_control.zfunc
+                                        : xenos::CompareFunction::kAlways;
+  bool depth_write = normalized_depth_control.z_enable && normalized_depth_control.z_write_enable;
+  key |= uint64_t(depth_func);
+  key |= uint64_t(depth_write) << 3;
+  if (stencil) {
+    key |= uint64_t(1) << 4;
+    key |= uint64_t((normalized_depth_control.value >> 8) & 0xFFF) << 5;  // front func / ops
+    key |= uint64_t(backface ? (normalized_depth_control.value >> 20) & 0xFFF
+                             : (normalized_depth_control.value >> 8) & 0xFFF)
+           << 17;
+    key |= uint64_t(front_masks.stencilmask) << 29;
+    key |= uint64_t(front_masks.stencilwritemask) << 37;
+    key |= uint64_t(back_masks.stencilmask) << 45;
+    key |= uint64_t(back_masks.stencilwritemask) << 53;
+  }
+  auto it = depth_stencil_states_.find(key);
+  if (it != depth_stencil_states_.end()) {
+    return it->second.get();
+  }
+  MTL::DepthStencilDescriptor* descriptor = MTL::DepthStencilDescriptor::alloc()->init();
+  descriptor->setDepthCompareFunction(ToMetalCompare(depth_func));
+  descriptor->setDepthWriteEnabled(depth_write);
+  if (stencil) {
+    MTL::StencilDescriptor* front = MTL::StencilDescriptor::alloc()->init();
+    front->setStencilCompareFunction(ToMetalCompare(normalized_depth_control.stencilfunc));
+    front->setStencilFailureOperation(ToMetalStencilOp(normalized_depth_control.stencilfail));
+    front->setDepthFailureOperation(ToMetalStencilOp(normalized_depth_control.stencilzfail));
+    front->setDepthStencilPassOperation(ToMetalStencilOp(normalized_depth_control.stencilzpass));
+    front->setReadMask(front_masks.stencilmask);
+    front->setWriteMask(front_masks.stencilwritemask);
+    MTL::StencilDescriptor* back = MTL::StencilDescriptor::alloc()->init();
+    if (backface) {
+      back->setStencilCompareFunction(ToMetalCompare(normalized_depth_control.stencilfunc_bf));
+      back->setStencilFailureOperation(ToMetalStencilOp(normalized_depth_control.stencilfail_bf));
+      back->setDepthFailureOperation(ToMetalStencilOp(normalized_depth_control.stencilzfail_bf));
+      back->setDepthStencilPassOperation(
+          ToMetalStencilOp(normalized_depth_control.stencilzpass_bf));
+    } else {
+      back->setStencilCompareFunction(front->stencilCompareFunction());
+      back->setStencilFailureOperation(front->stencilFailureOperation());
+      back->setDepthFailureOperation(front->depthFailureOperation());
+      back->setDepthStencilPassOperation(front->depthStencilPassOperation());
+    }
+    back->setReadMask(back_masks.stencilmask);
+    back->setWriteMask(back_masks.stencilwritemask);
+    descriptor->setFrontFaceStencil(front);
+    descriptor->setBackFaceStencil(back);
+    front->release();
+    back->release();
+  }
+  Ref<MTL::DepthStencilState> state(command_processor_.device()->newDepthStencilState(descriptor));
+  descriptor->release();
+  MTL::DepthStencilState* result = state.get();
+  depth_stencil_states_.emplace(key, std::move(state));
+  return result;
+}
+
+}  // namespace rex::graphics::metal
