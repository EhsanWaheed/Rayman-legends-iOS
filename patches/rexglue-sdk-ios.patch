+namespace {
+
+MTL::TextureSwizzle GetSwizzle(uint32_t texture_swizzle, uint32_t component_index) {
+  switch (xenos::XE_GPU_TEXTURE_SWIZZLE((texture_swizzle >> (3 * component_index)) & 0b111)) {
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_R:
+      return MTL::TextureSwizzleRed;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_G:
+      return MTL::TextureSwizzleGreen;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_B:
+      return MTL::TextureSwizzleBlue;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_A:
+      return MTL::TextureSwizzleAlpha;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_0:
+      return MTL::TextureSwizzleZero;
+    case xenos::XE_GPU_TEXTURE_SWIZZLE_1:
+      return MTL::TextureSwizzleOne;
+    default:
+      return MTL::TextureSwizzle(MTL::TextureSwizzleRed + component_index);
+  }
+}
+
+}  // namespace
+
+MTL::Texture* MetalTextureCache::MetalTexture::GetView(bool is_signed, uint32_t host_swizzle,
+                                                       bool is_array) {
+  xenos::DataDimension dimension = key().dimension;
+  if (dimension == xenos::DataDimension::k3D || dimension == xenos::DataDimension::kCube) {
+    is_array = false;
+  }
+  const MetalTextureCache& metal_texture_cache =
+      static_cast<const MetalTextureCache&>(texture_cache());
+  const HostFormatPair& host_format_pair = metal_texture_cache.GetHostFormatPair(key());
+  MTL::PixelFormat format =
+      (is_signed ? host_format_pair.format_signed : host_format_pair.format_unsigned).format;
+  if (format == MTL::PixelFormatInvalid) {
+    return nullptr;
+  }
+  ViewKey view_key;
+  view_key.is_signed_separate_view =
+      is_signed && (host_format_pair.format_signed.format != host_format_pair.format_unsigned.format);
+  view_key.host_swizzle = host_swizzle;
+  view_key.is_array = uint32_t(is_array);
+  auto it = views_.find(view_key.key);
+  if (it != views_.end()) {
+    return it->second.get();
+  }
+  MTL::TextureType type;
+  NS::UInteger slice_count = texture_->arrayLength();
+  switch (dimension) {
+    case xenos::DataDimension::k3D:
+      type = MTL::TextureType3D;
+      slice_count = 1;
+      break;
+    case xenos::DataDimension::kCube:
+      type = MTL::TextureTypeCube;
+      slice_count = 6;
+      break;
+    default:
+      if (is_array) {
+        type = MTL::TextureType2DArray;
+      } else {
+        type = MTL::TextureType2D;
+        slice_count = 1;
+      }
+      break;
+  }
+  MTL::TextureSwizzleChannels swizzle(GetSwizzle(host_swizzle, 0), GetSwizzle(host_swizzle, 1),
+                                      GetSwizzle(host_swizzle, 2), GetSwizzle(host_swizzle, 3));
+  ui::metal::Ref<MTL::Texture> view(texture_->newTextureView(
+      format, type, NS::Range(0, texture_->mipmapLevelCount()), NS::Range(0, slice_count),
+      swizzle));
+  if (!view) {
+    REXGPU_ERROR("MetalTextureCache: failed to create a view (format {}, {}signed, swizzle 0x{:03X})",
+                 uint32_t(format), is_signed ? "" : "un", host_swizzle);
+    return nullptr;
+  }
+  MTL::Texture* result = view.get();
+  views_.emplace(view_key.key, std::move(view));
+  return result;
+}
+
+MTL::Texture* MetalTextureCache::MetalTexture::GetOrCreate3DAs2DView(bool is_signed,
+                                                                     uint32_t host_swizzle) {
+  if (!REXCVAR_GET(gpu_3d_to_2d_texture)) {
+    return nullptr;
+  }
+  MetalTextureCache& metal_texture_cache = static_cast<MetalTextureCache&>(texture_cache());
+  if (!texture_3d_as_2d_) {
+    const HostFormatPair& host_format_pair = metal_texture_cache.GetHostFormatPair(key());
+    MTL::PixelFormat format = host_format_pair.format_unsigned.format;
+    if (format == MTL::PixelFormatInvalid) {
+      format = host_format_pair.format_signed.format;
+    }
+    if (format == MTL::PixelFormatInvalid) {
+      return nullptr;
+    }
+    MTL::TextureDescriptor* descriptor = MTL::TextureDescriptor::alloc()->init();
+    descriptor->setTextureType(MTL::TextureType2DArray);
+    descriptor->setPixelFormat(format);
+    descriptor->setWidth(key().GetWidth());
+    descriptor->setHeight(key().GetHeight());
+    descriptor->setArrayLength(1);
+    descriptor->setStorageMode(MTL::StorageModePrivate);
+    descriptor->setUsage(MTL::TextureUsageShaderRead | MTL::TextureUsagePixelFormatView);
+    ui::metal::Ref<MTL::Texture> texture_2d(
+        metal_texture_cache.command_processor_.device()->newTexture(descriptor));
+    descriptor->release();
+    if (!texture_2d) {
+      return nullptr;
+    }
+    TextureKey key_2d = key();
+    key_2d.depth_or_array_size_minus_1 = 0;
+    key_2d.mip_max_level = 0;
+    texture_3d_as_2d_.reset(
+        new MetalTexture(metal_texture_cache, key_2d, std::move(texture_2d), false));
+    texture_3d_as_2d_->SetForceLoad3DTiling(true);
+    if (!metal_texture_cache.LoadTextureData(*texture_3d_as_2d_)) {
+      REXGPU_ERROR("MetalTextureCache: failed to load a 3D-as-2D texture");
+      texture_3d_as_2d_.reset();
+      return nullptr;
+    }
+  }
+  return texture_3d_as_2d_->GetView(is_signed, host_swizzle, true);
+}
+
+const MetalTextureCache::HostFormatPair& MetalTextureCache::GetHostFormatPair(
+    TextureKey key) const {
+  const HostFormatPair& host_format_pair = host_formats_[uint32_t(key.format)];
+  if (!host_format_pair.format_unsigned.block_compressed &&
+      !host_format_pair.format_signed.block_compressed) {
+    return host_format_pair;
+  }
+  // Decompress where the size isn't a whole number of blocks (as on D3D12).
+  const FormatInfo* format_info = FormatInfo::Get(key.format);
+  if (!(key.GetWidth() & (format_info->block_width - 1)) &&
+      !(key.GetHeight() & (format_info->block_height - 1))) {
+    return host_format_pair;
+  }
+  switch (key.format) {
+    case xenos::TextureFormat::k_Cr_Y1_Cb_Y0_REP:
+      return kHostFormatGBGRUnaligned;
+    case xenos::TextureFormat::k_Y1_Cr_Y0_Cb_REP:
+      return kHostFormatBGRGUnaligned;
+    case xenos::TextureFormat::k_DXT1:
+    case xenos::TextureFormat::k_DXT1_AS_16_16_16_16:
+      return kHostFormatDXT1Unaligned;
+    case xenos::TextureFormat::k_DXT2_3:
+    case xenos::TextureFormat::k_DXT2_3_AS_16_16_16_16:
+      return kHostFormatDXT2_3Unaligned;
+    case xenos::TextureFormat::k_DXT4_5:
+    case xenos::TextureFormat::k_DXT4_5_AS_16_16_16_16:
+      return kHostFormatDXT4_5Unaligned;
+    case xenos::TextureFormat::k_DXN:
+      return kHostFormatDXNUnaligned;
+    case xenos::TextureFormat::k_DXT5A:
+      return kHostFormatDXT5AUnaligned;
+    default:
+      return host_format_pair;
+  }
+}
+
+xenos::ClampMode MetalTextureCache::NormalizeClampMode(xenos::ClampMode clamp_mode) const {
+  if (clamp_mode == xenos::ClampMode::kClampToHalfway) {
+    return xenos::ClampMode::kClampToEdge;
+  }
+  if (clamp_mode == xenos::ClampMode::kMirrorClampToEdge ||
+      clamp_mode == xenos::ClampMode::kMirrorClampToHalfway ||
+      clamp_mode == xenos::ClampMode::kMirrorClampToBorder) {
+    return xenos::ClampMode::kMirrorClampToEdge;
+  }
+  return clamp_mode;
+}
