+namespace shaders {
+#include "../shaders/vulkan_spirv/host_depth_store_1xmsaa_cs.h"
+#include "../shaders/vulkan_spirv/host_depth_store_2xmsaa_cs.h"
+#include "../shaders/vulkan_spirv/host_depth_store_4xmsaa_cs.h"
