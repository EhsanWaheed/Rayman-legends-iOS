new file mode 100644
index 0000000..8a341e6
--- /dev/null
+++ b/include/rex/graphics/metal/msl.h
@@ -0,0 +1,64 @@
+/**
+ * @file        graphics/metal/msl.h
+ * @brief       SPIR-V to Metal Shading Language (SPIRV-Cross), and compiling it into Metal functions
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+enum class MslStage { kVertex, kFragment, kCompute };
+
+// Where a SPIR-V resource goes in Metal: descriptor set and binding (or push constants) to the argument
+// table slots of the stage.
+struct MslBinding {
+  static constexpr uint32_t kPushConstants = UINT32_MAX;
+  uint32_t set;  // kPushConstants for the push constant block (binding ignored)
+  uint32_t binding;
+  // The Metal slots, for the resource's kind; for arrays, the first of consecutive slots.
+  uint32_t buffer = 0;
+  uint32_t texture = 0;
+  uint32_t sampler = 0;
+};
+
+// For the backend's own utility shaders (resolves, ownership transfers, dumps, texture loads): every
+// resource at slot set * kMslSlotsPerSet + binding of its kind (buffer, texture, sampler), push constants in
+// buffer kMslPushConstantsBufferSlot.
+constexpr uint32_t kMslSlotsPerSet = 4;
+constexpr uint32_t kMslPushConstantsBufferSlot = 29;
+
+struct MslOptions {
+  // Map the resources by kMslSlotsPerSet instead of (or in addition to) the explicit bindings.
+  bool auto_slots = false;
+  // Bit per color output to keep (the render targets the pipeline has); the rest are dropped.
+  uint32_t fragment_output_mask = 0xFFFFFFFF;
+  bool fragment_depth_output = true;
+  bool fragment_stencil_output = true;
+  // Emits [[point_size]] (only for point topologies).
+  bool point_size = false;
+  // Vertex shaders: SPIR-V for Vulkan has Y pointing down in clip space, Metal up - negate it so the
+  // same viewports give the same pixels.
+  bool flip_vertex_y = true;
+};
+
+// The MSL source for a SPIR-V module, or empty with error_out on failure. The entry point is renamed
+// entry_point_name.
+std::string SpirvToMsl(const uint32_t* spirv, size_t spirv_word_count, MslStage stage,
+                       const std::vector<MslBinding>& bindings, const MslOptions& options,
+                       const std::string& entry_point_name, std::string* error_out,
+                       uint32_t* compute_local_size_out = nullptr);
+
+// Compiles MSL source and returns its function (retained), or null with error_out. Safe on any thread.
+MTL::Function* CompileMsl(MTL::Device* device, const std::string& source,
+                          const std::string& entry_point_name, std::string* error_out);
+
+}  // namespace rex::graphics::metal
diff --git a/include/rex/graphics/metal/pipeline_cache.h b/include/rex/graphics/metal/pipeline_cache.h
new file mode 100644
index 0000000..7d49da2
--- /dev/null
+++ b/include/rex/graphics/metal/pipeline_cache.h
@@ -0,0 +1,225 @@
+/**
+ * @file        graphics/metal/pipeline_cache.h
+ * @brief       Guest shaders as Metal functions, and render pipeline states
+ *
+ * The SDK's SPIR-V translator produces the guest shaders (as for Vulkan), which are converted to MSL and
+ * compiled for each render target configuration they're used with. Pipelines are created on worker
+ * threads; while one is compiling, its draws are skipped (as the Vulkan path does without placeholders).
+ * Rasterizer state that Vulkan bakes into pipelines (culling, winding, fill mode, depth clamp) is dynamic
+ * encoder state on Metal, so it's not part of the pipeline description here.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/metal/msl.h>
+#include <rex/graphics/metal/render_target_cache.h>
+#include <rex/graphics/pipeline/shader/spirv.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/registers.h>
+#include <rex/graphics/xenos.h>
+#include <rex/hash.h>
+#include <rex/string/buffer.h>
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+
+class MetalPipelineCache {
+ public:
+  // Metal buffer slots of the translated guest shaders' resources (both stages).
+  static constexpr uint32_t kSharedMemoryBufferSlot = 0;  // up to 4 segments: slots 0...3
+  static constexpr uint32_t kEdramBufferSlot = 4;
+  static constexpr uint32_t kConstantBufferSlotFirst = 5;  // + SpirvShaderTranslator::kConstantBuffer*
+
+  MetalPipelineCache(MetalCommandProcessor& command_processor, const RegisterFile& register_file,
+                     MetalRenderTargetCache& render_target_cache);
+  ~MetalPipelineCache();
+
+  bool Initialize(uint32_t shared_memory_buffer_count_log2);
+  void Shutdown();
+
+  SpirvShader* LoadShader(xenos::ShaderType shader_type, const uint32_t* host_address,
+                          uint32_t dword_count);
+  void AnalyzeShaderUcode(Shader& shader) { shader.AnalyzeUcode(ucode_disasm_buffer_); }
+
+  SpirvShaderTranslator::Modification GetCurrentVertexShaderModification(
+      const Shader& shader, Shader::HostVertexShaderType host_vertex_shader_type,
+      uint32_t interpolator_mask, bool ps_param_gen_used) const;
+  SpirvShaderTranslator::Modification GetCurrentPixelShaderModification(
+      const Shader& shader, uint32_t interpolator_mask, uint32_t param_gen_pos,
+      reg::RB_DEPTHCONTROL normalized_depth_control) const;
+
+  bool EnsureShadersTranslated(SpirvShader::SpirvTranslation* vertex_shader,
+                               SpirvShader::SpirvTranslation* pixel_shader);
+
+  // The pipeline for the current state, or null - with pending_out set if it's still being created in the
+  // background (the draw is skipped, not waited for).
+  MTL::RenderPipelineState* ConfigurePipeline(
+      SpirvShader::SpirvTranslation* vertex_shader, SpirvShader::SpirvTranslation* pixel_shader,
+      const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+      reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+      MetalRenderTargetCache::RenderPassKey render_pass_key, bool& pending_out,
+      bool allow_async = true);
+
+  // Depth / stencil state for the current registers (a no-op one without a depth attachment).
+  MTL::DepthStencilState* GetDepthStencilState(reg::RB_DEPTHCONTROL normalized_depth_control,
+                                               bool primitive_polygonal, bool has_depth_attachment);
+
+  bool IsCreatingPipelines() const;
+
+ private:
+  enum class PipelineBlendFactor : uint32_t {
+    kZero,
+    kOne,
+    kSrcColor,
+    kOneMinusSrcColor,
+    kDstColor,
+    kOneMinusDstColor,
+    kSrcAlpha,
+    kOneMinusSrcAlpha,
+    kDstAlpha,
+    kOneMinusDstAlpha,
+    kConstantColor,
+    kOneMinusConstantColor,
+    kConstantAlpha,
+    kOneMinusConstantAlpha,
+    kSrcAlphaSaturate,
+  };
+
+  struct PipelineRenderTarget {
+    PipelineBlendFactor src_color_blend_factor : 4;  // 4
+    PipelineBlendFactor dst_color_blend_factor : 4;  // 8
+    xenos::BlendOp color_blend_op : 3;               // 11
+    PipelineBlendFactor src_alpha_blend_factor : 4;  // 15
+    PipelineBlendFactor dst_alpha_blend_factor : 4;  // 19
+    xenos::BlendOp alpha_blend_op : 3;               // 22
+    uint32_t color_write_mask : 4;                   // 26
+  };
+
+  struct PipelineDescription {
+    uint64_t vertex_shader_hash;
+    uint64_t vertex_shader_modification;
+    uint64_t pixel_shader_hash;
+    uint64_t pixel_shader_modification;
+    MetalRenderTargetCache::RenderPassKey render_pass_key;
+    uint32_t rasterizer_discard : 1;
+    // A pixel shader replacement for depth-only draws: float24 depth conversion.
+    uint32_t depth_float24_shader : 2;  // 0 - none, 1 - truncating, 2 - rounding
+    PipelineRenderTarget render_targets[xenos::kMaxColorRenderTargets];
+
+    PipelineDescription() { Reset(); }
+    PipelineDescription(const PipelineDescription& description) {
+      std::memcpy(this, &description, sizeof(*this));
+    }
+    PipelineDescription& operator=(const PipelineDescription& description) {
+      std::memcpy(this, &description, sizeof(*this));
+      return *this;
+    }
+    bool operator==(const PipelineDescription& description) const {
+      return std::memcmp(this, &description, sizeof(*this)) == 0;
+    }
+    void Reset() { std::memset(this, 0, sizeof(*this)); }
+    uint64_t GetHash() const { return XXH3_64bits(this, sizeof(*this)); }
+    struct Hasher {
+      size_t operator()(const PipelineDescription& description) const {
+        return size_t(description.GetHash());
+      }
+    };
+  };
+
+  struct Pipeline {
+    // 0 - pending, 1 - ready, 2 - failed.
+    std::atomic<uint32_t> state{0};
+    ui::metal::Ref<MTL::RenderPipelineState> pipeline;
+  };
+
+  struct PipelineCreationRequest {
+    const PipelineDescription* description;
+    Pipeline* pipeline;
+    SpirvShader::SpirvTranslation* vertex_shader;
+    SpirvShader::SpirvTranslation* pixel_shader;
+  };
+
+  bool TranslateAnalyzedShader(SpirvShader::SpirvTranslation& translation);
+  void WritePipelineRenderTargetDescription(reg::RB_BLENDCONTROL blend_control, uint32_t write_mask,
+                                            PipelineRenderTarget& render_target_out) const;
+  bool GetCurrentStateDescription(
+      const SpirvShader::SpirvTranslation* vertex_shader,
+      const SpirvShader::SpirvTranslation* pixel_shader,
+      const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+      reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+      MetalRenderTargetCache::RenderPassKey render_pass_key,
+      PipelineDescription& description_out) const;
+
+  // The Metal function of a translation for a set of render target outputs (thread-safe).
+  MTL::Function* GetFunction(const SpirvShader::SpirvTranslation& translation,
+                             uint32_t color_output_mask, bool depth_output);
+  // Same, for one of the backend's own SPIR-V fragment shaders.
+  MTL::Function* GetDepthFloat24Function(bool round);
+  // The MSL resource bindings of a translated shader.
+  std::vector<MslBinding> GetShaderBindings(const SpirvShader& shader, bool is_vertex) const;
+
+  bool CreatePipeline(const PipelineCreationRequest& request);
+  void CreationThread();
+
+  MetalCommandProcessor& command_processor_;
+  const RegisterFile& register_file_;
+  MetalRenderTargetCache& render_target_cache_;
+  uint32_t shared_memory_buffer_count_ = 1;
+
+  string::StringBuffer ucode_disasm_buffer_;
+  std::unique_ptr<SpirvShaderTranslator> shader_translator_;
+
+  std::unordered_map<uint64_t, std::unique_ptr<SpirvShader>> shaders_;
+
+  // Functions by translation, output mask and depth output.
+  std::mutex functions_mutex_;
+  struct FunctionKey {
+    const void* translation;
+    uint32_t outputs;
+    bool operator==(const FunctionKey& other) const {
+      return translation == other.translation && outputs == other.outputs;
+    }
+    struct Hasher {
+      size_t operator()(const FunctionKey& key) const {
+        return std::hash<const void*>{}(key.translation) ^ (size_t(key.outputs) * 0x9E3779B97F4A7C15ull);
+      }
+    };
+  };
+  std::unordered_map<FunctionKey, ui::metal::Ref<MTL::Function>, FunctionKey::Hasher> functions_;
+  std::vector<uint8_t> depth_float24_spirv_[2];
+  ui::metal::Ref<MTL::Function> depth_float24_functions_[2];
+
+  std::unordered_map<PipelineDescription, std::unique_ptr<Pipeline>, PipelineDescription::Hasher>
+      pipelines_;
+  const PipelineDescription* last_pipeline_description_ = nullptr;
+  Pipeline* last_pipeline_ = nullptr;
+
+  std::unordered_map<uint64_t, ui::metal::Ref<MTL::DepthStencilState>> depth_stencil_states_;
+
+  mutable std::mutex creation_mutex_;
+  std::condition_variable creation_cond_;
+  std::deque<PipelineCreationRequest> creation_queue_;
+  size_t creation_threads_busy_ = 0;
+  bool creation_threads_shutdown_ = false;
+  std::vector<std::thread> creation_threads_;
+};
+
+}  // namespace rex::graphics::metal
