+// Memory.
+
+void* MetalCommandProcessor::RequestUploadSpace(size_t size, size_t alignment,
+                                                MTL::Buffer*& buffer_out, size_t& offset_out) {
+  alignment = std::max(alignment, size_t(16));
+  if (size > kUploadChunkSize) {
+    // A dedicated buffer, released when the command buffer is done with it.
+    Ref<MTL::Buffer> buffer(device()->newBuffer(size, MTL::ResourceStorageModeShared |
+                                                          MTL::ResourceCPUCacheModeWriteCombined));
+    if (!buffer) {
+      return nullptr;
+    }
+    MakeResident(buffer.get());
+    UploadChunk chunk;
+    chunk.buffer = buffer;
+    chunk.used = size;
+    chunk.last_usage = frame_current_;
+    // Kept in the list until the frame completes (as an oversized chunk, never reused for others).
+    upload_chunks_.push_back(std::move(chunk));
+    buffer_out = buffer.get();
+    offset_out = 0;
+    return buffer->contents();
+  }
+  if (upload_chunk_current_ != SIZE_MAX) {
+    UploadChunk& chunk = upload_chunks_[upload_chunk_current_];
+    size_t offset = rex::align(chunk.used, alignment);
+    if (chunk.last_usage == frame_current_ && offset + size <= chunk.buffer->length()) {
+      chunk.used = offset + size;
+      buffer_out = chunk.buffer.get();
+      offset_out = offset;
+      return static_cast<uint8_t*>(chunk.buffer->contents()) + offset;
+    }
+  }
+  // A free chunk (its frame completed), or a new one.
+  CompletedSubmissionUpdated();
+  size_t chosen = SIZE_MAX;
+  for (size_t i = 0; i < upload_chunks_.size(); ++i) {
+    UploadChunk& chunk = upload_chunks_[i];
+    if (chunk.buffer->length() == kUploadChunkSize && chunk.last_usage <= frame_completed_) {
+      chosen = i;
+      break;
+    }
+  }
+  // Drop oversized buffers of completed frames.
+  for (size_t i = 0; i < upload_chunks_.size();) {
+    if (upload_chunks_[i].buffer->length() != kUploadChunkSize &&
+        upload_chunks_[i].last_usage <= frame_completed_) {
+      if (chosen != SIZE_MAX && chosen > i) {
+        --chosen;
+      }
+      ReleaseResident(upload_chunks_[i].buffer.get());
+      upload_chunks_.erase(upload_chunks_.begin() + i);
+    } else {
+      ++i;
+    }
+  }
+  if (chosen == SIZE_MAX) {
+    UploadChunk chunk;
+    chunk.buffer = Ref<MTL::Buffer>(device()->newBuffer(
+        kUploadChunkSize, MTL::ResourceStorageModeShared | MTL::ResourceCPUCacheModeWriteCombined));
+    if (!chunk.buffer) {
+      return nullptr;
+    }
+    chunk.buffer->setLabel(NS::String::string("rex upload", NS::UTF8StringEncoding));
+    MakeResident(chunk.buffer.get());
+    upload_chunks_.push_back(std::move(chunk));
+    chosen = upload_chunks_.size() - 1;
+  }
+  UploadChunk& chunk = upload_chunks_[chosen];
+  chunk.used = size;
+  chunk.last_usage = frame_current_;
+  upload_chunk_current_ = chosen;
+  buffer_out = chunk.buffer.get();
+  offset_out = 0;
+  return chunk.buffer->contents();
+}
+
+bool MetalCommandProcessor::RequestScratchBuffer(uint64_t size, MTL::Buffer*& buffer_out,
+                                                 size_t& offset_out) {
+  BeginSubmissionIfNeeded();
+  const size_t aligned_size = rex::align(size_t(size), size_t(256));
+  if (scratch_chunk_current_ != SIZE_MAX) {
+    UploadChunk& chunk = scratch_chunks_[scratch_chunk_current_];
+    if (chunk.last_usage == submission_current_ && chunk.used + aligned_size <= chunk.buffer->length()) {
+      buffer_out = chunk.buffer.get();
+      offset_out = chunk.used;
+      chunk.used += aligned_size;
+      return true;
+    }
+  }
+  CompletedSubmissionUpdated();
+  size_t chosen = SIZE_MAX;
+  for (size_t i = 0; i < scratch_chunks_.size(); ++i) {
+    UploadChunk& chunk = scratch_chunks_[i];
+    if (chunk.last_usage <= GetCompletedSubmission() && chunk.buffer->length() >= aligned_size) {
+      chosen = i;
+      break;
+    }
+  }
+  if (chosen == SIZE_MAX) {
+    UploadChunk chunk;
+    chunk.buffer = Ref<MTL::Buffer>(device()->newBuffer(std::max(aligned_size, kScratchChunkSize),
+                                                        MTL::ResourceStorageModePrivate));
+    if (!chunk.buffer) {
+      return false;
+    }
+    chunk.buffer->setLabel(NS::String::string("rex scratch", NS::UTF8StringEncoding));
+    MakeResident(chunk.buffer.get());
+    scratch_chunks_.push_back(std::move(chunk));
+    chosen = scratch_chunks_.size() - 1;
+  }
+  UploadChunk& chunk = scratch_chunks_[chosen];
+  chunk.used = aligned_size;
+  chunk.last_usage = submission_current_;
+  scratch_chunk_current_ = chosen;
+  buffer_out = chunk.buffer.get();
+  offset_out = 0;
+  return true;
+}
