@@ -0,0 +1,29 @@
+/**
+ * @file        host_vblank.h
+ * @brief       The host display's refresh as the guest's vblank.
+ *
+ * By default the guest's vblank comes from a timer at the video mode's
+ * refresh rate. A host that can see its display's refreshes (a CADisplayLink
+ * on iOS) signals each one here instead: the guest's frames then line up
+ * with the display's (no frame repeated or dropped every few seconds where
+ * the two clocks drift apart), and the vblank thread sleeps between them.
+ */
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+
+namespace rex {
+
+// The host signals its display's refreshes from now on (SignalHostVblank).
+void SetHostVblankSource(bool enabled);
+bool IsHostVblankSourceEnabled();
+
+// One display refresh. Any thread.
+void SignalHostVblank();
+
+// Waits up to `timeout` for the next display refresh: the number of refreshes
+// since the last call (0 on timeout).
+uint32_t WaitHostVblank(std::chrono::microseconds timeout);
+
+}  // namespace rex
