+
+// Swap.
+
+void MetalCommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                                      uint32_t frontbuffer_height) {
+  (void)frontbuffer_ptr;
+  if (vulkan::RlStatsOn() && ++g_rl_stats.frames == 300) {
+    const vulkan::RlFrameStats& s = g_rl_stats;
+    const double f = double(s.frames);
+    REXGPU_INFO(
+        "[gpustats metal] per frame: submissions {:.1f} encoders {:.1f} draws {:.1f} resolves {:.1f} "
+        "(copies {:.1f}) dumps {:.1f} transfers {:.1f} depth_stores {:.1f} resolve_clears {:.1f} "
+        "tex_loads {:.1f}",
+        s.passes / f, s.barriers / f, s.draws / f, s.resolves / f, s.resolve_copies / f,
+        s.dumps / f, s.transfers / f, s.depth_stores / f, s.resolve_clears / f, s.tex_loads / f);
+    g_rl_stats = {};
+  }
+  vertex_buffers_in_sync_[0] = 0;
+  vertex_buffers_in_sync_[1] = 0;
+
+  ui::Presenter* presenter = graphics_system_ ? graphics_system_->presenter() : nullptr;
+  if (!presenter) {
+    EndFrame();
+    return;
+  }
+  BeginFrameIfNeeded();
+
+  uint32_t source_width, source_height;
+  xenos::TextureFormat frontbuffer_format;
+  MTL::Texture* swap_texture =
+      texture_cache_->RequestSwapTexture(source_width, source_height, frontbuffer_format);
+  if (!swap_texture) {
+    EndFrame();
+    return;
+  }
+  uint32_t guest_output_width =
+      std::min(frontbuffer_width ? frontbuffer_width : source_width, source_width);
+  uint32_t guest_output_height =
+      std::min(frontbuffer_height ? frontbuffer_height : source_height, source_height);
+  if (REXCVAR_GET(present_guest_output_width) > 0) {
+    guest_output_width =
+        std::min(guest_output_width, uint32_t(REXCVAR_GET(present_guest_output_width)));
+  }
+
+  system::X_VIDEO_MODE video_mode;
+  kernel::xboxkrnl::VdQueryVideoMode(&video_mode);
+  uint32_t display_width = std::max(uint32_t(1), uint32_t(video_mode.display_width));
+  uint32_t display_height = std::max(uint32_t(1), uint32_t(video_mode.display_height));
+  if (REXCVAR_GET(present_guest_output_aspect)) {
+    display_width = guest_output_width;
+    display_height = guest_output_height;
+  }
+
+  // As D3D::InitializePresentationParameters sets up: the 256-entry table for 8_8_8_8, PWL for
+  // 2_10_10_10.
+  const bool use_pwl = frontbuffer_format == xenos::TextureFormat::k_2_10_10_10 ||
+                       frontbuffer_format == xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16;
+  presenter->RefreshGuestOutput(
+      guest_output_width, guest_output_height, display_width, display_height,
+      [&](ui::Presenter::GuestOutputRefreshContext& context) -> bool {
+        auto& metal_context =
+            static_cast<ui::metal::MetalPresenter::MetalGuestOutputRefreshContext&>(context);
+        if (metal4_) {
+          // The presenter (its own queue) may still be reading the texture: the swap, in a submission of
+          // its own, waits for the paintings committed so far.
+          EndSubmission();
+          const uint64_t painted = provider().present_value();
+          if (painted) {
+            queue4_->wait(provider().present_event(), painted);
+          }
+          if (guest_output_resident_ != metal_context.texture()) {
+            guest_output_residency_set_->removeAllAllocations();
+            guest_output_residency_set_->addAllocation(metal_context.texture());
+            guest_output_residency_set_->commit();
+            guest_output_resident_ = metal_context.texture();
+          }
+        }
+        MetalComputeEncoder* encoder = BeginCompute("swap");
+        MTL::ComputePipelineState* pipeline =
+            use_pwl ? swap_gamma_pwl_pipeline_.get() : swap_gamma_table_pipeline_.get();
+        encoder->setComputePipelineState(pipeline);
+        encoder->setTexture(swap_texture, 0);
+        encoder->setTexture(metal_context.texture(), 1);
+        if (use_pwl) {
+          encoder->setBytes(gamma_ramp_pwl_rgb(), sizeof(reg::DC_LUT_PWL_DATA) * 128 * 3, 0);
+        } else {
+          encoder->setBytes(gamma_ramp_256_entry_table(), sizeof(reg::DC_LUT_30_COLOR) * 256, 0);
+        }
+        uint32_t size[2] = {guest_output_width, guest_output_height};
+        encoder->setBytes(size, sizeof(size), 1);
+        encoder->dispatchThreadgroups(
+            MTL::Size((guest_output_width + 15) / 16, (guest_output_height + 7) / 8, 1),
+            MTL::Size(16, 8, 1));
+        context.SetIs8bpc(!use_pwl);
+        // Committed before the presenter can paint from it (Metal 3: the same queue, in commit order).
+        const uint64_t swap_submission = submission_current_;
+        EndFrame();
+        if (metal4_) {
+          provider().SetGuestOutputWritten(submission_event_.get(), swap_submission);
+        }
+        return true;
+      });
+  EndFrame();
+}
+
+// Draws.
+
+bool MetalCommandProcessor::IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                                      IndexBufferInfo* index_buffer_info, bool major_mode_explicit) {
+  (void)prim_type;
+  (void)index_count;
+  (void)index_buffer_info;
+  (void)major_mode_explicit;
+  ++g_rl_stats.draws;
+  const RegisterFile& regs = *register_file_;
+
+  xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode == xenos::EdramMode::kCopy) {
+    return IssueCopy();
+  }
+  bool surface_pitch_is_zero = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch == 0;
+
+  memexport_ranges_.clear();
+
+  SpirvShader* vertex_shader = static_cast<SpirvShader*>(active_vertex_shader());
+  if (!vertex_shader) {
+    return false;
+  }
+  pipeline_cache_->AnalyzeShaderUcode(*vertex_shader);
+  bool memexport_used_vertex = vertex_shader->memexport_eM_written() != 0;
+  if (memexport_used_vertex) {
+    draw_util::AddMemExportRanges(regs, *vertex_shader, memexport_ranges_);
+  }
+
+  bool primitive_polygonal = draw_util::IsPrimitivePolygonal(regs);
+  bool is_rasterization_done = draw_util::IsRasterizationPotentiallyDone(regs, primitive_polygonal);
+  if (surface_pitch_is_zero && is_rasterization_done) {
+    return true;
+  }
+  SpirvShader* pixel_shader = nullptr;
+  if (is_rasterization_done) {
+    if (edram_mode == xenos::EdramMode::kColorDepth) {
+      pixel_shader = static_cast<SpirvShader*>(active_pixel_shader());
+      if (pixel_shader) {
+        pipeline_cache_->AnalyzeShaderUcode(*pixel_shader);
+        if (!draw_util::IsPixelShaderNeededWithRasterization(*pixel_shader, regs)) {
+          pixel_shader = nullptr;
+        }
+      }
+    }
+  } else if (!memexport_used_vertex) {
+    return true;
+  }
+  bool memexport_used_pixel = pixel_shader && pixel_shader->memexport_eM_written() != 0;
+  if (memexport_used_pixel) {
+    draw_util::AddMemExportRanges(regs, *pixel_shader, memexport_ranges_);
+  }
+  bool memexport_writes_possible = memexport_used_vertex || memexport_used_pixel;
+  reg::RB_DEPTHCONTROL normalized_depth_control = draw_util::GetNormalizedDepthControl(regs);
+
+  uint32_t ps_param_gen_pos = UINT32_MAX;
+  uint32_t interpolator_mask =
+      pixel_shader ? (vertex_shader->writes_interpolators() &
+                      pixel_shader->GetInterpolatorInputMask(regs.Get<reg::SQ_PROGRAM_CNTL>(),
+                                                             regs.Get<reg::SQ_CONTEXT_MISC>(),
+                                                             ps_param_gen_pos))
+                   : 0;
+
+  BeginFrameIfNeeded();
+
+  PrimitiveProcessor::ProcessingResult primitive_processing_result;
+  if (!primitive_processor_->Process(primitive_processing_result)) {
+    return false;
+  }
+  if (!primitive_processing_result.host_draw_vertex_count) {
+    return true;
+  }
+  Shader::HostVertexShaderType host_vertex_shader_type =
+      primitive_processing_result.host_vertex_shader_type;
+  if (host_vertex_shader_type != Shader::HostVertexShaderType::kVertex &&
+      host_vertex_shader_type != Shader::HostVertexShaderType::kPointListAsTriangleStrip &&
+      host_vertex_shader_type != Shader::HostVertexShaderType::kRectangleListAsTriangleStrip) {
+    // Tessellation isn't on the Metal path yet.
+    return true;
+  }
+
+  SpirvShaderTranslator::Modification vertex_shader_modification =
+      pipeline_cache_->GetCurrentVertexShaderModification(
+          *vertex_shader, host_vertex_shader_type, interpolator_mask,
+          ps_param_gen_pos != UINT32_MAX);
+  SpirvShaderTranslator::Modification pixel_shader_modification =
+      pixel_shader ? pipeline_cache_->GetCurrentPixelShaderModification(
+                         *pixel_shader, interpolator_mask, ps_param_gen_pos,
+                         normalized_depth_control)
+                   : SpirvShaderTranslator::Modification(0);
+  auto* vertex_shader_translation = static_cast<SpirvShader::SpirvTranslation*>(
+      vertex_shader->GetOrCreateTranslation(vertex_shader_modification.value));
+  auto* pixel_shader_translation =
+      pixel_shader ? static_cast<SpirvShader::SpirvTranslation*>(
+                         pixel_shader->GetOrCreateTranslation(pixel_shader_modification.value))
+                   : nullptr;
+  if (!pipeline_cache_->EnsureShadersTranslated(vertex_shader_translation,
+                                                pixel_shader_translation)) {
+    return false;
+  }
+
+  // Samplers (bindings don't depend on the modification).
+  for (uint32_t j = 0; j < 2; ++j) {
+    std::vector<MTL::SamplerState*>& samplers = j ? current_samplers_pixel_ : current_samplers_vertex_;
+    samplers.clear();
+    const SpirvShader* shader = j ? pixel_shader : vertex_shader;
+    if (!shader) {
+      continue;
+    }
+    for (const SpirvShader::SamplerBinding& binding : shader->GetSamplerBindingsAfterTranslation()) {
+      samplers.push_back(texture_cache_->GetSampler(texture_cache_->GetSamplerParameters(binding)));
+    }
+  }
+
+  uint32_t normalized_color_mask =
+      pixel_shader ? draw_util::GetNormalizedColorMask(regs, pixel_shader->writes_color_targets())
+                   : 0;
+
+  // Textures (may dispatch loads), then render targets (may draw transfers).
+  uint32_t used_texture_mask =
+      vertex_shader->GetUsedTextureMaskAfterTranslation() |
+      (pixel_shader ? pixel_shader->GetUsedTextureMaskAfterTranslation() : 0);
+  texture_cache_->RequestTextures(used_texture_mask);
+
+  if (!render_target_cache_->Update(is_rasterization_done, normalized_depth_control,
+                                    normalized_color_mask, *vertex_shader)) {
+    return false;
+  }
+  const MetalRenderTargetCache::RenderPassKey render_pass_key =
+      render_target_cache_->last_update_render_pass_key();
+
+  bool pipeline_pending;
+  MTL::RenderPipelineState* pipeline = pipeline_cache_->ConfigurePipeline(
+      vertex_shader_translation, pixel_shader_translation, primitive_processing_result,
+      normalized_depth_control, normalized_color_mask, render_pass_key, pipeline_pending,
+      // Draws writing memory (the game decodes its videos this way) can't be skipped: their results are
+      // built on frame after frame.
+      !memexport_writes_possible);
+  if (!pipeline) {
+    // Compiling in the background: drawn from the next frames.
+    return pipeline_pending;
+  }
+
+  // Polygon culling: both faces culled draws nothing.
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (primitive_polygonal && pa_su_sc_mode_cntl.cull_front && pa_su_sc_mode_cntl.cull_back &&
+      !memexport_writes_possible) {
+    return true;
+  }
+
+  draw_util::ViewportInfo viewport_info;
+  draw_util::GetHostViewportInfo(
+      regs, 1, 1, false, 16384, 16384, true, normalized_depth_control,
+      render_target_cache_->depth_float24_convert_in_pixel_shader(), true,
+      pixel_shader && pixel_shader->writes_depth(), viewport_info);
+
+  UpdateSystemConstantValues(primitive_polygonal, primitive_processing_result, viewport_info,
+                             used_texture_mask, normalized_depth_control);
+
+  // Vertex buffer and memexport residency (guest memory in place: only page tracking).
+  const Shader::ConstantRegisterMap& constant_map_vertex = vertex_shader->constant_register_map();
+  for (uint32_t i = 0; i < rex::countof(constant_map_vertex.vertex_fetch_bitmap); ++i) {
+    uint32_t vfetch_bits_remaining = constant_map_vertex.vertex_fetch_bitmap[i];
+    uint32_t j;
+    while (rex::bit_scan_forward(vfetch_bits_remaining, &j)) {
+      vfetch_bits_remaining &= ~(uint32_t(1) << j);
+      uint32_t vfetch_index = i * 32 + j;
+      uint64_t vfetch_bit = uint64_t(1) << (vfetch_index & 63);
+      if (vertex_buffers_in_sync_[vfetch_index >> 6] & vfetch_bit) {
+        continue;
+      }
+      xenos::xe_gpu_vertex_fetch_t vfetch_constant = regs.GetVertexFetch(vfetch_index);
+      if (vfetch_constant.type != xenos::FetchConstantType::kVertex &&
+          !(vfetch_constant.type == xenos::FetchConstantType::kInvalidVertex &&
+            REXCVAR_GET(gpu_allow_invalid_fetch_constants))) {
+        return false;
+      }
+      VertexBufferState& state = vertex_buffer_states_[vfetch_index];
+      if (state.address != vfetch_constant.address || state.size != vfetch_constant.size) {
+        if (!shared_memory_->RequestRange(vfetch_constant.address << 2,
+                                          vfetch_constant.size << 2)) {
+          return false;
+        }
+        state.address = vfetch_constant.address;
+        state.size = vfetch_constant.size;
+      }
+      vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+    }
+  }
+  for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+    shared_memory_->RequestRange(memexport_range.base_address_dwords << 2,
+                                 memexport_range.size_bytes);
+  }
+
+  // Into the render pass.
+  // Unclipped screen-space draws usually have D3D9's 8192 scissor, so the area also stops at the bottom
+  // the render target cache estimated from the vertices.
+  draw_util::Scissor draw_scissor;
+  draw_util::GetScissor(regs, draw_scissor);
+  uint32_t required_height =
+      std::min(draw_scissor.offset[1] + draw_scissor.extent[1],
+               render_target_cache_->last_update_height_used());
+  MetalRenderEncoder* encoder =
+      BeginRenderPass(render_target_cache_->last_update_render_pass_targets(), required_height);
+  if (render_state_.pipeline != pipeline) {
+    encoder->setRenderPipelineState(pipeline);
+    render_state_.pipeline = pipeline;
+  }
+  MTL::DepthStencilState* depth_stencil_state = pipeline_cache_->GetDepthStencilState(
+      normalized_depth_control, primitive_polygonal, (render_pass_key.depth_and_color_used & 1) != 0);
+  if (!render_state_.depth_stencil_set || render_state_.depth_stencil != depth_stencil_state) {
+    encoder->setDepthStencilState(depth_stencil_state);
+    render_state_.depth_stencil = depth_stencil_state;
+    render_state_.depth_stencil_set = true;
+  }
+  UpdateDynamicState(encoder, viewport_info, primitive_polygonal, normalized_depth_control);
+  if (!UpdateBindings(encoder, vertex_shader, pixel_shader)) {
+    return false;
+  }
+
+  MTL::PrimitiveType primitive_type;
+  switch (primitive_processing_result.host_primitive_type) {
+    case xenos::PrimitiveType::kPointList:
+      primitive_type = MTL::PrimitiveTypePoint;
+      break;
+    case xenos::PrimitiveType::kLineList:
+      primitive_type = MTL::PrimitiveTypeLine;
+      break;
+    case xenos::PrimitiveType::kLineStrip:
+      primitive_type = MTL::PrimitiveTypeLineStrip;
+      break;
+    case xenos::PrimitiveType::kTriangleList:
+      primitive_type = MTL::PrimitiveTypeTriangle;
+      break;
+    case xenos::PrimitiveType::kTriangleStrip:
+      primitive_type = MTL::PrimitiveTypeTriangleStrip;
+      break;
+    default:
+      return false;
+  }
+  const uint32_t vertex_count = primitive_processing_result.host_draw_vertex_count;
+  static const bool draw_log = std::getenv("RL_DRAW_LOG") != nullptr;
+  if (draw_log) {
+    static std::set<uint64_t> logged;
+    uint64_t key = uint64_t(primitive_processing_result.guest_primitive_type) |
+                   (uint64_t(primitive_processing_result.host_primitive_type) << 8) |
+                   (uint64_t(primitive_processing_result.host_vertex_shader_type) << 16) |
+                   (uint64_t(primitive_processing_result.index_buffer_type) << 24) |
+                   (uint64_t(vertex_shader->ucode_data_hash() & 0xFFFFFF) << 32);
+    if (logged.insert(key).second) {
+      REXGPU_INFO("[draw] guest {} host {} vs_type {} index {} count {} vs {:016X} ps {:016X} rp 0x{:08X}",
+                  uint32_t(primitive_processing_result.guest_primitive_type),
+                  uint32_t(primitive_processing_result.host_primitive_type),
+                  uint32_t(primitive_processing_result.host_vertex_shader_type),
+                  uint32_t(primitive_processing_result.index_buffer_type), vertex_count,
+                  vertex_shader->ucode_data_hash(), pixel_shader ? pixel_shader->ucode_data_hash() : 0,
+                  render_pass_key.key);
+      for (uint32_t stage = 0; stage < 2; ++stage) {
+        const SpirvShader* shader = stage ? pixel_shader : vertex_shader;
+        if (!shader) continue;
+        for (const SpirvShader::TextureBinding& binding : shader->GetTextureBindingsAfterTranslation()) {
+          xenos::xe_gpu_texture_fetch_t fetch = regs.GetTextureFetch(binding.fetch_constant);
+          REXGPU_INFO("[draw]   {} tex {} dim {} signed {}: format {} {}x{} tiled {} pitch {} base {:08X} endian {} swizzle {:03X} host {}",
+                      stage ? "ps" : "vs", binding.fetch_constant, uint32_t(binding.dimension),
+                      uint32_t(binding.is_signed), uint32_t(fetch.format), fetch.size_2d.width + 1,
+                      fetch.size_2d.height + 1, uint32_t(fetch.tiled), uint32_t(fetch.pitch),
+                      uint32_t(fetch.base_address) << 12, uint32_t(fetch.endianness),
+                      uint32_t(fetch.swizzle),
+                      (void*)texture_cache_->GetActiveBindingOrNullTexture(
+                          binding.fetch_constant, binding.dimension, bool(binding.is_signed)));
+        }
+      }
+    }
+  }
+  if (primitive_processing_result.index_buffer_type ==
+      PrimitiveProcessor::ProcessedIndexBufferType::kNone) {
+    encoder->drawPrimitives(primitive_type, NS::UInteger(0), NS::UInteger(vertex_count));
+  } else {
+    const bool index_16 =
+        primitive_processing_result.host_index_format == xenos::IndexFormat::kInt16;
+    const size_t index_size = index_16 ? sizeof(uint16_t) : sizeof(uint32_t);
+    std::pair<MTL::Buffer*, size_t> index_buffer;
+    switch (primitive_processing_result.index_buffer_type) {
+      case PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA: {
+        uint32_t base = primitive_processing_result.guest_index_base;
+        auto segment = shared_memory_->BufferAndOffset(base);
+        const uint32_t segment_size = uint32_t(1) << shared_memory_->segment_size_log2();
+        if ((segment.second & (index_size - 1)) ||
+            segment.second + uint64_t(vertex_count) * index_size > segment_size ||
+            memexport_writes_possible) {
+          // Misaligned, crossing segments, or possibly overwritten by this draw: a snapshot.
+          MTL::Buffer* upload_buffer;
+          size_t upload_offset;
+          void* mapping =
+              RequestUploadSpace(vertex_count * index_size, index_size, upload_buffer, upload_offset);
+          if (!mapping) {
+            return false;
+          }
+          std::memcpy(mapping, memory_->TranslatePhysical(base), vertex_count * index_size);
+          index_buffer = {upload_buffer, upload_offset};
+        } else {
+          index_buffer = {segment.first, segment.second};
+        }
+      } break;
+      case PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted:
+        index_buffer = primitive_processor_->GetConvertedIndexBuffer(
+            primitive_processing_result.host_index_buffer_handle);
+        break;
+      case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForAuto:
+      case PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA:
+        index_buffer = primitive_processor_->GetBuiltinIndexBuffer(
+            primitive_processing_result.host_index_buffer_handle);
+        break;
+      default:
+        return false;
+    }
+    encoder->drawIndexedPrimitives(primitive_type, NS::UInteger(vertex_count),
+                                   index_16 ? MTL::IndexTypeUInt16 : MTL::IndexTypeUInt32,
+                                   index_buffer.first, NS::UInteger(index_buffer.second));
+  }
+
+  // The GPU writes memexported memory: textures from it are outdated.
+  if (!memexport_ranges_.empty()) {
+    for (const draw_util::MemExportRange& memexport_range : memexport_ranges_) {
+      shared_memory_->RangeWrittenByGpu(memexport_range.base_address_dwords << 2,
+                                        memexport_range.size_bytes);
+    }
+  } else if (memexport_writes_possible) {
+    shared_memory_->RangeWrittenByGpu(0, SharedMemory::kBufferSize);
+  }
+  return true;
+}
+
+bool MetalCommandProcessor::IssueCopy() {
+  BeginFrameIfNeeded();
+  uint32_t written_address, written_length;
+  return render_target_cache_->Resolve(*memory_, *shared_memory_, *texture_cache_, written_address,
+                                       written_length);
+}
+
+void MetalCommandProcessor::UpdateDynamicState(MetalRenderEncoder* encoder,
+                                               const draw_util::ViewportInfo& viewport_info,
+                                               bool primitive_polygonal,
+                                               reg::RB_DEPTHCONTROL normalized_depth_control) {
+  const RegisterFile& regs = *register_file_;
+  RenderState& state = render_state_;
+
+  // Viewport and scissor.
+  MTL::Viewport viewport;
+  if (viewport_info.xy_extent[0] && viewport_info.xy_extent[1]) {
+    viewport = MTL::Viewport{double(viewport_info.xy_offset[0]), double(viewport_info.xy_offset[1]),
+                             double(viewport_info.xy_extent[0]), double(viewport_info.xy_extent[1]),
+                             double(viewport_info.z_min), double(viewport_info.z_max)};
+  } else {
+    viewport = MTL::Viewport{-1.0, -1.0, 1.0, 1.0, double(viewport_info.z_min),
+                             double(viewport_info.z_max)};
+  }
+  if (!state.viewport_set || std::memcmp(&state.viewport, &viewport, sizeof(viewport))) {
+    encoder->setViewport(viewport);
+    state.viewport = viewport;
+    state.viewport_set = true;
+  }
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  // Within the render target area (Metal requires the scissor inside it).
+  const MetalRenderPassTargets& targets = render_encoder_targets_;
+  uint32_t x0 = std::min(scissor.offset[0], targets.width);
+  uint32_t y0 = std::min(scissor.offset[1], targets.height);
+  uint32_t x1 = std::min(scissor.offset[0] + scissor.extent[0], targets.width);
+  uint32_t y1 = std::min(scissor.offset[1] + scissor.extent[1], targets.height);
+  MTL::ScissorRect scissor_rect{x0, y0, x1 - x0, y1 - y0};
+  if (!state.scissor_set || std::memcmp(&state.scissor, &scissor_rect, sizeof(scissor_rect))) {
+    encoder->setScissorRect(scissor_rect);
+    state.scissor = scissor_rect;
+    state.scissor_set = true;
+  }
+
+  // Rasterizer state (pipeline state on Vulkan).
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  int cull_mode = MTL::CullModeNone;
+  int winding = MTL::WindingCounterClockwise;
+  int fill_mode = MTL::TriangleFillModeFill;
+  if (primitive_polygonal) {
+    if (pa_su_sc_mode_cntl.cull_front) {
+      cull_mode = MTL::CullModeFront;
+    } else if (pa_su_sc_mode_cntl.cull_back) {
+      cull_mode = MTL::CullModeBack;
+    }
+    winding = pa_su_sc_mode_cntl.face ? MTL::WindingClockwise : MTL::WindingCounterClockwise;
+    xenos::PolygonType polygon_type = xenos::PolygonType::kTriangles;
+    if (pa_su_sc_mode_cntl.poly_mode == xenos::PolygonModeEnable::kDualMode) {
+      if (!pa_su_sc_mode_cntl.cull_front) {
+        polygon_type = std::min(polygon_type, pa_su_sc_mode_cntl.polymode_front_ptype);
+      }
+      if (!pa_su_sc_mode_cntl.cull_back) {
+        polygon_type = std::min(polygon_type, pa_su_sc_mode_cntl.polymode_back_ptype);
+      }
+    }
+    if (polygon_type != xenos::PolygonType::kTriangles) {
+      fill_mode = MTL::TriangleFillModeLines;
+    }
+  }
+  if (state.cull_mode != cull_mode) {
+    encoder->setCullMode(MTL::CullMode(cull_mode));
+    state.cull_mode = cull_mode;
+  }
+  if (state.winding != winding) {
+    encoder->setFrontFacingWinding(MTL::Winding(winding));
+    state.winding = winding;
+  }
+  if (state.fill_mode != fill_mode) {
+    encoder->setTriangleFillMode(MTL::TriangleFillMode(fill_mode));
+    state.fill_mode = fill_mode;
+  }
+  int depth_clip_mode = regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable ? MTL::DepthClipModeClamp
+                                                                      : MTL::DepthClipModeClip;
+  if (state.depth_clip_mode != depth_clip_mode) {
+    encoder->setDepthClipMode(MTL::DepthClipMode(depth_clip_mode));
+    state.depth_clip_mode = depth_clip_mode;
+  }
+
+  // Depth bias.
+  float depth_bias_constant_factor, depth_bias_slope_factor;
+  draw_util::GetPreferredFacePolygonOffset(regs, primitive_polygonal, depth_bias_slope_factor,
+                                           depth_bias_constant_factor);
+  depth_bias_constant_factor *=
+      regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24S8
+          ? draw_util::kD3D10PolygonOffsetFactorUnorm24
+          : draw_util::kD3D10PolygonOffsetFactorFloat24;
+  depth_bias_slope_factor *= xenos::kPolygonOffsetScaleSubpixelUnit;
+  float depth_bias[2] = {depth_bias_constant_factor, depth_bias_slope_factor};
+  if (!state.depth_bias_set || std::memcmp(state.depth_bias, depth_bias, sizeof(depth_bias))) {
+    encoder->setDepthBias(depth_bias_constant_factor, depth_bias_slope_factor, 0.0f);
+    std::memcpy(state.depth_bias, depth_bias, sizeof(depth_bias));
+    state.depth_bias_set = true;
+  }
+
+  // Blend constants.
+  float blend_color[4] = {
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_RED),
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_GREEN),
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_BLUE),
+      regs.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA),
+  };
+  if (!state.blend_color_set || std::memcmp(state.blend_color, blend_color, sizeof(blend_color))) {
+    encoder->setBlendColor(blend_color[0], blend_color[1], blend_color[2], blend_color[3]);
+    std::memcpy(state.blend_color, blend_color, sizeof(blend_color));
+    state.blend_color_set = true;
+  }
+
+  // Stencil references (the masks are in the depth / stencil state).
+  if (normalized_depth_control.stencil_enable) {
+    uint32_t reference_front = regs.Get<reg::RB_STENCILREFMASK>().stencilref;
+    uint32_t reference_back = reference_front;
+    if (primitive_polygonal && normalized_depth_control.backface_enable) {
+      reference_back =
+          regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF).stencilref;
+    }
+    if (!state.stencil_reference_set || state.stencil_reference[0] != reference_front ||
+        state.stencil_reference[1] != reference_back) {
+      encoder->setStencilReferenceValues(reference_front, reference_back);
+      state.stencil_reference[0] = reference_front;
+      state.stencil_reference[1] = reference_back;
+      state.stencil_reference_set = true;
+    }
+  }
+}
+
+void MetalCommandProcessor::UpdateSystemConstantValues(
+    bool primitive_polygonal,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    const draw_util::ViewportInfo& viewport_info, uint32_t used_texture_mask,
+    reg::RB_DEPTHCONTROL normalized_depth_control) {
+  (void)normalized_depth_control;
+  const RegisterFile& regs = *register_file_;
+  auto pa_cl_clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  auto rb_alpha_ref = regs.Get<float>(XE_GPU_REG_RB_ALPHA_REF);
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  auto rb_depth_info = regs.Get<reg::RB_DEPTH_INFO>();
+  auto rb_surface_info = regs.Get<reg::RB_SURFACE_INFO>();
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  auto vgt_indx_offset = regs.Get<int32_t>(XE_GPU_REG_VGT_INDX_OFFSET);
+  auto vgt_max_vtx_indx = regs.Get<uint32_t>(XE_GPU_REG_VGT_MAX_VTX_INDX);
+  auto vgt_min_vtx_indx = regs.Get<uint32_t>(XE_GPU_REG_VGT_MIN_VTX_INDX);
+
+  reg::RB_COLOR_INFO color_infos[xenos::kMaxColorRenderTargets];
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    color_infos[i] = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+  }
+
+  bool dirty = false;
+  SpirvShaderTranslator::SystemConstants& constants = system_constants_;
+
+  uint32_t flags = 0;
+  if (primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kHostBuiltinForDMA ||
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kGuestDMA ||
+      primitive_processing_result.index_buffer_type ==
+          PrimitiveProcessor::ProcessedIndexBufferType::kHostConverted) {
+    flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt32) {
+      flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+    }
+    if (primitive_processing_result.host_primitive_reset_enabled &&
+        primitive_processing_result.host_vertex_shader_type !=
+            Shader::HostVertexShaderType::kPointListAsTriangleStrip &&
+        primitive_processing_result.host_vertex_shader_type !=
+            Shader::HostVertexShaderType::kRectangleListAsTriangleStrip) {
+      flags |= SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset;
+    }
+  }
+  if (pa_cl_vte_cntl.vtx_xy_fmt) {
+    flags |= SpirvShaderTranslator::kSysFlag_XYDividedByW;
+  }
+  if (pa_cl_vte_cntl.vtx_z_fmt) {
+    flags |= SpirvShaderTranslator::kSysFlag_ZDividedByW;
+  }
+  if (pa_cl_vte_cntl.vtx_w0_fmt) {
+    flags |= SpirvShaderTranslator::kSysFlag_WNotReciprocal;
+  }
+  if (primitive_polygonal) {
+    flags |= SpirvShaderTranslator::kSysFlag_PrimitivePolygonal;
+  }
+  if (draw_util::IsPrimitiveLine(regs)) {
+    flags |= SpirvShaderTranslator::kSysFlag_PrimitiveLine;
+  }
+  flags |= uint32_t(rb_surface_info.msaa_samples)
+           << SpirvShaderTranslator::kSysFlag_MsaaSamples_Shift;
+  if (rb_depth_info.depth_format == xenos::DepthRenderTargetFormat::kD24FS8) {
+    flags |= SpirvShaderTranslator::kSysFlag_DepthFloat24;
+  }
+  xenos::CompareFunction alpha_test_function = rb_colorcontrol.alpha_test_enable
+                                                   ? rb_colorcontrol.alpha_func
+                                                   : xenos::CompareFunction::kAlways;
+  flags |= uint32_t(alpha_test_function) << SpirvShaderTranslator::kSysFlag_AlphaPassIfLess_Shift;
+  if (!render_target_cache_->gamma_render_target_as_unorm16()) {
+    for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+      if (color_infos[i].color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA) {
+        flags |= SpirvShaderTranslator::kSysFlag_ConvertColor0ToGamma << i;
+      }
+    }
+  }
+  dirty |= constants.flags != flags;
+  constants.flags = flags;
+
+  if (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad) {
+    dirty |= constants.vertex_index_load_address != primitive_processing_result.guest_index_base;
+    constants.vertex_index_load_address = primitive_processing_result.guest_index_base;
+  }
+  uint32_t vertex_index_reset =
+      (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexReset)
+          ? regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx
+          : 0;
+  dirty |= constants.vertex_index_reset != vertex_index_reset;
+  constants.vertex_index_reset = vertex_index_reset;
+
+  xenos::Endian guest_index_endian = vgt_dma_size.swap_mode;
+  if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16 &&
+      guest_index_endian != xenos::Endian::kNone && guest_index_endian != xenos::Endian::k8in16) {
+    guest_index_endian =
+        guest_index_endian == xenos::Endian::k8in32 ? xenos::Endian::k8in16 : xenos::Endian::kNone;
+  }
+  xenos::Endian index_endian =
+      (flags & SpirvShaderTranslator::kSysFlag_ComputeOrPrimitiveVertexIndexLoad)
+          ? guest_index_endian
+          : primitive_processing_result.host_shader_index_endian;
+  dirty |= constants.vertex_index_endian != index_endian;
+  constants.vertex_index_endian = index_endian;
+
+  dirty |= constants.line_loop_closing_index != primitive_processing_result.line_loop_closing_index;
+  constants.line_loop_closing_index = primitive_processing_result.line_loop_closing_index;
+  dirty |= constants.vertex_base_index != vgt_indx_offset;
+  constants.vertex_base_index = vgt_indx_offset;
+  dirty |= constants.vertex_index_min != vgt_min_vtx_indx;
+  dirty |= constants.vertex_index_max != vgt_max_vtx_indx;
+  constants.vertex_index_min = vgt_min_vtx_indx;
+  constants.vertex_index_max = vgt_max_vtx_indx;
+
+  if (!pa_cl_clip_cntl.clip_disable) {
+    float* user_clip_plane_write_ptr = constants.user_clip_planes[0];
+    uint32_t user_clip_planes_remaining = pa_cl_clip_cntl.ucp_ena;
+    uint32_t user_clip_plane_index;
+    while (rex::bit_scan_forward(user_clip_planes_remaining, &user_clip_plane_index)) {
+      user_clip_planes_remaining &= ~(UINT32_C(1) << user_clip_plane_index);
+      const void* user_clip_plane_regs = &regs[XE_GPU_REG_PA_CL_UCP_0_X + user_clip_plane_index * 4];
+      if (std::memcmp(user_clip_plane_write_ptr, user_clip_plane_regs, 4 * sizeof(float))) {
+        dirty = true;
+        std::memcpy(user_clip_plane_write_ptr, user_clip_plane_regs, 4 * sizeof(float));
+      }
+      user_clip_plane_write_ptr += 4;
+    }
+  }
+
+  for (uint32_t i = 0; i < 3; ++i) {
+    dirty |= constants.ndc_scale[i] != viewport_info.ndc_scale[i];
+    dirty |= constants.ndc_offset[i] != viewport_info.ndc_offset[i];
+    constants.ndc_scale[i] = viewport_info.ndc_scale[i];
+    constants.ndc_offset[i] = viewport_info.ndc_offset[i];
+  }
+
+  if (vgt_draw_initiator.prim_type == xenos::PrimitiveType::kPointList) {
+    auto pa_su_point_minmax = regs.Get<reg::PA_SU_POINT_MINMAX>();
+    auto pa_su_point_size = regs.Get<reg::PA_SU_POINT_SIZE>();
+    float point_vertex_diameter_min = float(pa_su_point_minmax.min_size) * (2.0f / 16.0f);
+    float point_vertex_diameter_max = float(pa_su_point_minmax.max_size) * (2.0f / 16.0f);
+    float point_constant_diameter_x = float(pa_su_point_size.width) * (2.0f / 16.0f);
+    float point_constant_diameter_y = float(pa_su_point_size.height) * (2.0f / 16.0f);
+    dirty |= constants.point_vertex_diameter_min != point_vertex_diameter_min;
+    dirty |= constants.point_vertex_diameter_max != point_vertex_diameter_max;
+    dirty |= constants.point_constant_diameter[0] != point_constant_diameter_x;
+    dirty |= constants.point_constant_diameter[1] != point_constant_diameter_y;
+    constants.point_vertex_diameter_min = point_vertex_diameter_min;
+    constants.point_vertex_diameter_max = point_vertex_diameter_max;
+    constants.point_constant_diameter[0] = point_constant_diameter_x;
+    constants.point_constant_diameter[1] = point_constant_diameter_y;
+    float point_screen_diameter_to_ndc_radius_x =
+        1.0f / float(std::max(viewport_info.xy_extent[0], uint32_t(1)));
+    float point_screen_diameter_to_ndc_radius_y =
+        1.0f / float(std::max(viewport_info.xy_extent[1], uint32_t(1)));
+    dirty |= constants.point_screen_diameter_to_ndc_radius[0] !=
+             point_screen_diameter_to_ndc_radius_x;
+    dirty |= constants.point_screen_diameter_to_ndc_radius[1] !=
+             point_screen_diameter_to_ndc_radius_y;
+    constants.point_screen_diameter_to_ndc_radius[0] = point_screen_diameter_to_ndc_radius_x;
+    constants.point_screen_diameter_to_ndc_radius[1] = point_screen_diameter_to_ndc_radius_y;
+  }
+
+  uint32_t textures_remaining = used_texture_mask;
+  uint32_t texture_index;
+  while (rex::bit_scan_forward(textures_remaining, &texture_index)) {
+    textures_remaining &= ~(UINT32_C(1) << texture_index);
+    uint32_t& texture_signs_uint = constants.texture_swizzled_signs[texture_index >> 2];
+    uint32_t texture_signs_shift = 8 * (texture_index & 3);
+    uint8_t texture_signs = texture_cache_->GetActiveTextureSwizzledSigns(texture_index);
+    uint32_t texture_signs_shifted = uint32_t(texture_signs) << texture_signs_shift;
+    uint32_t texture_signs_mask = ((UINT32_C(1) << 8) - 1) << texture_signs_shift;
+    dirty |= (texture_signs_uint & texture_signs_mask) != texture_signs_shifted;
+    texture_signs_uint = (texture_signs_uint & ~texture_signs_mask) | texture_signs_shifted;
+  }
+
+  dirty |= constants.alpha_test_reference != rb_alpha_ref;
+  constants.alpha_test_reference = rb_alpha_ref;
+  uint32_t alpha_to_mask =
+      rb_colorcontrol.alpha_to_mask_enable ? (rb_colorcontrol.value >> 24) | (UINT32_C(1) << 8) : 0;
+  dirty |= constants.alpha_to_mask != alpha_to_mask;
+  constants.alpha_to_mask = alpha_to_mask;
+
+  for (uint32_t i = 0; i < xenos::kMaxColorRenderTargets; ++i) {
+    reg::RB_COLOR_INFO color_info = color_infos[i];
+    int32_t color_exp_bias = color_info.color_exp_bias;
+    if ((color_info.color_format == xenos::ColorRenderTargetFormat::k_16_16 &&
+         !render_target_cache_->IsFixedRG16TruncatedToMinus1To1()) ||
+        (color_info.color_format == xenos::ColorRenderTargetFormat::k_16_16_16_16 &&
+         !render_target_cache_->IsFixedRGBA16TruncatedToMinus1To1())) {
+      // -32...32 remapped to -1...1 by dividing the output values by 32.
+      color_exp_bias -= 5;
+    }
+    float color_exp_bias_scale;
+    *reinterpret_cast<int32_t*>(&color_exp_bias_scale) =
+        UINT32_C(0x3F800000) + (color_exp_bias << 23);
+    dirty |= constants.color_exp_bias[i] != color_exp_bias_scale;
+    constants.color_exp_bias[i] = color_exp_bias_scale;
+  }
+
+  if (dirty) {
+    current_constant_buffers_up_to_date_ &=
+        ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferSystem);
+  }
+}
+
+void MetalCommandProcessor::BindBuffer(MetalRenderEncoder* encoder, bool fragment,
+                                       uint32_t slot, MTL::Buffer* buffer, size_t offset) {
+  BoundBuffer& bound =
+      fragment ? render_state_.fragment_buffers[slot] : render_state_.vertex_buffers[slot];
+  if (bound.buffer == buffer && bound.offset == offset) {
+    return;
+  }
+  if (bound.buffer == buffer) {
+    if (fragment) {
+      encoder->setFragmentBufferOffset(offset, slot);
+    } else {
+      encoder->setVertexBufferOffset(offset, slot);
+    }
+  } else if (fragment) {
+    encoder->setFragmentBuffer(buffer, offset, slot);
+  } else {
+    encoder->setVertexBuffer(buffer, offset, slot);
+  }
+  bound.buffer = buffer;
+  bound.offset = offset;
+}
+
+bool MetalCommandProcessor::UpdateBindings(MetalRenderEncoder* encoder,
+                                           const SpirvShader* vertex_shader,
+                                           const SpirvShader* pixel_shader) {
+  const RegisterFile& regs = *register_file_;
+
+  // Float constant layouts.
+  const Shader::ConstantRegisterMap& float_constant_map_vertex =
+      vertex_shader->constant_register_map();
+  uint32_t float_constant_count_vertex = float_constant_map_vertex.float_count;
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (current_float_constant_map_vertex_[i] != float_constant_map_vertex.float_bitmap[i]) {
+      current_float_constant_map_vertex_[i] = float_constant_map_vertex.float_bitmap[i];
+      current_constant_buffers_up_to_date_ &=
+          ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatVertex);
+    }
+  }
+  uint32_t float_constant_count_pixel = 0;
+  if (pixel_shader) {
+    const Shader::ConstantRegisterMap& float_constant_map_pixel =
+        pixel_shader->constant_register_map();
+    float_constant_count_pixel = float_constant_map_pixel.float_count;
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (current_float_constant_map_pixel_[i] != float_constant_map_pixel.float_bitmap[i]) {
+        current_float_constant_map_pixel_[i] = float_constant_map_pixel.float_bitmap[i];
+        current_constant_buffers_up_to_date_ &=
+            ~(UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFloatPixel);
+      }
+    }
+  }
+
+  // Write the outdated constant buffers to the upload ring.
+  auto upload = [&](uint32_t index, const void* data, size_t size) -> uint8_t* {
+    MTL::Buffer* buffer;
+    size_t offset;
+    uint8_t* mapping = static_cast<uint8_t*>(RequestUploadSpace(std::max(size, size_t(16)), 256, buffer, offset));
+    if (!mapping) {
+      return nullptr;
+    }
+    if (data) {
+      std::memcpy(mapping, data, size);
+    }
+    current_constant_buffers_[index] = {buffer, offset};
+    current_constant_buffers_up_to_date_ |= UINT32_C(1) << index;
+    return mapping;
+  };
+  if (!(current_constant_buffers_up_to_date_ &
+        (UINT32_C(1) << SpirvShaderTranslator::kConstantBufferSystem))) {
+    if (!upload(SpirvShaderTranslator::kConstantBufferSystem, &system_constants_,
+                sizeof(system_constants_))) {
+      return false;
+    }
+  }
+  for (uint32_t stage = 0; stage < 2; ++stage) {
+    uint32_t index = stage ? SpirvShaderTranslator::kConstantBufferFloatPixel
+                           : SpirvShaderTranslator::kConstantBufferFloatVertex;
+    if (current_constant_buffers_up_to_date_ & (UINT32_C(1) << index)) {
+      continue;
+    }
+    uint32_t count = stage ? float_constant_count_pixel : float_constant_count_vertex;
+    uint8_t* mapping = upload(index, nullptr, sizeof(float) * 4 * std::max(count, UINT32_C(1)));
+    if (!mapping) {
+      return false;
+    }
+    const uint64_t* map = stage ? current_float_constant_map_pixel_ : current_float_constant_map_vertex_;
+    uint32_t register_base =
+        stage ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X;
+    for (uint32_t i = 0; i < 4; ++i) {
+      uint64_t entry = map[i];
+      uint32_t float_constant_index;
+      while (rex::bit_scan_forward(entry, &float_constant_index)) {
+        entry &= ~(1ull << float_constant_index);
+        std::memcpy(mapping, &regs[register_base + (i << 8) + (float_constant_index << 2)],
+                    sizeof(float) * 4);
+        mapping += sizeof(float) * 4;
+      }
+    }
+  }
+  if (!(current_constant_buffers_up_to_date_ &
+        (UINT32_C(1) << SpirvShaderTranslator::kConstantBufferBoolLoop))) {
+    if (!upload(SpirvShaderTranslator::kConstantBufferBoolLoop,
+                &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], sizeof(uint32_t) * (8 + 32))) {
+      return false;
+    }
+  }
+  if (!(current_constant_buffers_up_to_date_ &
+        (UINT32_C(1) << SpirvShaderTranslator::kConstantBufferFetch))) {
+    if (!upload(SpirvShaderTranslator::kConstantBufferFetch,
+                &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], sizeof(uint32_t) * 6 * 32)) {
+      return false;
+    }
+  }
+
+  // Bind for both stages: shared memory, EDRAM, constants.
+  for (uint32_t stage = 0; stage < 2; ++stage) {
+    bool fragment = stage != 0;
+    if (fragment && !pixel_shader) {
+      // The float24 depth shader reads only the system constants.
+      BindBuffer(encoder, true,
+                 MetalPipelineCache::kConstantBufferSlotFirst +
+                     SpirvShaderTranslator::kConstantBufferSystem,
+                 current_constant_buffers_[SpirvShaderTranslator::kConstantBufferSystem].buffer,
+                 current_constant_buffers_[SpirvShaderTranslator::kConstantBufferSystem].offset);
+      continue;
+    }
+    for (uint32_t i = 0; i < shared_memory_->buffer_count(); ++i) {
+      BindBuffer(encoder, fragment, MetalPipelineCache::kSharedMemoryBufferSlot + i,
+                 shared_memory_->buffer(i), 0);
+    }
+    for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+      BindBuffer(encoder, fragment, MetalPipelineCache::kConstantBufferSlotFirst + i,
+                 current_constant_buffers_[i].buffer, current_constant_buffers_[i].offset);
+    }
+  }
+
+  // Textures and samplers.
+  for (uint32_t stage = 0; stage < 2; ++stage) {
+    const SpirvShader* shader = stage ? pixel_shader : vertex_shader;
+    if (!shader) {
+      continue;
+    }
+    MTL::Texture** bound_textures =
+        stage ? render_state_.fragment_textures : render_state_.vertex_textures;
+    MTL::SamplerState** bound_samplers =
+        stage ? render_state_.fragment_samplers : render_state_.vertex_samplers;
+    const std::vector<SpirvShader::TextureBinding>& textures =
+        shader->GetTextureBindingsAfterTranslation();
+    for (size_t i = 0; i < textures.size() && i < 32; ++i) {
+      const SpirvShader::TextureBinding& binding = textures[i];
+      MTL::Texture* texture = texture_cache_->GetActiveBindingOrNullTexture(
+          binding.fetch_constant, binding.dimension, bool(binding.is_signed));
+      if (bound_textures[i] != texture) {
+        if (stage) {
+          encoder->setFragmentTexture(texture, i);
+        } else {
+          encoder->setVertexTexture(texture, i);
+        }
+        bound_textures[i] = texture;
+      }
+    }
+    const std::vector<MTL::SamplerState*>& samplers =
+        stage ? current_samplers_pixel_ : current_samplers_vertex_;
+    for (size_t i = 0; i < samplers.size() && i < 16; ++i) {
+      if (bound_samplers[i] != samplers[i]) {
+        if (stage) {
+          encoder->setFragmentSamplerState(samplers[i], i);
+        } else {
+          encoder->setVertexSamplerState(samplers[i], i);
+        }
+        bound_samplers[i] = samplers[i];
+      }
+    }
+  }
+  return true;
+}
