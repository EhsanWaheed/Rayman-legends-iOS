+void VulkanCommandProcessor::ExtendRenderPassArea(const VkRect2D& rect) {
+  if (!render_pass_area_tracked_ || !rect.extent.width || !rect.extent.height) {
+    return;
+  }
+  render_pass_area_right_ =
+      std::max(render_pass_area_right_, uint32_t(std::max(rect.offset.x, int32_t(0))) + rect.extent.width);
+  render_pass_area_bottom_ = std::max(
+      render_pass_area_bottom_, uint32_t(std::max(rect.offset.y, int32_t(0))) + rect.extent.height);
+}
+
+void VulkanCommandProcessor::FinishRenderPassArea() {
+  if (!render_pass_area_tracked_) {
+    return;
+  }
+  render_pass_area_tracked_ = false;
+  // From the origin (Metal sizes the render targets of a pass by the area's far
+  // corner) to the farthest draw, within the framebuffer; a pass without draws
+  // needs only a pixel.
+  VkRect2D& area = deferred_command_buffer_.BeginRenderingArea(render_pass_area_position_);
+  area.offset.x = 0;
+  area.offset.y = 0;
+  area.extent.width =
+      std::max(uint32_t(1), std::min(render_pass_area_right_, render_pass_full_extent_.width));
+  area.extent.height =
+      std::max(uint32_t(1), std::min(render_pass_area_bottom_, render_pass_full_extent_.height));
+}
