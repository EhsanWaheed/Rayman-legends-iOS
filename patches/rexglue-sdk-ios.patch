diff --git a/src/ui/vulkan/metalfx_upscaler.mm b/src/ui/vulkan/metalfx_upscaler.mm
new file mode 100644
index 0000000..cfcda83
--- /dev/null
+++ b/src/ui/vulkan/metalfx_upscaler.mm
@@ -0,0 +1,162 @@
+/**
+ * @file        ui/vulkan/metalfx_upscaler.mm
+ * @brief       MetalFX spatial upscaling of Vulkan images on Apple GPUs (MoltenVK)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/ui/vulkan/metalfx_upscaler.h>
+
+#include <TargetConditionals.h>
+
+#import <Metal/Metal.h>
+#if !TARGET_OS_SIMULATOR
+#import <MetalFX/MetalFX.h>
+#define REX_HAVE_METALFX 1
+#endif
+
+#include <vulkan/vulkan_metal.h>
+
+#include <rex/logging.h>
+#include <rex/ui/presenter.h>
+#include <rex/ui/vulkan/device.h>
+
+namespace rex::ui {
+
+bool IsMetalFxUpscalingSupported() {
+#if REX_HAVE_METALFX
+  static const bool supported = [] {
+    @autoreleasepool {
+      id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+      return device != nil && [MTLFXSpatialScalerDescriptor supportsDevice:device];
+    }
+  }();
+  return supported;
+#else
+  return false;
+#endif
+}
+
+}  // namespace rex::ui
+
+namespace rex::ui::vulkan {
+
+struct MetalFxUpscaler::State {
+  VkDevice device = VK_NULL_HANDLE;
+  PFN_vkExportMetalObjectsEXT export_metal_objects = nullptr;
+#if REX_HAVE_METALFX
+  id<MTLFXSpatialScaler> scaler = nil;
+  uint32_t scaler_key[6] = {};  // source and destination sizes, formats
+#endif
+};
+
+std::unique_ptr<MetalFxUpscaler> MetalFxUpscaler::Create(const VulkanDevice* vulkan_device) {
+#if REX_HAVE_METALFX
+  if (!vulkan_device->extensions().ext_EXT_metal_objects || !IsMetalFxUpscalingSupported()) {
+    return nullptr;
+  }
+  auto export_metal_objects = reinterpret_cast<PFN_vkExportMetalObjectsEXT>(
+      vulkan_device->vulkan_instance()->functions().vkGetDeviceProcAddr(vulkan_device->device(),
+                                                                         "vkExportMetalObjectsEXT"));
+  if (!export_metal_objects) {
+    return nullptr;
+  }
+  std::unique_ptr<MetalFxUpscaler> upscaler(new MetalFxUpscaler());
+  upscaler->state_ = std::make_unique<State>();
+  upscaler->state_->device = vulkan_device->device();
+  upscaler->state_->export_metal_objects = export_metal_objects;
+  REXLOG_INFO("MetalFX: spatial upscaling available");
+  return upscaler;
+#else
+  (void)vulkan_device;
+  return nullptr;
+#endif
+}
+
+MetalFxUpscaler::~MetalFxUpscaler() = default;
+
+bool MetalFxUpscaler::Upscale(VkQueue queue, VkImage source, uint32_t source_width,
+                              uint32_t source_height, VkImage destination,
+                              uint32_t destination_width, uint32_t destination_height) {
+#if REX_HAVE_METALFX
+  @autoreleasepool {
+    State& s = *state_;
+    // The Metal objects behind the Vulkan ones.
+    VkExportMetalCommandQueueInfoEXT queue_info = {};
+    queue_info.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_COMMAND_QUEUE_INFO_EXT;
+    queue_info.queue = queue;
+    VkExportMetalTextureInfoEXT source_info = {};
+    source_info.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT;
+    source_info.image = source;
+    source_info.plane = VK_IMAGE_ASPECT_PLANE_0_BIT;
+    source_info.pNext = &queue_info;
+    VkExportMetalTextureInfoEXT destination_info = {};
+    destination_info.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_TEXTURE_INFO_EXT;
+    destination_info.image = destination;
+    destination_info.plane = VK_IMAGE_ASPECT_PLANE_0_BIT;
+    destination_info.pNext = &source_info;
+    VkExportMetalObjectsInfoEXT objects_info = {};
+    objects_info.sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT;
+    objects_info.pNext = &destination_info;
+    s.export_metal_objects(s.device, &objects_info);
+    id<MTLCommandQueue> mtl_queue = queue_info.mtlCommandQueue;
+    id<MTLTexture> mtl_source = source_info.mtlTexture;
+    id<MTLTexture> mtl_destination = destination_info.mtlTexture;
+    if (!mtl_queue || !mtl_source || !mtl_destination) {
+      static bool logged = false;
+      if (!logged) {
+        logged = true;
+        REXLOG_ERROR("MetalFX: could not get the Metal queue or textures");
+      }
+      return false;
+    }
+
+    // The scaler, made again when the sizes or formats change.
+    const uint32_t key[6] = {source_width,      source_height,
+                             destination_width, destination_height,
+                             uint32_t(mtl_source.pixelFormat), uint32_t(mtl_destination.pixelFormat)};
+    if (!s.scaler || memcmp(key, s.scaler_key, sizeof(key))) {
+      MTLFXSpatialScalerDescriptor* descriptor = [MTLFXSpatialScalerDescriptor new];
+      descriptor.inputWidth = source_width;
+      descriptor.inputHeight = source_height;
+      descriptor.outputWidth = destination_width;
+      descriptor.outputHeight = destination_height;
+      descriptor.colorTextureFormat = mtl_source.pixelFormat;
+      descriptor.outputTextureFormat = mtl_destination.pixelFormat;
+      // The game's picture is display-referred (gamma encoded).
+      descriptor.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+      s.scaler = [descriptor newSpatialScalerWithDevice:mtl_queue.device];
+      if (!s.scaler) {
+        REXLOG_ERROR("MetalFX: could not create a {}x{} -> {}x{} spatial scaler", source_width,
+                     source_height, destination_width, destination_height);
+        return false;
+      }
+      memcpy(s.scaler_key, key, sizeof(key));
+      REXLOG_INFO("MetalFX: spatial {}x{} -> {}x{}", source_width, source_height,
+                  destination_width, destination_height);
+    }
+
+    id<MTLCommandBuffer> command_buffer = [mtl_queue commandBuffer];
+    command_buffer.label = @"MetalFX spatial upscale";
+    s.scaler.colorTexture = mtl_source;
+    s.scaler.outputTexture = mtl_destination;
+    s.scaler.inputContentWidth = source_width;
+    s.scaler.inputContentHeight = source_height;
+    [s.scaler encodeToCommandBuffer:command_buffer];
+    [command_buffer commit];
+    return true;
+  }
+#else
+  (void)queue;
+  (void)source;
+  (void)source_width;
+  (void)source_height;
+  (void)destination;
+  (void)destination_width;
+  (void)destination_height;
+  return false;
+#endif
+}
+
+}  // namespace rex::ui::vulkan
