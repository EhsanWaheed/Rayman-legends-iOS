+    bool packed_only_depth = false;
+    if (source_is_color) {
+      switch (source_color_format) {
+        case xenos::ColorRenderTargetFormat::k_8_8_8_8:
+        case xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA: {
+          if (mode.output == TransferOutput::kStencilBit) {
