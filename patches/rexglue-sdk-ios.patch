+/**
+ * @file        graphics/metal/msl.cpp
+ * @brief       SPIR-V to Metal Shading Language and Metal functions (msl.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <TargetConditionals.h>
+
+#include <cstdio>
+#include <algorithm>
+#include <cstdlib>
+
+#include <spirv_msl.hpp>
+
+#include <rex/graphics/metal/msl.h>
+
+namespace rex::graphics::metal {
+
+namespace {
+// Entry point names must be MSL identifiers.
+std::string ToIdentifier(const std::string& name) {
+  std::string result = name;
+  for (char& c : result) {
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) {
+      c = '_';
+    }
+  }
+  if (result.empty() || (result[0] >= '0' && result[0] <= '9')) {
+    result = "rex_" + result;
+  }
+  return result;
+}
+}  // namespace
+
+std::string SpirvToMsl(const uint32_t* spirv, size_t spirv_word_count, MslStage stage,
+                       const std::vector<MslBinding>& bindings, const MslOptions& options,
+                       const std::string& entry_point_name, std::string* error_out,
+                       uint32_t* compute_local_size_out) {
+  try {
+    // NoContraction (the translator's exact Xenos multiply-add order) becomes an [[clang::optnone]] function
+    // call per operation in this SPIRV-Cross: several times the GPU time of every guest shader. Dropped, as
+    // fast math is used anyway.
+    std::vector<uint32_t> stripped;
+    stripped.reserve(spirv_word_count);
+    stripped.insert(stripped.end(), spirv, spirv + std::min<size_t>(5, spirv_word_count));
+    for (size_t i = 5; i < spirv_word_count;) {
+      const uint32_t word_count = spirv[i] >> 16;
+      const uint32_t opcode = spirv[i] & 0xFFFF;
+      if (!word_count || i + word_count > spirv_word_count) {
+        stripped.insert(stripped.end(), spirv + i, spirv + spirv_word_count);
+        break;
+      }
+      const bool no_contraction =
+          (opcode == uint32_t(spv::OpDecorate) && word_count >= 3 &&
+           spirv[i + 2] == uint32_t(spv::DecorationNoContraction)) ||
+          (opcode == uint32_t(spv::OpMemberDecorate) && word_count >= 4 &&
+           spirv[i + 3] == uint32_t(spv::DecorationNoContraction));
+      if (!no_contraction) {
+        stripped.insert(stripped.end(), spirv + i, spirv + i + word_count);
+      }
+      i += word_count;
+    }
+    SPIRV_CROSS_NAMESPACE::CompilerMSL compiler(std::move(stripped));
+    SPIRV_CROSS_NAMESPACE::CompilerMSL::Options msl_options;
+#if TARGET_OS_IOS
+    msl_options.platform = SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::iOS;
+#else
+    msl_options.platform = SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::macOS;
+#endif
+    // Metal 3 (iOS 16 / macOS 13): every device the port supports.
+    msl_options.set_msl_version(3, 0);
+    msl_options.enable_point_size_builtin = options.point_size;
+    msl_options.enable_frag_output_mask = options.fragment_output_mask;
+    msl_options.enable_frag_depth_builtin = options.fragment_depth_output;
+    msl_options.enable_frag_stencil_ref_builtin = options.fragment_stencil_output;
+    msl_options.argument_buffers = false;
+    msl_options.pad_fragment_output_components = true;
+    msl_options.ios_use_simdgroup_functions = true;
+    compiler.set_msl_options(msl_options);
+    if (stage == MslStage::kVertex && options.flip_vertex_y) {
+      SPIRV_CROSS_NAMESPACE::CompilerGLSL::Options common_options = compiler.get_common_options();
+      common_options.vertex.flip_vert_y = true;
+      compiler.set_common_options(common_options);
+    }
+
+    spv::ExecutionModel model = stage == MslStage::kVertex     ? spv::ExecutionModelVertex
+                                : stage == MslStage::kFragment ? spv::ExecutionModelFragment
+                                                               : spv::ExecutionModelGLCompute;
+    for (const MslBinding& b : bindings) {
+      SPIRV_CROSS_NAMESPACE::MSLResourceBinding binding;
+      binding.stage = model;
+      if (b.set == MslBinding::kPushConstants) {
+        binding.desc_set = SPIRV_CROSS_NAMESPACE::kPushConstDescSet;
+        binding.binding = SPIRV_CROSS_NAMESPACE::kPushConstBinding;
+      } else {
+        binding.desc_set = b.set;
+        binding.binding = b.binding;
+      }
+      binding.msl_buffer = b.buffer;
+      binding.msl_texture = b.texture;
+      binding.msl_sampler = b.sampler;
+      compiler.add_msl_resource_binding(binding);
+    }
+    if (options.auto_slots) {
+      const SPIRV_CROSS_NAMESPACE::ShaderResources resources = compiler.get_shader_resources();
+      auto map = [&](const SPIRV_CROSS_NAMESPACE::SmallVector<SPIRV_CROSS_NAMESPACE::Resource>& list) {
+        for (const SPIRV_CROSS_NAMESPACE::Resource& resource : list) {
+          const uint32_t set = compiler.get_decoration(resource.id, spv::DecorationDescriptorSet);
+          const uint32_t bind = compiler.get_decoration(resource.id, spv::DecorationBinding);
+          SPIRV_CROSS_NAMESPACE::MSLResourceBinding binding;
+          binding.stage = model;
+          binding.desc_set = set;
+          binding.binding = bind;
+          binding.msl_buffer = binding.msl_texture = binding.msl_sampler = set * kMslSlotsPerSet + bind;
+          compiler.add_msl_resource_binding(binding);
+        }
+      };
+      map(resources.uniform_buffers);
+      map(resources.storage_buffers);
+      map(resources.storage_images);
+      map(resources.sampled_images);
+      map(resources.separate_images);
+      map(resources.separate_samplers);
+      if (!resources.push_constant_buffers.empty()) {
+        SPIRV_CROSS_NAMESPACE::MSLResourceBinding binding;
+        binding.stage = model;
+        binding.desc_set = SPIRV_CROSS_NAMESPACE::kPushConstDescSet;
+        binding.binding = SPIRV_CROSS_NAMESPACE::kPushConstBinding;
+        binding.msl_buffer = kMslPushConstantsBufferSlot;
+        compiler.add_msl_resource_binding(binding);
+      }
+    }
+    // One entry point per module; renamed so each has a distinct name in its library.
+    for (const SPIRV_CROSS_NAMESPACE::EntryPoint& entry : compiler.get_entry_points_and_stages()) {
+      compiler.rename_entry_point(entry.name, ToIdentifier(entry_point_name), entry.execution_model);
+    }
+    std::string msl = compiler.compile();
+    if (compute_local_size_out) {
+      // Metal takes the threadgroup size at dispatch.
+      for (uint32_t i = 0; i < 3; ++i) {
+        uint32_t size = compiler.get_execution_mode_argument(spv::ExecutionModeLocalSize, i);
+        compute_local_size_out[i] = size ? size : 1;
+      }
+    }
+    return msl;
+  } catch (const std::exception& e) {
+    if (error_out) {
+      *error_out = e.what();
+    }
+    return {};
+  }
+}
+
+MTL::Function* CompileMsl(MTL::Device* device, const std::string& source,
+                          const std::string& entry_point_name, std::string* error_out) {
+  // RL_DUMP_MSL=<folder>: every shader's MSL, for inspection.
+  if (const char* dump_folder = std::getenv("RL_DUMP_MSL")) {
+    std::string path = std::string(dump_folder) + "/" + ToIdentifier(entry_point_name) + ".metal";
+    if (FILE* file = std::fopen(path.c_str(), "w")) {
+      std::fwrite(source.data(), 1, source.size(), file);
+      std::fclose(file);
+    }
+  }
+  NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+  MTL::CompileOptions* compile_options = MTL::CompileOptions::alloc()->init();
+  // Fast math, as MoltenVK compiles the same SPIR-V (no float controls required by the translator's
+  // output); the translator handles the Xenos' special cases (0 * inf etc.) explicitly.
+  compile_options->setMathMode(MTL::MathModeFast);
+  compile_options->setLanguageVersion(MTL::LanguageVersion3_0);
+  NS::Error* error = nullptr;
+  MTL::Library* library = device->newLibrary(
+      NS::String::string(source.c_str(), NS::UTF8StringEncoding), compile_options, &error);
+  compile_options->release();
+  MTL::Function* function = nullptr;
+  if (library) {
+    function = library->newFunction(
+        NS::String::string(ToIdentifier(entry_point_name).c_str(), NS::UTF8StringEncoding));
+    library->release();
+    if (!function && error_out) {
+      *error_out = "entry point " + entry_point_name + " not found";
+    }
+  } else if (error_out) {
+    *error_out = error ? error->localizedDescription()->utf8String() : "unknown error";
+  }
+  pool->release();
+  return function;
+}
+
+}  // namespace rex::graphics::metal
