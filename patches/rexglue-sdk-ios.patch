+MTL::BlendFactor ToMetalBlendFactor(uint32_t factor) {
+  static const MTL::BlendFactor kMap[] = {
+      MTL::BlendFactorZero,
+      MTL::BlendFactorOne,
+      MTL::BlendFactorSourceColor,
+      MTL::BlendFactorOneMinusSourceColor,
+      MTL::BlendFactorDestinationColor,
+      MTL::BlendFactorOneMinusDestinationColor,
+      MTL::BlendFactorSourceAlpha,
+      MTL::BlendFactorOneMinusSourceAlpha,
+      MTL::BlendFactorDestinationAlpha,
+      MTL::BlendFactorOneMinusDestinationAlpha,
+      MTL::BlendFactorBlendColor,
+      MTL::BlendFactorOneMinusBlendColor,
+      MTL::BlendFactorBlendAlpha,
+      MTL::BlendFactorOneMinusBlendAlpha,
+      MTL::BlendFactorSourceAlphaSaturated,
+  };
+  return factor < rex::countof(kMap) ? kMap[factor] : MTL::BlendFactorZero;
+}
+
+MTL::BlendOperation ToMetalBlendOp(xenos::BlendOp op) {
+  switch (op) {
+    case xenos::BlendOp::kAdd:
+      return MTL::BlendOperationAdd;
+    case xenos::BlendOp::kSubtract:
+      return MTL::BlendOperationSubtract;
+    case xenos::BlendOp::kMin:
+      return MTL::BlendOperationMin;
+    case xenos::BlendOp::kMax:
+      return MTL::BlendOperationMax;
+    case xenos::BlendOp::kRevSubtract:
+      return MTL::BlendOperationReverseSubtract;
+    default:
+      return MTL::BlendOperationAdd;
+  }
+}
+
+MTL::CompareFunction ToMetalCompare(xenos::CompareFunction function) {
+  // Same order as Vulkan / D3D: never, less, equal, less equal, greater, not equal, greater equal, always.
+  static const MTL::CompareFunction kMap[] = {
+      MTL::CompareFunctionNever,        MTL::CompareFunctionLess,
+      MTL::CompareFunctionEqual,        MTL::CompareFunctionLessEqual,
+      MTL::CompareFunctionGreater,      MTL::CompareFunctionNotEqual,
+      MTL::CompareFunctionGreaterEqual, MTL::CompareFunctionAlways,
+  };
+  return kMap[uint32_t(function) & 7];
+}
+
+MTL::StencilOperation ToMetalStencilOp(xenos::StencilOp op) {
+  static const MTL::StencilOperation kMap[] = {
+      MTL::StencilOperationKeep,           MTL::StencilOperationZero,
+      MTL::StencilOperationReplace,        MTL::StencilOperationIncrementClamp,
+      MTL::StencilOperationDecrementClamp, MTL::StencilOperationInvert,
+      MTL::StencilOperationIncrementWrap,  MTL::StencilOperationDecrementWrap,
+  };
+  return kMap[uint32_t(op) & 7];
+}
