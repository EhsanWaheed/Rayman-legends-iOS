diff --git a/include/rex/graphics/metal/command_processor.h b/include/rex/graphics/metal/command_processor.h
new file mode 100644
index 0000000..dd2bb02
--- /dev/null
+++ b/include/rex/graphics/metal/command_processor.h
@@ -0,0 +1,272 @@
+/**
+ * @file        graphics/metal/command_processor.h
+ * @brief       The Xenos command processor on Metal
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/metal/encoders.h>
+#include <rex/graphics/metal/graphics_system.h>
+#include <rex/graphics/metal/pipeline_cache.h>
+#include <rex/graphics/metal/primitive_processor.h>
+#include <rex/graphics/metal/render_target_cache.h>
+#include <rex/graphics/metal/shared_memory.h>
+#include <rex/graphics/metal/texture_cache.h>
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/system/kernel_state.h>
+#include <rex/ui/metal/provider.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor : public CommandProcessor {
+ public:
+  MetalCommandProcessor(MetalGraphicsSystem* graphics_system, system::KernelState* kernel_state);
+  ~MetalCommandProcessor() override;
+
+  void ClearCaches() override;
+  void InvalidateGpuMemory() override;
+
+  ui::metal::MetalProvider& provider() const {
+    return *static_cast<ui::metal::MetalProvider*>(graphics_system_->provider());
+  }
+  MTL::Device* device() const { return provider().device(); }
+  MTL::CommandQueue* queue() const { return provider().queue(); }
+  // Whether commands go through Metal 4 (MTL4CommandQueue, argument tables, residency sets, explicit
+  // barriers) instead of Metal 3.
+  bool metal4() const { return metal4_; }
+
+  // Submissions (one per guest frame, and wherever the CPU has to wait for the GPU) are numbered from 1;
+  // GetCompletedSubmission() is the last one the GPU has finished.
+  uint64_t GetCurrentSubmission() const { return submission_current_; }
+  uint64_t GetCompletedSubmission() const {
+    return metal4_ ? submission_event_->signaledValue()
+                   : submission_completed_.load(std::memory_order_acquire);
+  }
+  // Commits the current submission (if anything was recorded).
+  void EndSubmission();
+  // Waits for the GPU to finish everything committed so far.
+  void AwaitAllSubmissions();
+
+  // Encoders. Starting one kind ends the current encoder of another kind (or a render pass with other
+  // attachments). Each waits for everything before it on the GPU (Metal 3 tracks the hazards, on Metal 4
+  // every encoder starts with a barrier). On Metal 4, blits are in the compute encoder.
+  // The pass covers the targets' rows down to required_height at least (tile-based GPUs load and store only
+  // the render target area): a pass with the same attachments is continued if it's tall enough.
+  MetalRenderEncoder* BeginRenderPass(const MetalRenderPassTargets& targets,
+                                             uint32_t required_height = UINT32_MAX,
+                                             const char* label = "guest");
+  // With RL_GPU_LABELS set, encoders are split and labelled by purpose (for GPU traces).
+  MetalComputeEncoder* BeginCompute(const char* label = "compute");
+  // The height of the current render pass's area.
+  uint32_t render_pass_height() const { return render_encoder_targets_.height; }
+  MetalBlitEncoder* BeginBlit();
+  void EndEncoding();
+  // Code outside the draw path changed the current render encoder's state.
+  void InvalidateRenderState();
+
+  // Per-vertex data for utility draws (transfers, clears), small via setVertexBytes, else the upload ring.
+  void SetVertexData(MetalRenderEncoder* encoder, const void* data, size_t size, uint32_t slot);
+  // CPU-written memory valid until the GPU finishes the current frame. Null if failed.
+  void* RequestUploadSpace(size_t size, size_t alignment, MTL::Buffer*& buffer_out,
+                           size_t& offset_out);
+  // GPU-only memory valid within the current submission.
+  bool RequestScratchBuffer(uint64_t size, MTL::Buffer*& buffer_out, size_t& offset_out);
+
+  // Resource lifetimes. Metal 4 uses only resources in the residency set, and its command buffers don't
+  // keep what they use alive: buffers and textures are made resident when created, and released (out of
+  // the residency set) only once the GPU is done with the submissions so far. No-ops on Metal 3, where
+  // command buffers retain their resources.
+  void MakeResident(MTL::Allocation* allocation);
+  void ReleaseResident(MTL::Allocation* allocation);
+  // Objects that aren't resources of their own (texture views): released after the GPU is done.
+  void ReleaseAfterUse(NS::Object* object);
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+
+  void WriteRegister(uint32_t index, uint32_t value) override;
+  void WriteRegistersFromMem(uint32_t start_index, uint32_t* base, uint32_t num_registers) override;
+
+  void IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                 uint32_t frontbuffer_height) override;
+
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                     const uint32_t* host_address, uint32_t dword_count) override;
+
+  bool IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                 IndexBufferInfo* index_buffer_info, bool major_mode_explicit) override;
+  bool IssueCopy() override;
+
+ private:
+  struct UploadChunk {
+    ui::metal::Ref<MTL::Buffer> buffer;
+    size_t used = 0;
+    // The frame (upload) or submission (scratch) that last used it.
+    uint64_t last_usage = 0;
+  };
+  static constexpr size_t kUploadChunkSize = 4 * 1024 * 1024;
+  static constexpr size_t kScratchChunkSize = 16 * 1024 * 1024;
+
+  struct BoundBuffer {
+    MTL::Buffer* buffer = nullptr;
+    size_t offset = 0;
+  };
+
+  // The state of the current render encoder, to skip redundant calls.
+  struct RenderState {
+    MTL::RenderPipelineState* pipeline = nullptr;
+    MTL::DepthStencilState* depth_stencil = nullptr;
+    bool depth_stencil_set = false;
+    MTL::Viewport viewport{};
+    bool viewport_set = false;
+    MTL::ScissorRect scissor{};
+    bool scissor_set = false;
+    int cull_mode = -1;
+    int winding = -1;
+    int fill_mode = -1;
+    int depth_clip_mode = -1;
+    float depth_bias[2] = {};
+    bool depth_bias_set = false;
+    uint32_t stencil_reference[2] = {};
+    bool stencil_reference_set = false;
+    float blend_color[4] = {};
+    bool blend_color_set = false;
+    BoundBuffer vertex_buffers[10];
+    BoundBuffer fragment_buffers[10];
+    MTL::Texture* vertex_textures[32] = {};
+    MTL::Texture* fragment_textures[32] = {};
+    MTL::SamplerState* vertex_samplers[16] = {};
+    MTL::SamplerState* fragment_samplers[16] = {};
+  };
+
+  struct VertexBufferState {
+    uint32_t address = UINT32_MAX;
+    uint32_t size = UINT32_MAX;
+  };
+
+  bool InitializeMetal4();
+  void BeginSubmissionIfNeeded();
+  void CompletedSubmissionUpdated();
+  void AwaitSubmission(uint64_t submission);
+  void BeginFrameIfNeeded();
+  void EndFrame();
+
+  void InvalidateAllVertexBufferResidency();
+  void InvalidateVertexBufferResidencyRange(uint32_t first_vfetch, uint32_t last_vfetch);
+
+  void UpdateDynamicState(MetalRenderEncoder* encoder,
+                          const draw_util::ViewportInfo& viewport_info, bool primitive_polygonal,
+                          reg::RB_DEPTHCONTROL normalized_depth_control);
+  void UpdateSystemConstantValues(
+      bool primitive_polygonal,
+      const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+      const draw_util::ViewportInfo& viewport_info, uint32_t used_texture_mask,
+      reg::RB_DEPTHCONTROL normalized_depth_control);
+  bool UpdateBindings(MetalRenderEncoder* encoder, const SpirvShader* vertex_shader,
+                      const SpirvShader* pixel_shader);
+  void BindBuffer(MetalRenderEncoder* encoder, bool fragment, uint32_t slot,
+                  MTL::Buffer* buffer, size_t offset);
+
+  bool InitializeSwapPipelines();
+
+  std::unique_ptr<MetalSharedMemory> shared_memory_;
+  std::unique_ptr<MetalPrimitiveProcessor> primitive_processor_;
+  std::unique_ptr<MetalRenderTargetCache> render_target_cache_;
+  std::unique_ptr<MetalTextureCache> texture_cache_;
+  std::unique_ptr<MetalPipelineCache> pipeline_cache_;
+
+  // Submissions.
+  bool submission_open_ = false;
+  // Metal 3: the command buffer, completion from its handler.
+  ui::metal::Ref<MTL::CommandBuffer> command_buffer_;
+  uint64_t submission_current_ = 1;
+  std::atomic<uint64_t> submission_completed_{0};
+  uint64_t submission_completed_processed_ = 0;
+  // Metal 4: one command buffer object reused for every submission, its commands in an allocator per
+  // submission in flight; the queue signals the event with each submission's number when it completes.
+  bool metal4_ = false;
+  ui::metal::Ref<MTL4::CommandQueue> queue4_;
+  ui::metal::Ref<MTL4::CommandBuffer> command_buffer4_;
+  struct Allocator4 {
+    ui::metal::Ref<MTL4::CommandAllocator> allocator;
+    uint64_t last_submission = 0;
+  };
+  std::vector<Allocator4> allocators4_;
+  ui::metal::Ref<MTL::SharedEvent> submission_event_;
+  ui::metal::Ref<MTL4::ArgumentTable> argument_tables4_[3];  // vertex, fragment, compute
+  // Everything the GPU may use: buffers and textures from creation until ReleaseResident.
+  ui::metal::Ref<MTL::ResidencySet> residency_set_;
+  bool residency_set_dirty_ = false;
+  // The presenter's guest output texture the swap writes, in a set of its own (the presenter owns it).
+  ui::metal::Ref<MTL::ResidencySet> guest_output_residency_set_;
+  MTL::Texture* guest_output_resident_ = nullptr;
+  struct DeferredRelease {
+    uint64_t submission;
+    NS::Object* object;
+    bool resident;
+  };
+  std::deque<DeferredRelease> deferred_releases_;
+
+  // Frames: the upload ring is reclaimed per frame (the primitive processor reuses converted indices
+  // within a frame).
+  uint64_t frame_current_ = 1;
+  bool frame_open_ = false;
+  // The last submission of each frame in flight.
+  std::deque<std::pair<uint64_t, uint64_t>> frame_submissions_;
+  uint64_t frame_completed_ = 0;
+
+  // Encoders.
+  MetalRenderEncoder render_encoder_{*this};
+  MetalComputeEncoder compute_encoder_{*this};
+  MetalBlitEncoder blit_encoder_;
+  const char* compute_encoder_label_ = nullptr;
+  bool encoder_labels_ = false;
+  MetalRenderPassTargets render_encoder_targets_;
+  // The height last used for a set of attachments: passes of a frame usually look like the previous one's,
+  // so a pass starts as tall as last time instead of growing (each growth is a store and a reload).
+  std::unordered_map<uint64_t, uint32_t> render_pass_heights_;
+  uint64_t render_encoder_heights_key_ = 0;
+  uint32_t render_encoder_required_height_ = 0;
+  RenderState render_state_;
+
+  // Memory.
+  std::vector<UploadChunk> upload_chunks_;
+  size_t upload_chunk_current_ = SIZE_MAX;
+  std::vector<UploadChunk> scratch_chunks_;
+  size_t scratch_chunk_current_ = SIZE_MAX;
+
+  // Constants.
+  SpirvShaderTranslator::SystemConstants system_constants_;
+  uint32_t current_constant_buffers_up_to_date_ = 0;
+  uint64_t current_float_constant_map_vertex_[4] = {};
+  uint64_t current_float_constant_map_pixel_[4] = {};
+  BoundBuffer current_constant_buffers_[SpirvShaderTranslator::kConstantBufferCount];
+
+  std::array<VertexBufferState, 96> vertex_buffer_states_;
+  uint64_t vertex_buffers_in_sync_[2] = {};
+
+  std::vector<draw_util::MemExportRange> memexport_ranges_;
+  std::vector<MTL::SamplerState*> current_samplers_vertex_;
+  std::vector<MTL::SamplerState*> current_samplers_pixel_;
+
+  // Presentation: the guest's gamma ramps applied to the front buffer.
+  ui::metal::Ref<MTL::ComputePipelineState> swap_gamma_table_pipeline_;
+  ui::metal::Ref<MTL::ComputePipelineState> swap_gamma_pwl_pipeline_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/include/rex/graphics/metal/encoders.h b/include/rex/graphics/metal/encoders.h
new file mode 100644
index 0000000..3683829
--- /dev/null
+++ b/include/rex/graphics/metal/encoders.h
@@ -0,0 +1,153 @@
+/**
+ * @file        graphics/metal/encoders.h
+ * @brief       Command encoders over Metal 3 or Metal 4, with the Metal 3 calls the backend uses
+ *
+ * On Metal 4 (MTL4CommandQueue), resources are bound through argument tables by GPU address and resource
+ * ID, small constants (setBytes) go to the upload ring, blits are encoded in compute encoders, and nothing
+ * orders commands by itself: every encoder starts with a barrier after all earlier work in the queue, and
+ * the commands of a compute encoder run one after another (barriers between them), as on Metal 3.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+
+// Binding slots the argument tables cover (msl.h: buffers up to the rectangle vertex buffer at 30).
+constexpr uint32_t kMetalMaxBufferBindings = 31;
+constexpr uint32_t kMetalMaxTextureBindings = 32;
+constexpr uint32_t kMetalMaxSamplerBindings = 16;
+
+class MetalRenderEncoder {
+ public:
+  explicit MetalRenderEncoder(MetalCommandProcessor& command_processor)
+      : command_processor_(command_processor) {}
+
+  void Begin(MTL::RenderCommandEncoder* encoder);
+  void Begin(MTL4::RenderCommandEncoder* encoder, MTL4::ArgumentTable* vertex_table,
+             MTL4::ArgumentTable* fragment_table);
+  void End();
+  bool is_open() const { return m3_ || m4_; }
+  void setLabel(const char* label);
+
+  void setRenderPipelineState(MTL::RenderPipelineState* pipeline);
+  void setDepthStencilState(MTL::DepthStencilState* state);
+  void setStencilReferenceValue(uint32_t value);
+  void setStencilReferenceValues(uint32_t front, uint32_t back);
+  void setCullMode(MTL::CullMode mode);
+  void setFrontFacingWinding(MTL::Winding winding);
+  void setTriangleFillMode(MTL::TriangleFillMode mode);
+  void setDepthBias(float bias, float slope_scale, float clamp);
+  void setDepthClipMode(MTL::DepthClipMode mode);
+  void setViewport(MTL::Viewport viewport);
+  void setScissorRect(MTL::ScissorRect rect);
+  void setBlendColor(float red, float green, float blue, float alpha);
+
+  void setVertexBuffer(MTL::Buffer* buffer, size_t offset, uint32_t slot) {
+    SetBuffer(0, buffer, offset, slot);
+  }
+  void setFragmentBuffer(MTL::Buffer* buffer, size_t offset, uint32_t slot) {
+    SetBuffer(1, buffer, offset, slot);
+  }
+  void setVertexBufferOffset(size_t offset, uint32_t slot) { SetBufferOffset(0, offset, slot); }
+  void setFragmentBufferOffset(size_t offset, uint32_t slot) { SetBufferOffset(1, offset, slot); }
+  void setVertexBytes(const void* data, size_t size, uint32_t slot) { SetBytes(0, data, size, slot); }
+  void setFragmentBytes(const void* data, size_t size, uint32_t slot) {
+    SetBytes(1, data, size, slot);
+  }
+  void setVertexTexture(MTL::Texture* texture, uint32_t slot) { SetTexture(0, texture, slot); }
+  void setFragmentTexture(MTL::Texture* texture, uint32_t slot) { SetTexture(1, texture, slot); }
+  void setVertexSamplerState(MTL::SamplerState* sampler, uint32_t slot) {
+    SetSampler(0, sampler, slot);
+  }
+  void setFragmentSamplerState(MTL::SamplerState* sampler, uint32_t slot) {
+    SetSampler(1, sampler, slot);
+  }
+
+  void drawPrimitives(MTL::PrimitiveType type, NS::UInteger vertex_start, NS::UInteger vertex_count);
+  void drawIndexedPrimitives(MTL::PrimitiveType type, NS::UInteger index_count,
+                             MTL::IndexType index_type, MTL::Buffer* index_buffer,
+                             NS::UInteger index_buffer_offset);
+
+ private:
+  void SetBuffer(uint32_t stage, MTL::Buffer* buffer, size_t offset, uint32_t slot);
+  void SetBufferOffset(uint32_t stage, size_t offset, uint32_t slot);
+  void SetBytes(uint32_t stage, const void* data, size_t size, uint32_t slot);
+  void SetTexture(uint32_t stage, MTL::Texture* texture, uint32_t slot);
+  void SetSampler(uint32_t stage, MTL::SamplerState* sampler, uint32_t slot);
+
+  MetalCommandProcessor& command_processor_;
+  MTL::RenderCommandEncoder* m3_ = nullptr;
+  MTL4::RenderCommandEncoder* m4_ = nullptr;
+  MTL4::ArgumentTable* tables_[2] = {};
+  // Metal 4: the buffers in the tables, for offset changes.
+  MTL::Buffer* buffers_[2][kMetalMaxBufferBindings] = {};
+};
+
+// Compute dispatches, and on Metal 4 blits too (MTL4ComputeCommandEncoder does both).
+class MetalComputeEncoder {
+ public:
+  explicit MetalComputeEncoder(MetalCommandProcessor& command_processor)
+      : command_processor_(command_processor) {}
+
+  void Begin(MTL::ComputeCommandEncoder* encoder);
+  void Begin(MTL4::ComputeCommandEncoder* encoder, MTL4::ArgumentTable* table);
+  void End();
+  bool is_open() const { return m3_ || m4_; }
+  void setLabel(const char* label);
+
+  void setComputePipelineState(MTL::ComputePipelineState* pipeline);
+  void setBuffer(MTL::Buffer* buffer, size_t offset, uint32_t slot);
+  void setBytes(const void* data, size_t size, uint32_t slot);
+  void setTexture(MTL::Texture* texture, uint32_t slot);
+  void dispatchThreadgroups(MTL::Size threadgroups, MTL::Size threads_per_threadgroup);
+
+  // Metal 4 only (Metal 3 blits are in MetalBlitEncoder).
+  void copyFromBuffer(MTL::Buffer* source, NS::UInteger source_offset, NS::UInteger bytes_per_row,
+                      NS::UInteger bytes_per_image, MTL::Size size, MTL::Texture* destination,
+                      NS::UInteger slice, NS::UInteger level, MTL::Origin origin);
+
+ private:
+  // Metal 4: waits for the previous command of this encoder (they would run concurrently otherwise).
+  void Serialize();
+
+  MetalCommandProcessor& command_processor_;
+  MTL::ComputeCommandEncoder* m3_ = nullptr;
+  MTL4::ComputeCommandEncoder* m4_ = nullptr;
+  MTL4::ArgumentTable* table_ = nullptr;
+  bool m4_commands_ = false;
+};
+
+// Blits: a Metal 3 blit encoder, or on Metal 4 the compute encoder.
+class MetalBlitEncoder {
+ public:
+  void Begin(MTL::BlitCommandEncoder* encoder) {
+    m3_ = encoder;
+    compute_ = nullptr;
+  }
+  void Begin(MetalComputeEncoder* encoder) {
+    m3_ = nullptr;
+    compute_ = encoder;
+  }
+  void End();
+  bool is_open() const { return m3_ != nullptr; }
+
+  void copyFromBuffer(MTL::Buffer* source, NS::UInteger source_offset, NS::UInteger bytes_per_row,
+                      NS::UInteger bytes_per_image, MTL::Size size, MTL::Texture* destination,
+                      NS::UInteger slice, NS::UInteger level, MTL::Origin origin);
+
+ private:
+  MTL::BlitCommandEncoder* m3_ = nullptr;
+  MetalComputeEncoder* compute_ = nullptr;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/include/rex/graphics/metal/graphics_system.h b/include/rex/graphics/metal/graphics_system.h
