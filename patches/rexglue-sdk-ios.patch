+  std::atomic<MTL::SharedEvent*> guest_output_event_{nullptr};
+  std::atomic<uint64_t> guest_output_value_{0};
+  Ref<MTL::SharedEvent> present_event_;
+  std::mutex present_mutex_;
+  uint64_t present_value_ = 0;
+  std::atomic<uint64_t> present_value_committed_{0};
+};
+
+}  // namespace rex::ui::metal
