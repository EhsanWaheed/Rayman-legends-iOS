+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui::vulkan {
+
+class VulkanDevice;
+
+// Upscales one Vulkan image into another with MTLFXSpatialScaler, on the Metal
+// command queue behind a Vulkan queue (VK_EXT_metal_objects). The work is
+// committed at once: Metal runs it after everything already submitted to that
+// queue and before what is submitted to it later, so the source must have been
+// submitted already and the destination is read by later submissions.
+class MetalFxUpscaler {
+ public:
+  static std::unique_ptr<MetalFxUpscaler> Create(const VulkanDevice* vulkan_device);
+  ~MetalFxUpscaler();
+
+  bool Upscale(VkQueue queue, VkImage source, uint32_t source_width, uint32_t source_height,
+               VkImage destination, uint32_t destination_width, uint32_t destination_height);
+
+ private:
+  MetalFxUpscaler() = default;
+  struct State;
+  std::unique_ptr<State> state_;
+};
+
+}  // namespace rex::ui::vulkan
