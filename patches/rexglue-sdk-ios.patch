+          }
+        }
+        builder.createStore(builder.createCompositeConstruct(type_fragment_data, id_vector_temp),
+                            output_fragment_data);
+      } else {
+        id_vector_temp.clear();
+        for (uint32_t i = 0; i < 4; ++i) {
