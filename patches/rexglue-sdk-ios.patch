+/**
+ * @file        graphics/metal/pipeline_cache.cpp
+ * @brief       Guest shaders as Metal functions, and render pipeline states (pipeline_cache.h)
+ *
+ * Shader modifications and the blend description follow the Vulkan pipeline cache (Xenia, BSD).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <algorithm>
+#include <string>
+
+#include <fmt/format.h>
+#include <xxhash.h>
+
+#include <rex/assert.h>
+#include <rex/cvar.h>
+#include <rex/graphics/flags.h>
+#include <rex/graphics/metal/command_processor.h>
+#include <rex/graphics/metal/msl.h>
+#include <rex/graphics/metal/pipeline_cache.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/logging.h>
+#include <rex/math.h>
+#include <rex/thread.h>
+
+namespace rex::graphics::metal {
+
+using ui::metal::Ref;
+
+MetalPipelineCache::MetalPipelineCache(MetalCommandProcessor& command_processor,
+                                       const RegisterFile& register_file,
+                                       MetalRenderTargetCache& render_target_cache)
+    : command_processor_(command_processor),
+      register_file_(register_file),
+      render_target_cache_(render_target_cache) {}
+
+MetalPipelineCache::~MetalPipelineCache() {
+  Shutdown();
+}
+
+bool MetalPipelineCache::Initialize(uint32_t shared_memory_buffer_count_log2) {
+  shared_memory_buffer_count_ = uint32_t(1) << shared_memory_buffer_count_log2;
+
+  // What Apple GPUs do, in the translator's terms.
+  SpirvShaderTranslator::Features features(false);
+  features.spirv_version = spv::Spv_1_5;
+  features.max_storage_buffer_range = SharedMemory::kBufferSize >> shared_memory_buffer_count_log2;
+  features.full_draw_index_uint32 = true;
+  features.vertex_pipeline_stores_and_atomics = true;
+  features.fragment_stores_and_atomics = true;
+  features.clip_distance = true;
+  features.cull_distance = false;
+  features.image_view_format_swizzle = true;
+  features.sample_rate_shading = true;
+  shader_translator_ = std::make_unique<SpirvShaderTranslator>(
+      features, render_target_cache_.msaa_2x_attachments_supported(),
+      render_target_cache_.msaa_2x_no_attachments_supported(), false);
+
+  depth_float24_spirv_[0] = shader_translator_->CreateDepthOnlyFragmentShader(
+      SpirvShaderTranslator::Modification::DepthStencilMode::kFloat24Truncating);
+  depth_float24_spirv_[1] = shader_translator_->CreateDepthOnlyFragmentShader(
+      SpirvShaderTranslator::Modification::DepthStencilMode::kFloat24Rounding);
+
+  uint32_t logical_processor_count = rex::thread::logical_processor_count();
+  if (!logical_processor_count) {
+    logical_processor_count = 4;
+  }
+  // Leave the guest CPU and GPU threads their cores.
+  size_t thread_count = std::max(uint32_t(1), logical_processor_count / 2);
+  creation_threads_shutdown_ = false;
+  for (size_t i = 0; i < thread_count; ++i) {
+    creation_threads_.emplace_back([this]() { CreationThread(); });
+  }
+  return true;
+}
+
+void MetalPipelineCache::Shutdown() {
+  {
+    std::lock_guard<std::mutex> lock(creation_mutex_);
+    creation_threads_shutdown_ = true;
+    creation_queue_.clear();
+  }
+  creation_cond_.notify_all();
+  for (std::thread& thread : creation_threads_) {
+    if (thread.joinable()) {
+      thread.join();
+    }
+  }
+  creation_threads_.clear();
+  last_pipeline_description_ = nullptr;
+  last_pipeline_ = nullptr;
+  pipelines_.clear();
+  depth_stencil_states_.clear();
+  functions_.clear();
+  for (auto& function : depth_float24_functions_) {
+    function.reset();
+  }
+  shaders_.clear();
+  shader_translator_.reset();
+}
+
+SpirvShader* MetalPipelineCache::LoadShader(xenos::ShaderType shader_type,
+                                            const uint32_t* host_address, uint32_t dword_count) {
+  uint64_t data_hash = XXH3_64bits(host_address, dword_count * sizeof(uint32_t));
+  auto it = shaders_.find(data_hash);
+  if (it != shaders_.end()) {
+    return it->second.get();
+  }
+  // Kept even if translation fails, not to try again.
+  auto shader = std::make_unique<SpirvShader>(shader_type, data_hash, host_address, dword_count);
+  SpirvShader* result = shader.get();
+  shaders_.emplace(data_hash, std::move(shader));
+  return result;
+}
+
+SpirvShaderTranslator::Modification MetalPipelineCache::GetCurrentVertexShaderModification(
+    const Shader& shader, Shader::HostVertexShaderType host_vertex_shader_type,
+    uint32_t interpolator_mask, bool ps_param_gen_used) const {
+  assert_true(shader.type() == xenos::ShaderType::kVertex);
+  assert_true(shader.is_ucode_analyzed());
+  const auto& regs = register_file_;
+
+  SpirvShaderTranslator::Modification modification(
+      shader_translator_->GetDefaultVertexShaderModification(
+          shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().vs_num_reg),
+          host_vertex_shader_type));
+
+  modification.vertex.interpolator_mask = interpolator_mask;
+  modification.vertex.tessellation_mode = 0;
+
+  // Clip distances, no cull distances on Metal.
+  auto pa_cl_clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  uint32_t user_clip_planes = pa_cl_clip_cntl.clip_disable ? 0 : pa_cl_clip_cntl.ucp_ena;
+  modification.vertex.user_clip_plane_cull = 0;
+  modification.vertex.user_clip_plane_count = rex::bit_count(user_clip_planes);
+  modification.vertex.point_ps_ucp_mode = pa_cl_clip_cntl.ps_ucp_mode;
+
+  if (host_vertex_shader_type == Shader::HostVertexShaderType::kPointListAsTriangleStrip) {
+    modification.vertex.output_point_parameters = uint32_t(ps_param_gen_used);
+  } else {
+    modification.vertex.output_point_parameters =
+        uint32_t((shader.writes_point_size_edge_flag_kill_vertex() & 0b001) &&
+                 regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList);
+  }
+  modification.vertex.vertex_kill_and = 0;
+  return modification;
+}
+
+SpirvShaderTranslator::Modification MetalPipelineCache::GetCurrentPixelShaderModification(
+    const Shader& shader, uint32_t interpolator_mask, uint32_t param_gen_pos,
+    reg::RB_DEPTHCONTROL normalized_depth_control) const {
+  assert_true(shader.type() == xenos::ShaderType::kPixel);
+  assert_true(shader.is_ucode_analyzed());
+  const auto& regs = register_file_;
+
+  SpirvShaderTranslator::Modification modification(
+      shader_translator_->GetDefaultPixelShaderModification(
+          shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().ps_num_reg)));
+
+  modification.pixel.interpolator_mask = interpolator_mask;
+  modification.pixel.interpolators_centroid =
+      interpolator_mask & ~xenos::GetInterpolatorSamplingPattern(
+                              regs.Get<reg::RB_SURFACE_INFO>().msaa_samples,
+                              regs.Get<reg::SQ_CONTEXT_MISC>().sc_sample_cntl,
+                              regs.Get<reg::SQ_INTERPOLATOR_CNTL>().sampling_pattern);
+
+  if (param_gen_pos < xenos::kMaxInterpolators) {
+    modification.pixel.param_gen_enable = 1;
+    modification.pixel.param_gen_interpolator = param_gen_pos;
+    modification.pixel.param_gen_point =
+        uint32_t(regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList);
+  } else {
+    modification.pixel.param_gen_enable = 0;
+    modification.pixel.param_gen_interpolator = 0;
+    modification.pixel.param_gen_point = 0;
+  }
+
+  using DepthStencilMode = SpirvShaderTranslator::Modification::DepthStencilMode;
+  if (render_target_cache_.depth_float24_convert_in_pixel_shader() &&
+      normalized_depth_control.z_enable &&
+      regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8) {
+    modification.pixel.depth_stencil_mode = render_target_cache_.depth_float24_round()
+                                                ? DepthStencilMode::kFloat24Rounding
+                                                : DepthStencilMode::kFloat24Truncating;
+  } else if (shader.implicit_early_z_write_allowed() &&
+             (!shader.writes_color_target(0) ||
+              !draw_util::DoesCoverageDependOnAlpha(regs.Get<reg::RB_COLORCONTROL>()))) {
+    modification.pixel.depth_stencil_mode = DepthStencilMode::kEarlyHint;
+  } else {
+    modification.pixel.depth_stencil_mode = DepthStencilMode::kNoModifiers;
+  }
+  return modification;
+}
+
+bool MetalPipelineCache::EnsureShadersTranslated(SpirvShader::SpirvTranslation* vertex_shader,
+                                                 SpirvShader::SpirvTranslation* pixel_shader) {
+  if (!vertex_shader->is_translated()) {
+    vertex_shader->shader().AnalyzeUcode(ucode_disasm_buffer_);
+    if (!TranslateAnalyzedShader(*vertex_shader)) {
+      REXGPU_ERROR("MetalPipelineCache: failed to translate the vertex shader");
+      return false;
+    }
+  }
+  if (!vertex_shader->is_valid()) {
+    return false;
+  }
+  if (pixel_shader) {
+    if (!pixel_shader->is_translated()) {
+      pixel_shader->shader().AnalyzeUcode(ucode_disasm_buffer_);
+      if (!TranslateAnalyzedShader(*pixel_shader)) {
+        REXGPU_ERROR("MetalPipelineCache: failed to translate the pixel shader");
+        return false;
+      }
+    }
+    if (!pixel_shader->is_valid()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool MetalPipelineCache::TranslateAnalyzedShader(SpirvShader::SpirvTranslation& translation) {
+  if (!shader_translator_->TranslateAnalyzedShader(translation)) {
+    REXGPU_ERROR("MetalPipelineCache: shader {:016X} translation failed; ignoring it",
+                 translation.shader().ucode_data_hash());
+    return false;
+  }
+  return translation.is_valid();
+}
+
+std::vector<MslBinding> MetalPipelineCache::GetShaderBindings(const SpirvShader& shader,
+                                                              bool is_vertex) const {
+  std::vector<MslBinding> bindings;
+  // Shared memory (an array of segments if split) and the EDRAM.
+  MslBinding binding = {};
+  binding.set = SpirvShaderTranslator::kDescriptorSetSharedMemoryAndEdram;
+  binding.binding = 0;
+  binding.buffer = kSharedMemoryBufferSlot;
+  bindings.push_back(binding);
+  binding.binding = 1;
+  binding.buffer = kEdramBufferSlot;
+  bindings.push_back(binding);
+  // Constants.
+  for (uint32_t i = 0; i < SpirvShaderTranslator::kConstantBufferCount; ++i) {
+    binding.set = SpirvShaderTranslator::kDescriptorSetConstants;
+    binding.binding = i;
+    binding.buffer = kConstantBufferSlotFirst + i;
+    bindings.push_back(binding);
+  }
+  // Textures, then samplers, in the binding order.
+  const uint32_t texture_count = uint32_t(shader.GetTextureBindingsAfterTranslation().size());
+  const uint32_t sampler_count = uint32_t(shader.GetSamplerBindingsAfterTranslation().size());
+  binding.set = is_vertex ? SpirvShaderTranslator::kDescriptorSetTexturesVertex
+                          : SpirvShaderTranslator::kDescriptorSetTexturesPixel;
+  binding.buffer = 0;
+  for (uint32_t i = 0; i < texture_count; ++i) {
+    binding.binding = i;
+    binding.texture = i;
+    binding.sampler = 0;
+    bindings.push_back(binding);
+  }
+  for (uint32_t i = 0; i < sampler_count; ++i) {
+    binding.binding = texture_count + i;
+    binding.texture = 0;
+    binding.sampler = i;
+    bindings.push_back(binding);
+  }
+  return bindings;
+}
+
+MTL::Function* MetalPipelineCache::GetFunction(const SpirvShader::SpirvTranslation& translation,
+                                               uint32_t color_output_mask, bool depth_output) {
+  const bool is_vertex = translation.shader().type() == xenos::ShaderType::kVertex;
+  FunctionKey key;
+  key.translation = &translation;
+  key.outputs = is_vertex ? 0 : (color_output_mask | (uint32_t(depth_output) << 4));
+  {
+    std::lock_guard<std::mutex> lock(functions_mutex_);
+    auto it = functions_.find(key);
+    if (it != functions_.end()) {
+      return it->second.get();
+    }
+  }
+  const SpirvShader& shader = static_cast<const SpirvShader&>(translation.shader());
+  MslOptions options;
+  options.fragment_output_mask = color_output_mask;
+  options.fragment_depth_output = depth_output;
+  options.fragment_stencil_output = false;
+  std::string name = fmt::format("rex_{}_{:016x}_{:016x}", is_vertex ? "vs" : "ps",
+                                 shader.ucode_data_hash(), translation.modification());
+  std::string error;
+  const std::vector<uint8_t>& spirv = translation.translated_binary();
+  std::string msl = SpirvToMsl(reinterpret_cast<const uint32_t*>(spirv.data()),
+                               spirv.size() / sizeof(uint32_t),
+                               is_vertex ? MslStage::kVertex : MslStage::kFragment,
+                               GetShaderBindings(shader, is_vertex), options, name, &error);
+  Ref<MTL::Function> function;
+  if (!msl.empty()) {
+    function = Ref<MTL::Function>(CompileMsl(command_processor_.device(), msl, name, &error));
+  }
+  if (!function) {
+    REXGPU_ERROR("MetalPipelineCache: {}: {}", name, error);
+  }
+  std::lock_guard<std::mutex> lock(functions_mutex_);
+  auto it = functions_.emplace(key, std::move(function)).first;
+  return it->second.get();
+}
+
+MTL::Function* MetalPipelineCache::GetDepthFloat24Function(bool round) {
+  std::lock_guard<std::mutex> lock(functions_mutex_);
+  Ref<MTL::Function>& function = depth_float24_functions_[round ? 1 : 0];
+  if (!function) {
+    const std::vector<uint8_t>& spirv = depth_float24_spirv_[round ? 1 : 0];
+    std::string name = round ? "rex_depth_float24_round_ps" : "rex_depth_float24_truncate_ps";
+    std::string error;
+    MslOptions options;
+    options.fragment_stencil_output = false;
+    std::vector<MslBinding> bindings;
+    MslBinding binding = {};
+    binding.set = SpirvShaderTranslator::kDescriptorSetConstants;
+    binding.binding = SpirvShaderTranslator::kConstantBufferSystem;
+    binding.buffer = kConstantBufferSlotFirst + SpirvShaderTranslator::kConstantBufferSystem;
+    bindings.push_back(binding);
+    std::string msl = SpirvToMsl(reinterpret_cast<const uint32_t*>(spirv.data()),
+                                 spirv.size() / sizeof(uint32_t), MslStage::kFragment, bindings,
+                                 options, name, &error);
+    if (!msl.empty()) {
+      function = Ref<MTL::Function>(CompileMsl(command_processor_.device(), msl, name, &error));
+    }
+    if (!function) {
+      REXGPU_ERROR("MetalPipelineCache: {}: {}", name, error);
+    }
+  }
+  return function.get();
+}
+
+void MetalPipelineCache::WritePipelineRenderTargetDescription(
+    reg::RB_BLENDCONTROL blend_control, uint32_t write_mask,
+    PipelineRenderTarget& render_target_out) const {
+  if (write_mask) {
+    static const PipelineBlendFactor kBlendFactorMap[32] = {
+        /*  0 */ PipelineBlendFactor::kZero,
+        /*  1 */ PipelineBlendFactor::kOne,
+        /*  2 */ PipelineBlendFactor::kZero,  // ?
+        /*  3 */ PipelineBlendFactor::kZero,  // ?
+        /*  4 */ PipelineBlendFactor::kSrcColor,
+        /*  5 */ PipelineBlendFactor::kOneMinusSrcColor,
+        /*  6 */ PipelineBlendFactor::kSrcAlpha,
+        /*  7 */ PipelineBlendFactor::kOneMinusSrcAlpha,
+        /*  8 */ PipelineBlendFactor::kDstColor,
+        /*  9 */ PipelineBlendFactor::kOneMinusDstColor,
+        /* 10 */ PipelineBlendFactor::kDstAlpha,
+        /* 11 */ PipelineBlendFactor::kOneMinusDstAlpha,
+        /* 12 */ PipelineBlendFactor::kConstantColor,
+        /* 13 */ PipelineBlendFactor::kOneMinusConstantColor,
+        /* 14 */ PipelineBlendFactor::kConstantAlpha,
+        /* 15 */ PipelineBlendFactor::kOneMinusConstantAlpha,
+        /* 16 */ PipelineBlendFactor::kSrcAlphaSaturate,
+    };
+    render_target_out.src_color_blend_factor =
+        kBlendFactorMap[uint32_t(blend_control.color_srcblend)];
+    render_target_out.dst_color_blend_factor =
+        kBlendFactorMap[uint32_t(blend_control.color_destblend)];
+    render_target_out.color_blend_op = blend_control.color_comb_fcn;
+    render_target_out.src_alpha_blend_factor =
+        kBlendFactorMap[uint32_t(blend_control.alpha_srcblend)];
+    render_target_out.dst_alpha_blend_factor =
+        kBlendFactorMap[uint32_t(blend_control.alpha_destblend)];
+    render_target_out.alpha_blend_op = blend_control.alpha_comb_fcn;
+  } else {
+    render_target_out.src_color_blend_factor = PipelineBlendFactor::kOne;
+    render_target_out.dst_color_blend_factor = PipelineBlendFactor::kZero;
+    render_target_out.color_blend_op = xenos::BlendOp::kAdd;
+    render_target_out.src_alpha_blend_factor = PipelineBlendFactor::kOne;
+    render_target_out.dst_alpha_blend_factor = PipelineBlendFactor::kZero;
+    render_target_out.alpha_blend_op = xenos::BlendOp::kAdd;
+  }
+  render_target_out.color_write_mask = write_mask;
+}
+
+bool MetalPipelineCache::GetCurrentStateDescription(
+    const SpirvShader::SpirvTranslation* vertex_shader,
+    const SpirvShader::SpirvTranslation* pixel_shader,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    MetalRenderTargetCache::RenderPassKey render_pass_key,
+    PipelineDescription& description_out) const {
+  description_out.Reset();
+  const RegisterFile& regs = register_file_;
+
+  if (primitive_processing_result.IsTessellated()) {
+    // No tessellation on the Metal path yet.
+    return false;
+  }
+  switch (primitive_processing_result.host_primitive_type) {
+    case xenos::PrimitiveType::kPointList:
+    case xenos::PrimitiveType::kLineList:
+    case xenos::PrimitiveType::kLineStrip:
+    case xenos::PrimitiveType::kTriangleList:
+    case xenos::PrimitiveType::kTriangleStrip:
+      break;
+    default:
+      // Fans, rectangles and quads are converted or expanded by the primitive processor.
+      return false;
+  }
+
+  description_out.vertex_shader_hash = vertex_shader->shader().ucode_data_hash();
+  description_out.vertex_shader_modification = vertex_shader->modification();
+  if (pixel_shader) {
+    description_out.pixel_shader_hash = pixel_shader->shader().ucode_data_hash();
+    description_out.pixel_shader_modification = pixel_shader->modification();
+  }
+  description_out.render_pass_key = render_pass_key;
+
+  bool primitive_polygonal = draw_util::IsPrimitivePolygonal(regs);
+  if (!draw_util::IsRasterizationPotentiallyDone(regs, primitive_polygonal)) {
+    description_out.rasterizer_discard = 1;
+    return true;
+  }
+
+  if (!pixel_shader && render_target_cache_.depth_float24_convert_in_pixel_shader() &&
+      (render_pass_key.depth_and_color_used & 1) && normalized_depth_control.z_enable &&
+      render_pass_key.depth_format == xenos::DepthRenderTargetFormat::kD24FS8) {
+    description_out.depth_float24_shader = render_target_cache_.depth_float24_round() ? 2 : 1;
+  }
+
+  uint32_t color_rts_remaining = render_pass_key.depth_and_color_used >> 1;
+  uint32_t color_rt_index;
+  while (rex::bit_scan_forward(color_rts_remaining, &color_rt_index)) {
+    color_rts_remaining &= ~(uint32_t(1) << color_rt_index);
+    WritePipelineRenderTargetDescription(
+        regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[color_rt_index]),
+        (normalized_color_mask >> (color_rt_index * 4)) & 0b1111,
+        description_out.render_targets[color_rt_index]);
+  }
+  return true;
+}
+
+MTL::RenderPipelineState* MetalPipelineCache::ConfigurePipeline(
+    SpirvShader::SpirvTranslation* vertex_shader, SpirvShader::SpirvTranslation* pixel_shader,
+    const PrimitiveProcessor::ProcessingResult& primitive_processing_result,
+    reg::RB_DEPTHCONTROL normalized_depth_control, uint32_t normalized_color_mask,
+    MetalRenderTargetCache::RenderPassKey render_pass_key, bool& pending_out, bool allow_async) {
+  pending_out = false;
+  if (!EnsureShadersTranslated(vertex_shader, pixel_shader)) {
+    return nullptr;
+  }
+  PipelineDescription description;
+  if (!GetCurrentStateDescription(vertex_shader, pixel_shader, primitive_processing_result,
+                                  normalized_depth_control, normalized_color_mask, render_pass_key,
+                                  description)) {
+    return nullptr;
+  }
+
+  Pipeline* pipeline;
+  if (last_pipeline_description_ && *last_pipeline_description_ == description) {
+    pipeline = last_pipeline_;
+  } else {
+    auto it = pipelines_.find(description);
+    if (it == pipelines_.end()) {
+      it = pipelines_.emplace(description, std::make_unique<Pipeline>()).first;
+      PipelineCreationRequest request;
+      request.description = &it->first;
+      request.pipeline = it->second.get();
+      request.vertex_shader = vertex_shader;
+      request.pixel_shader = pixel_shader;
+      if (allow_async && REXCVAR_GET(async_shader_compilation) && !creation_threads_.empty()) {
+        {
+          std::lock_guard<std::mutex> lock(creation_mutex_);
+          creation_queue_.push_back(request);
+        }
+        creation_cond_.notify_one();
+      } else {
+        CreatePipeline(request);
+      }
+    }
+    last_pipeline_description_ = &it->first;
+    last_pipeline_ = it->second.get();
+    pipeline = last_pipeline_;
+  }
+  if (!allow_async && pipeline->state.load(std::memory_order_acquire) == 0) {
+    // Needed now (the draw writes memory, which later work depends on): created here if still queued, or
+    // waited for if a worker has it.
+    bool create_here = false;
+    {
+      std::lock_guard<std::mutex> lock(creation_mutex_);
+      for (auto it = creation_queue_.begin(); it != creation_queue_.end(); ++it) {
+        if (it->pipeline == pipeline) {
+          PipelineCreationRequest request = *it;
+          creation_queue_.erase(it);
+          create_here = true;
+          break;
+        }
+      }
+    }
+    if (create_here) {
+      PipelineCreationRequest request;
+      request.description = last_pipeline_description_;
+      request.pipeline = pipeline;
+      request.vertex_shader = vertex_shader;
+      request.pixel_shader = pixel_shader;
+      CreatePipeline(request);
+    }
+    while (pipeline->state.load(std::memory_order_acquire) == 0) {
+      std::this_thread::yield();
+    }
+  }
+  switch (pipeline->state.load(std::memory_order_acquire)) {
+    case 1:
+      return pipeline->pipeline.get();
+    case 0:
+      pending_out = true;
+      return nullptr;
+    default:
+      return nullptr;
+  }
+}
