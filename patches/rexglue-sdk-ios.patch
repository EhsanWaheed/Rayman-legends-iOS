+ * @brief       The Metal device and command queue the Metal GPU backend and presenter share
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+#include <rex/ui/graphics_provider.h>
+#include <rex/ui/metal/api.h>
+
+namespace rex::ui::metal {
+
+class MetalProvider : public GraphicsProvider {
+ public:
+  static std::unique_ptr<MetalProvider> Create();
+  ~MetalProvider() override;
+
+  std::unique_ptr<Presenter> CreatePresenter(
+      Presenter::HostGpuLossCallback host_gpu_loss_callback =
+          Presenter::FatalErrorHostGpuLossCallback) override;
+  // None yet: ImGui overlays are not drawn with Metal.
+  std::unique_ptr<ImmediateDrawer> CreateImmediateDrawer() override { return nullptr; }
+
+  MTL::Device* device() const { return device_.get(); }
+  // The queue for painting, and for guest GPU work on Metal 3: Metal orders command buffers committed to a
+  // queue, so the presenter sees guest output written by work committed before it.
+  MTL::CommandQueue* queue() const { return queue_.get(); }
+
+  // A GPU backend on a queue of its own (Metal 4) and the presenter synchronize through events: the
+  // presenter's command buffers wait for the latest guest output to be written (the backend's event
+  // reaching the value it set), and the backend waits for the paintings committed so far, which may still
+  // be reading guest output, before writing it again.
+  void SetGuestOutputWritten(MTL::SharedEvent* event, uint64_t value) {
