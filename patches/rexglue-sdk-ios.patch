+/**
+ * @file        ui/metal/metal_provider.cpp
+ * @brief       The Metal device and command queue (provider.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/metal/presenter.h>
+#include <rex/ui/metal/provider.h>
+
+REXCVAR_DEFINE_BOOL(metal4, true, "GPU",
+                    "Metal GPU backend: Metal 4 command queues where the device and OS support them");
+
+namespace rex::ui::metal {
+
+std::unique_ptr<MetalProvider> MetalProvider::Create() {
+  std::unique_ptr<MetalProvider> provider(new MetalProvider());
+  if (!provider->Initialize()) {
+    return nullptr;
+  }
+  return provider;
+}
+
+MetalProvider::~MetalProvider() = default;
+
+bool MetalProvider::Initialize() {
+  device_ = Ref<MTL::Device>(MTL::CreateSystemDefaultDevice());
+  if (!device_) {
+    REXLOG_ERROR("MetalProvider: no Metal device");
+    return false;
+  }
+  queue_ = Ref<MTL::CommandQueue>(device_->newCommandQueue());
+  if (!queue_) {
+    REXLOG_ERROR("MetalProvider: failed to create the command queue");
+    return false;
+  }
+  queue_->setLabel(NS::String::string("rex", NS::UTF8StringEncoding));
+  present_event_ = Ref<MTL::SharedEvent>(device_->newSharedEvent());
+  if (!present_event_) {
+    REXLOG_ERROR("MetalProvider: failed to create the present event");
+    return false;
+  }
+  supports_metal4_ = device_->supportsFamily(MTL::GPUFamilyApple7) &&
+                     device_->supportsFamily(MTL::GPUFamilyMetal4);
+  REXLOG_INFO("Metal: {} (Metal 4: {}, max buffer {} MB, max threadgroup memory {} KB)",
+              device_->name()->utf8String(), supports_metal4_ ? "yes" : "no",
+              device_->maxBufferLength() >> 20, device_->maxThreadgroupMemoryLength() >> 10);
+  return true;
+}
+
+void MetalProvider::BeginGuestOutputReader(MTL::CommandBuffer* command_buffer) {
+  MTL::SharedEvent* guest_output_event = guest_output_event_.load(std::memory_order_relaxed);
+  const uint64_t guest_output_value = guest_output_value_.load(std::memory_order_acquire);
+  if (guest_output_event && guest_output_value) {
+    command_buffer->encodeWait(guest_output_event, guest_output_value);
+  }
+}
+
+void MetalProvider::CommitGuestOutputReader(MTL::CommandBuffer* command_buffer) {
+  std::lock_guard<std::mutex> lock(present_mutex_);
+  command_buffer->encodeSignalEvent(present_event_.get(), ++present_value_);
+  command_buffer->commit();
+  present_value_committed_.store(present_value_, std::memory_order_release);
+}
+
+std::unique_ptr<Presenter> MetalProvider::CreatePresenter(
+    Presenter::HostGpuLossCallback host_gpu_loss_callback) {
+  return MetalPresenter::Create(host_gpu_loss_callback, this);
+}
+
+}  // namespace rex::ui::metal
