new file mode 100644
index 0000000..40f4595
--- /dev/null
+++ b/src/core/host_vblank.cpp
@@ -0,0 +1,46 @@
+/**
+ * @file        host_vblank.cpp
+ * @brief       The host display's refresh as the guest's vblank (host_vblank.h).
+ */
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+#include <rex/host_vblank.h>
+
+namespace rex {
+
+namespace {
+std::atomic<bool> g_enabled{false};
+std::mutex g_mutex;
+std::condition_variable g_cond;
+uint32_t g_pending = 0;
+}  // namespace
+
+void SetHostVblankSource(bool enabled) {
+  g_enabled = enabled;
+}
+
+bool IsHostVblankSourceEnabled() {
+  return g_enabled;
+}
+
+void SignalHostVblank() {
+  {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    ++g_pending;
+  }
+  g_cond.notify_one();
+}
+
+uint32_t WaitHostVblank(std::chrono::microseconds timeout) {
+  std::unique_lock<std::mutex> lock(g_mutex);
+  g_cond.wait_for(lock, timeout, [] { return g_pending != 0; });
+  const uint32_t refreshes = g_pending;
+  g_pending = 0;
+  return refreshes;
+}
+
+}  // namespace rex
