+
+// Solid-value rectangle clears inside a render pass (vkCmdClearAttachments' job on Vulkan).
+constexpr char kClearShaderSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct ClearVertexOut {
+  float4 position [[position]];
+};
+
+vertex ClearVertexOut rex_clear_vs(uint vertex_id [[vertex_id]],
+                                   const device float2* positions [[buffer(30)]]) {
+  ClearVertexOut out;
+  // Vulkan-style NDC (Y down) from the shared rectangle code, to Metal's (Y up).
+  float2 position = positions[vertex_id];
+  out.position = float4(position.x, -position.y, 0.0, 1.0);
+  return out;
+}
+
+struct ClearConstants {
+  uint4 value;
+  float depth;
+};
+
+fragment float4 rex_clear_float_ps(constant ClearConstants& constants [[buffer(0)]]) {
+  return as_type<float4>(constants.value);
+}
+
+fragment uint4 rex_clear_uint_ps(constant ClearConstants& constants [[buffer(0)]]) {
+  return constants.value;
+}
+
+struct ClearDepthOut {
+  float depth [[depth(any)]];
+};
+
+fragment ClearDepthOut rex_clear_depth_ps(constant ClearConstants& constants [[buffer(0)]]) {
+  ClearDepthOut out;
+  out.depth = constants.depth;
+  return out;
+}
+)";
+
+}  // namespace
