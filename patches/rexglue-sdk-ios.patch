+/**
+ * @file        ui/metal/metal_presenter.mm
+ * @brief       Presenting the guest output to a CAMetalLayer with Metal (presenter.h)
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <TargetConditionals.h>
+
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+#if !TARGET_OS_SIMULATOR
+#import <MetalFX/MetalFX.h>
+#define REX_HAVE_METALFX 1
+#endif
+
+#include <algorithm>
+#include <cstring>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/ui/metal/presenter.h>
+#include <rex/ui/metal/provider.h>
+#include <rex/ui/surface_mac.h>
+
+REXCVAR_DECLARE(int32_t, vulkan_swapchain_image_count);
+
+namespace rex::ui::metal {
+
+namespace {
+
+// A triangle covering the target; the fragment shader maps its pixel to the effect's input from the
+// output rectangle (which may reach past the target where the picture is cropped), like the Vulkan path's
+// bilinear pass.
+constexpr char kPresenterShaders[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct RexFullscreenOut {
+  float4 position [[position]];
+};
+
+vertex RexFullscreenOut rex_fullscreen_vs(uint vertex_id [[vertex_id]]) {
+  float2 corner = float2(float((vertex_id << 1) & 2), float(vertex_id & 2));
+  RexFullscreenOut out;
+  out.position = float4(corner * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+  return out;
+}
+
+struct RexBilinearConstants {
+  int2 output_offset;
+  float2 output_size_inv;
+};
+
+fragment float4 rex_bilinear_ps(RexFullscreenOut in [[stage_in]],
+                                constant RexBilinearConstants& constants [[buffer(0)]],
+                                texture2d<float> source [[texture(0)]],
+                                sampler source_sampler [[sampler(0)]]) {
+  float2 uv = (in.position.xy - float2(constants.output_offset)) * constants.output_size_inv;
+  return float4(source.sample(source_sampler, uv).rgb, 1.0);
+}
+)";
+
+NS::String* Str(const char* text) {
+  return NS::String::string(text, NS::UTF8StringEncoding);
+}
+
+}  // namespace
+
+std::unique_ptr<MetalPresenter> MetalPresenter::Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                       MetalProvider* provider) {
+  std::unique_ptr<MetalPresenter> presenter(new MetalPresenter(host_gpu_loss_callback, provider));
+  if (!presenter->Initialize()) {
+    return nullptr;
+  }
+  return presenter;
+}
+
+MetalPresenter::~MetalPresenter() {
+#if REX_HAVE_METALFX
+  if (metalfx_scaler_) {
+    [(id<MTLFXSpatialScaler>)metalfx_scaler_ release];
+  }
+#endif
+}
+
+bool MetalPresenter::Initialize() {
+  if (!InitializeCommonSurfaceIndependent()) {
+    return false;
+  }
+  NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+  MTL::Device* device = provider_->device();
+  NS::Error* error = nullptr;
+  library_ = Ref<MTL::Library>(device->newLibrary(Str(kPresenterShaders), nullptr, &error));
+  if (!library_) {
+    REXLOG_ERROR("MetalPresenter: failed to compile its shaders: {}",
+                 error ? error->localizedDescription()->utf8String() : "?");
+    pool->release();
+    return false;
+  }
+  bilinear_pipeline_drawable_ = Ref<MTL::RenderPipelineState>(NewBilinearPipeline(kDrawableFormat));
+  MTL::SamplerDescriptor* sampler_descriptor = MTL::SamplerDescriptor::alloc()->init();
+  sampler_descriptor->setMinFilter(MTL::SamplerMinMagFilterLinear);
+  sampler_descriptor->setMagFilter(MTL::SamplerMinMagFilterLinear);
+  sampler_descriptor->setSAddressMode(MTL::SamplerAddressModeClampToEdge);
+  sampler_descriptor->setTAddressMode(MTL::SamplerAddressModeClampToEdge);
+  linear_sampler_ = Ref<MTL::SamplerState>(device->newSamplerState(sampler_descriptor));
+  sampler_descriptor->release();
+  pool->release();
+  return bilinear_pipeline_drawable_ && linear_sampler_;
+}
+
+MTL::RenderPipelineState* MetalPresenter::NewBilinearPipeline(MTL::PixelFormat format) {
+  Ref<MTL::Function> vs(library_->newFunction(Str("rex_fullscreen_vs")));
+  Ref<MTL::Function> ps(library_->newFunction(Str("rex_bilinear_ps")));
+  MTL::RenderPipelineDescriptor* descriptor = MTL::RenderPipelineDescriptor::alloc()->init();
+  descriptor->setLabel(Str("rex presenter bilinear"));
+  descriptor->setVertexFunction(vs.get());
+  descriptor->setFragmentFunction(ps.get());
+  descriptor->colorAttachments()->object(0)->setPixelFormat(format);
+  NS::Error* error = nullptr;
+  MTL::RenderPipelineState* pipeline = provider_->device()->newRenderPipelineState(descriptor, &error);
+  descriptor->release();
+  if (!pipeline) {
+    REXLOG_ERROR("MetalPresenter: failed to create the bilinear pipeline: {}",
+                 error ? error->localizedDescription()->utf8String() : "?");
+  }
+  return pipeline;
+}
+
+MTL::Texture* MetalPresenter::GetIntermediateTexture(uint32_t width, uint32_t height) {
+  if (intermediate_ && intermediate_->width() == width && intermediate_->height() == height) {
+    return intermediate_.get();
+  }
+  MTL::TextureDescriptor* descriptor = MTL::TextureDescriptor::texture2DDescriptor(
+      MTL::PixelFormatBGRA8Unorm, width, height, false);
+  descriptor->setStorageMode(MTL::StorageModePrivate);
+  // MetalFX writes it (render target and shader write cover its output requirements), the final pass reads it.
+  descriptor->setUsage(MTL::TextureUsageRenderTarget | MTL::TextureUsageShaderRead |
+                       MTL::TextureUsageShaderWrite);
+  intermediate_ = Ref<MTL::Texture>(provider_->device()->newTexture(descriptor));
+  if (intermediate_) {
+    intermediate_->setLabel(Str("rex presenter intermediate"));
+  }
+  return intermediate_.get();
+}
+
+Surface::TypeFlags MetalPresenter::GetSupportedSurfaceTypes() const {
+  return Surface::kTypeFlag_CAMetalLayer;
+}
+
+bool MetalPresenter::CaptureGuestOutput(RawImage& image_out) {
+  Ref<MTL::Texture> texture;
+  {
+    uint32_t mailbox_index;
+    std::unique_lock<std::mutex> lock(ConsumeGuestOutput(mailbox_index, nullptr, nullptr));
+    if (mailbox_index == UINT32_MAX) {
+      return false;
+    }
+    texture = guest_output_images_[mailbox_index].texture;
+  }
+  if (!texture) {
+    return false;
+  }
+  NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+  const uint32_t width = uint32_t(texture->width()), height = uint32_t(texture->height());
+  const size_t row_bytes = size_t(width) * 4;
+  Ref<MTL::Buffer> buffer(
+      provider_->device()->newBuffer(row_bytes * height, MTL::ResourceStorageModeShared));
+  bool captured = false;
+  if (buffer) {
+    MTL::CommandBuffer* command_buffer = provider_->queue()->commandBuffer();
+    provider_->BeginGuestOutputReader(command_buffer);
+    MTL::BlitCommandEncoder* blit = command_buffer->blitCommandEncoder();
+    blit->copyFromTexture(texture.get(), 0, 0, MTL::Origin(0, 0, 0), MTL::Size(width, height, 1),
+                          buffer.get(), 0, row_bytes, row_bytes * height);
+    blit->endEncoding();
+    provider_->CommitGuestOutputReader(command_buffer);
+    command_buffer->waitUntilCompleted();
+    image_out.width = width;
+    image_out.height = height;
+    image_out.stride = row_bytes;
+    image_out.data.resize(row_bytes * height);
+    const uint32_t* source = static_cast<const uint32_t*>(buffer->contents());
+    uint32_t* destination = reinterpret_cast<uint32_t*>(image_out.data.data());
+    for (size_t i = 0; i < size_t(width) * height; ++i) {
+      destination[i] = Packed10bpcRGBTo8bpcBytes(source[i]);
+    }
+    captured = true;
+  }
+  pool->release();
+  return captured;
+}
+
+Presenter::SurfacePaintConnectResult MetalPresenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+    bool was_paintable, bool& is_vsync_implicit_out) {
+  if (new_surface.GetType() != Surface::kTypeIndex_CAMetalLayer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  CAMetalLayer* layer =
+      (__bridge CAMetalLayer*)static_cast<CAMetalLayerSurface&>(new_surface).layer();
+  if (!layer || !new_surface_width || !new_surface_height) {
+    return SurfacePaintConnectResult::kFailure;
+  }
+  const uint32_t width = std::min(new_surface_width, kMaxTextureSize);
+  const uint32_t height = std::min(new_surface_height, kMaxTextureSize);
+  is_vsync_implicit_out = true;
+  if (was_paintable && layer_ == (__bridge CA::MetalLayer*)layer && layer_width_ == width &&
+      layer_height_ == height) {
+    return SurfacePaintConnectResult::kSuccessUnchanged;
+  }
+  layer.device = (__bridge id<MTLDevice>)provider_->device();
+  layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+  // Only rendered to: lets the drawables stay compressed in the GPU's own layout.
+  layer.framebufferOnly = YES;
+  // SDL's view sizes the drawables on every layout (iOS lays the view out again around screenshots, for
+  // instance): set only when unset, painting adapts to the drawable it gets, and it always fills the layer.
+  if (layer.drawableSize.width < 1 || layer.drawableSize.height < 1) {
+    layer.drawableSize = CGSizeMake(width, height);
+  }
+  layer.contentsGravity = kCAGravityResize;
+  const int32_t drawable_count = REXCVAR_GET(vulkan_swapchain_image_count);
+  layer.maximumDrawableCount = drawable_count == 2 ? 2 : 3;
+#if TARGET_OS_OSX
+  layer.displaySyncEnabled = YES;
+#endif
+  layer_ = (__bridge CA::MetalLayer*)layer;
+  layer_width_ = width;
+  layer_height_ = height;
+  return SurfacePaintConnectResult::kSuccess;
+}
+
+void MetalPresenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() {
+  layer_ = nullptr;
+  layer_width_ = 0;
+  layer_height_ = 0;
+}
+
+bool MetalPresenter::RefreshGuestOutputImpl(
+    uint32_t mailbox_index, uint32_t frontbuffer_width, uint32_t frontbuffer_height,
+    std::function<bool(GuestOutputRefreshContext& context)> refresher, bool& is_8bpc_out_ref) {
+  if (!frontbuffer_width || !frontbuffer_height || frontbuffer_width > kMaxTextureSize ||
+      frontbuffer_height > kMaxTextureSize) {
+    return false;
+  }
+  GuestOutputImage& image = guest_output_images_[mailbox_index];
+  // A command buffer keeps the textures it uses alive until it completes: replacing one needs no waiting.
+  if (!image.texture || image.texture->width() != frontbuffer_width ||
+      image.texture->height() != frontbuffer_height) {
+    MTL::TextureDescriptor* descriptor = MTL::TextureDescriptor::texture2DDescriptor(
+        kGuestOutputFormat, frontbuffer_width, frontbuffer_height, false);
+    descriptor->setStorageMode(MTL::StorageModePrivate);
+    descriptor->setUsage(MTL::TextureUsageRenderTarget | MTL::TextureUsageShaderRead |
+                         MTL::TextureUsageShaderWrite);
+    image.texture = Ref<MTL::Texture>(provider_->device()->newTexture(descriptor));
+    if (!image.texture) {
+      REXLOG_ERROR("MetalPresenter: failed to create a {}x{} guest output texture", frontbuffer_width,
+                   frontbuffer_height);
+      return false;
+    }
+    image.texture->setLabel(Str("rex guest output"));
+  }
+  MetalGuestOutputRefreshContext context(is_8bpc_out_ref, image.texture.get());
+  return refresher(context);
+}
+
+Presenter::PaintResult MetalPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  if (!layer_) {
+    return PaintResult::kNotPresented;
+  }
+  NS::AutoreleasePool* pool = NS::AutoreleasePool::alloc()->init();
+  CA::MetalDrawable* drawable = layer_->nextDrawable();
+  if (!drawable) {
+    pool->release();
+    return PaintResult::kNotPresented;
+  }
+  MTL::Texture* target = drawable->texture();
+  const uint32_t target_width = uint32_t(target->width());
+  const uint32_t target_height = uint32_t(target->height());
+
+  GuestOutputProperties properties;
+  GuestOutputPaintConfig paint_config;
+  Ref<MTL::Texture> guest_output;
+  {
+    uint32_t mailbox_index;
+    std::unique_lock<std::mutex> lock(ConsumeGuestOutput(mailbox_index, &properties, &paint_config));
+    if (mailbox_index != UINT32_MAX) {
+      guest_output = guest_output_images_[mailbox_index].texture;
+    }
+  }
+
+  MTL::CommandBuffer* command_buffer = provider_->queue()->commandBuffer();
+  command_buffer->setLabel(Str("rex present"));
+  if (guest_output) {
+    provider_->BeginGuestOutputReader(command_buffer);
+  }
+  MTL::Texture* source = guest_output.get();
+  bool final_drawn = false;
+  if (source) {
+    const GuestOutputPaintFlow flow = GetGuestOutputPaintFlow(
+        properties, target_width, target_height, kMaxTextureSize, kMaxTextureSize, paint_config);
+    for (size_t i = 0; i < flow.effect_count && source; ++i) {
+      const std::pair<uint32_t, uint32_t>& size = flow.effect_output_sizes[i];
+      switch (flow.effects[i]) {
+#if REX_HAVE_METALFX
+        case GuestOutputPaintEffect::kMetalFxSpatial: {
+          MTL::Texture* destination = GetIntermediateTexture(size.first, size.second);
+          if (!destination) {
+            source = nullptr;
+            break;
+          }
+          if (!metalfx_scaler_ || metalfx_input_width_ != source->width() ||
+              metalfx_input_height_ != source->height() || metalfx_output_width_ != size.first ||
+              metalfx_output_height_ != size.second) {
+            if (metalfx_scaler_) {
+              [(id<MTLFXSpatialScaler>)metalfx_scaler_ release];
+              metalfx_scaler_ = nullptr;
+            }
+            MTLFXSpatialScalerDescriptor* descriptor = [MTLFXSpatialScalerDescriptor new];
+            descriptor.inputWidth = source->width();
+            descriptor.inputHeight = source->height();
+            descriptor.outputWidth = size.first;
+            descriptor.outputHeight = size.second;
+            descriptor.colorTextureFormat = MTLPixelFormat(source->pixelFormat());
+            descriptor.outputTextureFormat = MTLPixelFormat(destination->pixelFormat());
+            // The game's picture is display-referred (gamma encoded).
+            descriptor.colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+            metalfx_scaler_ =
+                [descriptor newSpatialScalerWithDevice:(__bridge id<MTLDevice>)provider_->device()];
+            [descriptor release];
+            if (!metalfx_scaler_) {
+              REXLOG_ERROR("MetalFX: could not create a {}x{} -> {}x{} spatial scaler",
+                           source->width(), source->height(), size.first, size.second);
+              source = nullptr;
+              break;
+            }
+            metalfx_input_width_ = uint32_t(source->width());
+            metalfx_input_height_ = uint32_t(source->height());
+            metalfx_output_width_ = size.first;
+            metalfx_output_height_ = size.second;
+            REXLOG_INFO("MetalFX: spatial {}x{} -> {}x{}", metalfx_input_width_, metalfx_input_height_,
+                        size.first, size.second);
+          }
+          id<MTLFXSpatialScaler> scaler = (id<MTLFXSpatialScaler>)metalfx_scaler_;
+          scaler.colorTexture = (__bridge id<MTLTexture>)source;
+          scaler.outputTexture = (__bridge id<MTLTexture>)destination;
+          scaler.inputContentWidth = source->width();
+          scaler.inputContentHeight = source->height();
+          [scaler encodeToCommandBuffer:(__bridge id<MTLCommandBuffer>)command_buffer];
+          source = destination;
+          break;
+        }
+#endif
+        case GuestOutputPaintEffect::kBilinear:
+        case GuestOutputPaintEffect::kBilinearDither: {
+          // On Apple the bilinear pass is always the final one, into the drawable.
+          MTL::RenderPassDescriptor* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+          MTL::RenderPassColorAttachmentDescriptor* color = pass->colorAttachments()->object(0);
+          color->setTexture(target);
+          // The letterbox, and nothing to load: clearing is free on tile-based GPUs.
+          color->setLoadAction(MTL::LoadActionClear);
+          color->setClearColor(MTL::ClearColor(0.0, 0.0, 0.0, 1.0));
+          color->setStoreAction(MTL::StoreActionStore);
+          MTL::RenderCommandEncoder* encoder = command_buffer->renderCommandEncoder(pass);
+          int32_t offset_x, offset_y;
+          flow.GetEffectOutputOffset(i, offset_x, offset_y);
+          // Only where the picture is (the rest stays the clear colour).
+          const int32_t left = std::max(offset_x, 0), top = std::max(offset_y, 0);
+          const int32_t right = std::min(offset_x + int32_t(size.first), int32_t(target_width));
+          const int32_t bottom = std::min(offset_y + int32_t(size.second), int32_t(target_height));
+          if (right > left && bottom > top) {
+            encoder->setScissorRect(MTL::ScissorRect{NS::UInteger(left), NS::UInteger(top),
+                                                     NS::UInteger(right - left),
+                                                     NS::UInteger(bottom - top)});
+            struct {
+              int32_t output_offset[2];
+              float output_size_inv[2];
+            } constants = {{offset_x, offset_y},
+                           {1.0f / float(size.first), 1.0f / float(size.second)}};
+            encoder->setRenderPipelineState(bilinear_pipeline_drawable_.get());
+            encoder->setFragmentBytes(&constants, sizeof(constants), 0);
+            encoder->setFragmentTexture(source, 0);
+            encoder->setFragmentSamplerState(linear_sampler_.get(), 0);
+            encoder->drawPrimitives(MTL::PrimitiveTypeTriangle, NS::UInteger(0), NS::UInteger(3));
+          }
+          encoder->endEncoding();
+          final_drawn = true;
+          break;
+        }
+        default:
+          source = nullptr;
+          break;
+      }
+    }
+  }
+  if (!final_drawn) {
+    // No guest output yet (or it couldn't be drawn): black.
+    MTL::RenderPassDescriptor* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+    MTL::RenderPassColorAttachmentDescriptor* color = pass->colorAttachments()->object(0);
+    color->setTexture(target);
+    color->setLoadAction(MTL::LoadActionClear);
+    color->setClearColor(MTL::ClearColor(0.0, 0.0, 0.0, 1.0));
+    color->setStoreAction(MTL::StoreActionStore);
+    command_buffer->renderCommandEncoder(pass)->endEncoding();
+  }
+
+  if (execute_ui_drawers) {
+    MetalUIDrawContext ui_draw_context(*this, target_width, target_height, command_buffer, target);
+    ExecuteUIDrawersFromUIThread(ui_draw_context);
+  }
+
+  command_buffer->presentDrawable(drawable);
+  provider_->CommitGuestOutputReader(command_buffer);
+  CountPresentedFrame();
+  pool->release();
+  return PaintResult::kPresented;
+}
+
+}  // namespace rex::ui::metal
