+/**
+ * @file        graphics/metal/primitive_processor.h
+ * @brief       Primitive processing (index conversion) for Metal
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+#include <rex/graphics/primitive_processor.h>
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+
+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(const RegisterFile& register_file, memory::Memory& memory,
+                          SharedMemory& shared_memory, MetalCommandProcessor& command_processor)
+      : PrimitiveProcessor(register_file, memory, shared_memory),
+        command_processor_(command_processor) {}
+  ~MetalPrimitiveProcessor();
+
+  bool Initialize();
+  void Shutdown(bool from_destructor = false);
+
+  void EndFrame();
+
+  std::pair<MTL::Buffer*, size_t> GetBuiltinIndexBuffer(size_t handle) const {
+    return std::make_pair(builtin_index_buffer_.get(), GetBuiltinIndexBufferOffsetBytes(handle));
+  }
+  std::pair<MTL::Buffer*, size_t> GetConvertedIndexBuffer(size_t handle) const {
+    return frame_index_buffers_[handle];
+  }
+
+ protected:
+  bool InitializeBuiltinIndexBuffer(size_t size_bytes,
+                                    std::function<void(void*)> fill_callback) override;
+  void* RequestHostConvertedIndexBufferForCurrentFrame(xenos::IndexFormat format,
+                                                       uint32_t index_count, bool coalign_for_simd,
+                                                       uint32_t coalignment_original_address,
+                                                       size_t& backend_handle_out) override;
+
+ private:
+  MetalCommandProcessor& command_processor_;
+  // Shared storage: written once by the CPU, read by the GPU (unified memory).
+  ui::metal::Ref<MTL::Buffer> builtin_index_buffer_;
+  // Indexed by the backend handles, for the current frame.
+  std::vector<std::pair<MTL::Buffer*, size_t>> frame_index_buffers_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/include/rex/graphics/metal/render_target_cache.h b/include/rex/graphics/metal/render_target_cache.h
new file mode 100644
index 0000000..26c9bf5
--- /dev/null
+++ b/include/rex/graphics/metal/render_target_cache.h
@@ -0,0 +1,524 @@
+/**
+ * @file        graphics/metal/render_target_cache.h
+ * @brief       EDRAM emulation with Metal render targets (host render target path)
+ *
+ * Mirrors the Vulkan render target cache: guest render targets are host textures, EDRAM ownership changes
+ * are fragment-shader transfers (the same generated shaders, converted to MSL), and resolves dump the owning
+ * render targets to an EDRAM buffer for the resolve compute shaders. What Vulkan needs and Metal doesn't —
+ * render pass and framebuffer objects, descriptor sets, layouts and barriers — is gone: Metal tracks hazards
+ * between encoders, and render passes are described when they begin.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+#include <rex/graphics/flags.h>
+#include <rex/graphics/metal/encoders.h>
+#include <rex/graphics/pipeline/render_target/cache.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/graphics/xenos.h>
+#include <rex/hash.h>
+#include <rex/ui/metal/api.h>
+
+namespace rex::graphics::metal {
+
+class MetalCommandProcessor;
+class MetalSharedMemory;
+class MetalTextureCache;
+
+// The attachments of a Metal render pass (null where unused) and the area it may touch.
+struct MetalRenderPassTargets {
+  MTL::Texture* color[xenos::kMaxColorRenderTargets] = {};
+  MTL::Texture* depth_stencil = nullptr;
+  // The render target area (renderTargetWidth / Height): loads and stores of a tile-based GPU are limited to
+  // it.
+  uint32_t width = 0;
+  uint32_t height = 0;
+  bool operator==(const MetalRenderPassTargets& other) const {
+    return std::memcmp(this, &other, sizeof(*this)) == 0;
+  }
+  bool operator!=(const MetalRenderPassTargets& other) const { return !(*this == other); }
+};
+
+class MetalRenderTargetCache final : public RenderTargetCache {
+ public:
+  // Same layout as the Vulkan RenderPassKey: what pipelines depend on (sample count, attachment formats).
+  union RenderPassKey {
+    struct {
+      xenos::MsaaSamples msaa_samples : xenos::kMsaaSamplesBits;          // 2
+      uint32_t depth_and_color_used : 1 + xenos::kMaxColorRenderTargets;  // 7
+      xenos::DepthRenderTargetFormat depth_format : xenos::kDepthRenderTargetFormatBits;  // 8
+      xenos::ColorRenderTargetFormat color_0_view_format : xenos::kColorRenderTargetFormatBits;
+      xenos::ColorRenderTargetFormat color_1_view_format : xenos::kColorRenderTargetFormatBits;
+      xenos::ColorRenderTargetFormat color_2_view_format : xenos::kColorRenderTargetFormatBits;
+      xenos::ColorRenderTargetFormat color_3_view_format : xenos::kColorRenderTargetFormatBits;
+      uint32_t color_rts_use_transfer_formats : 1;
+    };
+    uint32_t key = 0;
+    struct Hasher {
+      size_t operator()(const RenderPassKey& key) const { return std::hash<uint32_t>{}(key.key); }
+    };
+    bool operator==(const RenderPassKey& other_key) const { return key == other_key.key; }
+    bool operator!=(const RenderPassKey& other_key) const { return !(*this == other_key); }
+    bool operator<(const RenderPassKey& other_key) const { return key < other_key.key; }
+    xenos::ColorRenderTargetFormat color_view_format(uint32_t i) const {
+      switch (i) {
+        case 0:
+          return color_0_view_format;
+        case 1:
+          return color_1_view_format;
+        case 2:
+          return color_2_view_format;
+        default:
+          return color_3_view_format;
+      }
+    }
+  };
+  static_assert_size(RenderPassKey, sizeof(uint32_t));
+
+  // Buffer slots of the backend's utility shaders (msl.h kMslSlotsPerSet scheme) beyond the resources: the
+  // vertex buffer of the transfer and clear rectangles.
+  static constexpr uint32_t kRectangleVertexBufferSlot = 30;
+
+  MetalRenderTargetCache(const RegisterFile& register_file, const memory::Memory& memory,
+                         MetalCommandProcessor& command_processor);
+  ~MetalRenderTargetCache();
+
+  bool Initialize();
+  void Shutdown(bool from_destructor = false);
+  void ClearCache() override;
+
+  Path GetPath() const override { return Path::kHostRenderTargets; }
+
+  MTL::Buffer* edram_buffer() const { return edram_buffer_.get(); }
+
+  // Performs the resolve to shared memory according to the current register values, and clears the render
+  // targets if needed.
+  bool Resolve(const memory::Memory& memory, MetalSharedMemory& shared_memory,
+               MetalTextureCache& texture_cache, uint32_t& written_address_out,
+               uint32_t& written_length_out);
+
+  bool Update(bool is_rasterization_done, reg::RB_DEPTHCONTROL normalized_depth_control,
+              uint32_t normalized_color_mask, const Shader& vertex_shader) override;
+  // For the last successful update.
+  RenderPassKey last_update_render_pass_key() const { return last_update_render_pass_key_; }
+  const MetalRenderPassTargets& last_update_render_pass_targets() const {
+    return last_update_render_pass_targets_;
+  }
+
+  // Using RG16 / RGBA16 SNORM, which are -1...1, not the needed -32...32.
+  bool IsFixedRG16TruncatedToMinus1To1() const {
+    return !REXCVAR_GET(snorm16_render_target_full_range);
+  }
+  bool IsFixedRGBA16TruncatedToMinus1To1() const {
+    return !REXCVAR_GET(snorm16_render_target_full_range);
+  }
+  bool gamma_render_target_as_unorm16() const { return gamma_render_target_as_unorm16_; }
+  // Apple GPUs have no 24-bit depth: D24S8 is 32-bit float depth, converted in shaders.
+  bool depth_unorm24_vulkan_format_supported() const { return false; }
+  bool depth_float24_round() const { return depth_float24_round_; }
+  bool depth_float24_convert_in_pixel_shader() const {
+    return depth_float24_convert_in_pixel_shader_;
+  }
+  bool msaa_2x_attachments_supported() const { return msaa_2x_supported_; }
+  bool msaa_2x_no_attachments_supported() const { return msaa_2x_supported_; }
+
+  static MTL::PixelFormat GetDepthPixelFormat(xenos::DepthRenderTargetFormat format) {
+    (void)format;
+    return MTL::PixelFormatDepth32Float_Stencil8;
+  }
+  MTL::PixelFormat GetColorPixelFormat(xenos::ColorRenderTargetFormat format) const;
+  // Bit-exact formats for copying between render targets (uint for formats whose float or snorm values
+  // can't round-trip: NaNs, two representations of -1).
+  MTL::PixelFormat GetColorOwnershipTransferPixelFormat(xenos::ColorRenderTargetFormat format,
+                                                        bool* is_integer_out = nullptr) const;
+  // For the shared transfer shader generator (the transfer format doesn't depend on the sample count on
+  // Apple GPUs: integer formats are multisampled like the others).
+  MTL::PixelFormat GetColorOwnershipTransferFormatForSamples(xenos::ColorRenderTargetFormat format,
+                                                             xenos::MsaaSamples msaa_samples,
+                                                             bool* is_integer_out = nullptr) const {
+    (void)msaa_samples;
+    return GetColorOwnershipTransferPixelFormat(format, is_integer_out);
+  }
+  bool IsColor16FormatFloatLike(xenos::ColorRenderTargetFormat format) const {
+    return format == xenos::ColorRenderTargetFormat::k_16_16_FLOAT ||
+           format == xenos::ColorRenderTargetFormat::k_16_16_16_16_FLOAT;
+  }
+  // The host sample count of a guest sample count.
+  NS::UInteger GetHostSampleCount(xenos::MsaaSamples msaa_samples) const {
+    return msaa_samples == xenos::MsaaSamples::k2X && !msaa_2x_supported_
+               ? 4
+               : NS::UInteger(1) << uint32_t(msaa_samples);
+  }
+
+ protected:
+  uint32_t GetMaxRenderTargetWidth() const override;
+  uint32_t GetMaxRenderTargetHeight() const override;
+
+  RenderTarget* CreateRenderTarget(RenderTargetKey key) override;
+
+  bool IsHostDepthEncodingDifferent(xenos::DepthRenderTargetFormat format) const override;
+
+  bool IsGammaFormatHostStorageSeparate() const override { return gamma_render_target_as_unorm16_; }
+
+ private:
+  class MetalRenderTarget final : public RenderTarget {
+   public:
+    MetalRenderTarget(RenderTargetKey key, MetalCommandProcessor& command_processor,
+                      ui::metal::Ref<MTL::Texture> texture,
+                      ui::metal::Ref<MTL::Texture> view_transfer,
+                      ui::metal::Ref<MTL::Texture> view_stencil);
+    ~MetalRenderTarget();
+
+    // Drawing (and, for depth, depth reads).
+    MTL::Texture* texture() const { return texture_.get(); }
+    // Color in the ownership transfer format (the texture itself if that's the same).
+    MTL::Texture* view_transfer() const {
+      return view_transfer_ ? view_transfer_.get() : texture_.get();
+    }
+    // Depth: the stencil aspect, for reading.
+    MTL::Texture* view_stencil() const { return view_stencil_.get(); }
+
+    uint32_t temporary_sort_index() const { return temporary_sort_index_; }
+    void SetTemporarySortIndex(uint32_t index) { temporary_sort_index_ = index; }
+
+   private:
+    MetalCommandProcessor& command_processor_;
+    ui::metal::Ref<MTL::Texture> texture_;
+    ui::metal::Ref<MTL::Texture> view_transfer_;
+    ui::metal::Ref<MTL::Texture> view_stencil_;
+    uint32_t temporary_sort_index_ = 0;
+  };
+
+  enum TransferUsedDescriptorSet : uint32_t {
+    kTransferUsedDescriptorSetHostDepthBuffer,
+    kTransferUsedDescriptorSetHostDepthStencilTextures,
+    kTransferUsedDescriptorSetDepthStencilTextures,
+    kTransferUsedDescriptorSetColorTexture,
+
+    kTransferUsedDescriptorSetCount,
+
+    kTransferUsedDescriptorSetHostDepthBufferBit = uint32_t(1)
+                                                   << kTransferUsedDescriptorSetHostDepthBuffer,
+    kTransferUsedDescriptorSetHostDepthStencilTexturesBit =
+        uint32_t(1) << kTransferUsedDescriptorSetHostDepthStencilTextures,
+    kTransferUsedDescriptorSetDepthStencilTexturesBit =
+        uint32_t(1) << kTransferUsedDescriptorSetDepthStencilTextures,
+    kTransferUsedDescriptorSetColorTextureBit = uint32_t(1)
+                                                << kTransferUsedDescriptorSetColorTexture,
+  };
+
+  enum TransferUsedPushConstantDword : uint32_t {
+    kTransferUsedPushConstantDwordHostDepthAddress,
+    kTransferUsedPushConstantDwordAddress,
+    kTransferUsedPushConstantDwordStencilMask,
+
+    kTransferUsedPushConstantDwordCount,
+
+    kTransferUsedPushConstantDwordHostDepthAddressBit =
+        uint32_t(1) << kTransferUsedPushConstantDwordHostDepthAddress,
+    kTransferUsedPushConstantDwordAddressBit = uint32_t(1) << kTransferUsedPushConstantDwordAddress,
+    kTransferUsedPushConstantDwordStencilMaskBit = uint32_t(1)
+                                                   << kTransferUsedPushConstantDwordStencilMask,
+  };
+
+  enum class TransferPipelineLayoutIndex {
+    kColor,
+    kDepth,
+    kColorToStencilBit,
+    kDepthToStencilBit,
+    kColorAndHostDepthTexture,
+    kColorAndHostDepthBuffer,
+    kDepthAndHostDepthTexture,
+    kDepthAndHostDepthBuffer,
+
+    kCount,
+  };
+
+  struct TransferPipelineLayoutInfo {
+    uint32_t used_descriptor_sets;
+    uint32_t used_push_constant_dwords;
+  };
+
+  static const TransferPipelineLayoutInfo
+      kTransferPipelineLayoutInfos[size_t(TransferPipelineLayoutIndex::kCount)];
+
+  enum class TransferMode : uint32_t {
+    kColorToDepth,
+    kColorToColor,
+
+    kDepthToDepth,
+    kDepthToColor,
+
+    kColorToStencilBit,
+    kDepthToStencilBit,
+
+    kColorAndHostDepthToDepth,
+    kDepthAndHostDepthToDepth,
+
+    kColorAndHostDepthCopyToDepth,
+    kDepthAndHostDepthCopyToDepth,
+
+    kCount,
+  };
+
+  enum class TransferOutput {
+    kColor,
+    kDepth,
+    kStencilBit,
+  };
+
+  struct TransferModeInfo {
+    TransferOutput output;
+    TransferPipelineLayoutIndex pipeline_layout;
+  };
+
+  static const TransferModeInfo kTransferModes[size_t(TransferMode::kCount)];
+
+  union TransferShaderKey {
+    uint32_t key;
+    struct {
+      xenos::MsaaSamples dest_msaa_samples : xenos::kMsaaSamplesBits;
+      uint32_t dest_color_rt_index : xenos::kColorRenderTargetIndexBits;
+      uint32_t dest_resource_format : xenos::kRenderTargetFormatBits;
+      xenos::MsaaSamples source_msaa_samples : xenos::kMsaaSamplesBits;
+      xenos::MsaaSamples host_depth_source_msaa_samples : xenos::kMsaaSamplesBits;
+      uint32_t source_resource_format : xenos::kRenderTargetFormatBits;
+      static_assert(size_t(TransferMode::kCount) <= (size_t(1) << 4));
+      TransferMode mode : 4;
+    };
+
+    TransferShaderKey() : key(0) { static_assert_size(*this, sizeof(key)); }
+
+    struct Hasher {
+      size_t operator()(const TransferShaderKey& key) const {
+        return std::hash<uint32_t>{}(key.key);
+      }
+    };
+    bool operator==(const TransferShaderKey& other_key) const { return key == other_key.key; }
+    bool operator!=(const TransferShaderKey& other_key) const { return !(*this == other_key); }
+    bool operator<(const TransferShaderKey& other_key) const { return key < other_key.key; }
+  };
+
+  union TransferAddressConstant {
+    uint32_t constant;
+    struct {
+      uint32_t dest_pitch : xenos::kEdramPitchTilesBits;
+      uint32_t source_pitch : xenos::kEdramPitchTilesBits;
+      int32_t source_to_dest : xenos::kEdramBaseTilesBits + 1;
+    };
+    TransferAddressConstant() : constant(0) { static_assert_size(*this, sizeof(constant)); }
+  };
+
+  struct TransferInvocation {
+    Transfer transfer;
+    TransferShaderKey shader_key;
+    TransferInvocation(const Transfer& transfer, const TransferShaderKey& shader_key)
+        : transfer(transfer), shader_key(shader_key) {}
+    bool operator<(const TransferInvocation& other_invocation) const {
+      if (shader_key != other_invocation.shader_key) {
+        return shader_key < other_invocation.shader_key;
+      }
+      uint32_t source_index =
+          static_cast<const MetalRenderTarget*>(transfer.source)->temporary_sort_index();
+      uint32_t other_source_index =
+          static_cast<const MetalRenderTarget*>(other_invocation.transfer.source)
+              ->temporary_sort_index();
+      if (source_index != other_source_index) {
+        return source_index < other_source_index;
+      }
+      return transfer.start_tiles < other_invocation.transfer.start_tiles;
+    }
+    bool CanBeMergedIntoOneDraw(const TransferInvocation& other_invocation) const {
+      return shader_key == other_invocation.shader_key &&
+             transfer.AreSourcesSame(other_invocation.transfer);
+    }
+  };
+
+  union DumpPipelineKey {
+    uint32_t key;
+    struct {
+      xenos::MsaaSamples msaa_samples : 2;
+      uint32_t resource_format : 4;
+      uint32_t is_depth : 1;
+    };
+
+    DumpPipelineKey() : key(0) { static_assert_size(*this, sizeof(key)); }
+
+    struct Hasher {
+      size_t operator()(const DumpPipelineKey& key) const { return std::hash<uint32_t>{}(key.key); }
+    };
+    bool operator==(const DumpPipelineKey& other_key) const { return key == other_key.key; }
+    bool operator!=(const DumpPipelineKey& other_key) const { return !(*this == other_key); }
+    bool operator<(const DumpPipelineKey& other_key) const { return key < other_key.key; }
+
+    xenos::ColorRenderTargetFormat GetColorFormat() const {
+      return xenos::ColorRenderTargetFormat(resource_format);
+    }
+    xenos::DepthRenderTargetFormat GetDepthFormat() const {
+      return xenos::DepthRenderTargetFormat(resource_format);
+    }
+  };
+
+  static constexpr uint32_t kDumpSamplesPerGroupX = 8;
+  static constexpr uint32_t kDumpSamplesPerGroupY = 16;
+
+  union DumpPitches {
+    uint32_t pitches;
+    struct {
+      uint32_t dest_pitch : xenos::kEdramPitchTilesBits;
+      uint32_t source_pitch : xenos::kEdramPitchTilesBits;
+    };
+    DumpPitches() : pitches(0) { static_assert_size(*this, sizeof(pitches)); }
+  };
+
+  union DumpOffsets {
+    uint32_t offsets;
+    struct {
+      uint32_t dispatch_first_tile : xenos::kEdramBaseTilesBits + 1;
+      uint32_t source_base_tiles : xenos::kEdramBaseTilesBits;
+    };
+    DumpOffsets() : offsets(0) { static_assert_size(*this, sizeof(offsets)); }
+  };
+
+  enum DumpDescriptorSet : uint32_t {
+    kDumpDescriptorSetEdram,
+    kDumpDescriptorSetSource,
+    kDumpDescriptorSetCount,
+  };
+
+  enum DumpPushConstant : uint32_t {
+    kDumpPushConstantPitches,
+    kDumpPushConstantOffsets,
+    kDumpPushConstantCount,
+  };
+
+  struct DumpInvocation {
+    ResolveCopyDumpRectangle rectangle;
+    DumpPipelineKey pipeline_key;
+    DumpInvocation(const ResolveCopyDumpRectangle& rectangle, const DumpPipelineKey& pipeline_key)
+        : rectangle(rectangle), pipeline_key(pipeline_key) {}
+    bool operator<(const DumpInvocation& other_invocation) const {
+      if (pipeline_key != other_invocation.pipeline_key) {
+        return pipeline_key < other_invocation.pipeline_key;
+      }
+      uint32_t render_target_index =
+          static_cast<const MetalRenderTarget*>(rectangle.render_target)->temporary_sort_index();
+      const ResolveCopyDumpRectangle& other_rectangle = other_invocation.rectangle;
+      uint32_t other_render_target_index =
+          static_cast<const MetalRenderTarget*>(other_rectangle.render_target)
+              ->temporary_sort_index();
+      if (render_target_index != other_render_target_index) {
+        return render_target_index < other_render_target_index;
+      }
+      if (rectangle.row_first != other_rectangle.row_first) {
+        return rectangle.row_first < other_rectangle.row_first;
+      }
+      return rectangle.row_first_start < other_rectangle.row_first_start;
+    }
+  };
+
+  // A compute pipeline and its threadgroup size (Metal takes it at dispatch).
+  struct ComputePipeline {
+    ui::metal::Ref<MTL::ComputePipelineState> state;
+    MTL::Size threads_per_group{1, 1, 1};
+  };
+
+  // Clearing a rectangle of an attachment inside a render pass (Metal has no vkCmdClearAttachments).
+  union ClearPipelineKey {
+    uint64_t key;
+    struct {
+      uint32_t pixel_format;  // MTL::PixelFormat of the attachment
+      uint32_t sample_count : 8;
+      // 0 - float color, 1 - uint color, 2 - depth / stencil.
+      uint32_t kind : 2;
+    };
+    ClearPipelineKey() : key(0) { static_assert_size(*this, sizeof(key)); }
+    bool operator==(const ClearPipelineKey& other) const { return key == other.key; }
+    struct Hasher {
+      size_t operator()(const ClearPipelineKey& key) const { return std::hash<uint64_t>{}(key.key); }
+    };
+  };
+
+  // The generated SPIR-V of a transfer shader, null if failed.
+  MTL::Function* GetTransferShader(TransferShaderKey key);
+  // The pipeline for a transfer to a destination render target (null if failed to create).
+  MTL::RenderPipelineState* GetTransferPipeline(TransferShaderKey shader_key,
+                                                MTL::PixelFormat dest_format,
+                                                NS::UInteger dest_sample_count);
+  MTL::DepthStencilState* GetTransferDepthStencilState(TransferOutput output);
+
+  // Ownership transfers and resolve clears for render targets (each may be null / have no transfers).
+  void PerformTransfersAndResolveClears(
+      uint32_t render_target_count, RenderTarget* const* render_targets,
+      const std::vector<Transfer>* render_target_transfers,
+      const uint64_t* render_target_resolve_clear_values = nullptr,
+      const Transfer::Rectangle* resolve_clear_rectangle = nullptr);
+  // Draws rectangles (in pixels) into the current render pass with a solid value.
+  void ClearRectangles(MetalRenderEncoder* encoder, MTL::Texture* attachment, bool is_depth,
+                       bool color_is_uint, const uint32_t clear_value_bits[4], float clear_depth,
+                       uint32_t clear_stencil, bool clear_depth_aspect, bool clear_stencil_aspect,
+                       const Transfer::Rectangle* rectangles, uint32_t rectangle_count);
+
+  const ComputePipeline* GetDumpPipeline(DumpPipelineKey key);
+  // Writes the contents of host render targets within the rectangles from
+  // ResolveInfo::GetCopyEdramTileSpan to edram_buffer_.
+  bool DumpRenderTargets(uint32_t dump_base, uint32_t dump_row_length_used, uint32_t dump_rows,
+                         uint32_t dump_pitch);
+
+  // A compute pipeline from SPIR-V (the build's shaders or generated), with the kMslSlotsPerSet slots.
+  bool CreateComputePipeline(const uint32_t* spirv, size_t spirv_size_bytes, const char* name,
+                             ComputePipeline& pipeline_out);
+
+  MetalCommandProcessor& command_processor_;
+
+  bool gamma_render_target_as_unorm16_ = false;
+  bool depth_float24_round_ = false;
+  bool depth_float24_convert_in_pixel_shader_ = false;
+  bool msaa_2x_supported_ = false;
+
+  ui::metal::Ref<MTL::Buffer> edram_buffer_;
+
+  std::array<ComputePipeline, size_t(draw_util::ResolveCopyShaderIndex::kCount)>
+      resolve_copy_pipelines_;
+  ComputePipeline host_depth_store_pipelines_[size_t(xenos::MsaaSamples::k4X) + 1];
+
+  ui::metal::Ref<MTL::Function> transfer_vertex_function_;
+  std::unordered_map<TransferShaderKey, ui::metal::Ref<MTL::Function>, TransferShaderKey::Hasher>
+      transfer_shaders_;
+  // By shader key, destination format and sample count.
+  std::unordered_map<uint64_t, ui::metal::Ref<MTL::RenderPipelineState>> transfer_pipelines_;
+  ui::metal::Ref<MTL::DepthStencilState> transfer_depth_stencil_states_[3];
+
+  ui::metal::Ref<MTL::Library> clear_library_;
+  std::unordered_map<ClearPipelineKey, ui::metal::Ref<MTL::RenderPipelineState>,
+                     ClearPipelineKey::Hasher>
+      clear_pipelines_;
+  // Depth and / or stencil written always.
+  ui::metal::Ref<MTL::DepthStencilState> clear_depth_stencil_states_[4];
+
+  std::unordered_map<DumpPipelineKey, ComputePipeline, DumpPipelineKey::Hasher> dump_pipelines_;
+
+  RenderPassKey last_update_render_pass_key_;
+  MetalRenderPassTargets last_update_render_pass_targets_;
+
+  // Temporary storage for Resolve.
+  std::vector<Transfer> clear_transfers_[2];
+  // Temporary storage for PerformTransfersAndResolveClears.
+  std::vector<TransferInvocation> current_transfer_invocations_;
+  std::vector<float> transfer_vertices_;
+  // Temporary storage for DumpRenderTargets.
+  std::vector<ResolveCopyDumpRectangle> dump_rectangles_;
+  std::vector<DumpInvocation> dump_invocations_;
+};
