+#include <cstring>
+
+#include <rex/graphics/metal/command_processor.h>
+#include <rex/graphics/metal/encoders.h>
+
+namespace rex::graphics::metal {
+
+namespace {
+
+constexpr MTL::Stages kRenderStages = MTL::StageVertex | MTL::StageFragment;
+constexpr MTL::Stages kComputeStages = MTL::StageDispatch | MTL::StageBlit;
+constexpr MTL::Stages kAllStages = kRenderStages | kComputeStages;
+
+NS::String* Label(const char* label) { return NS::String::string(label, NS::UTF8StringEncoding); }
+
+// setBytes data larger than this goes to the upload ring on Metal 3 too (Metal's limit).
+constexpr size_t kMaxInlineBytes = 4096;
+
+}  // namespace
+
+// Render.
+
+void MetalRenderEncoder::Begin(MTL::RenderCommandEncoder* encoder) {
+  m3_ = encoder;
+  m4_ = nullptr;
+}
+
+void MetalRenderEncoder::Begin(MTL4::RenderCommandEncoder* encoder, MTL4::ArgumentTable* vertex_table,
+                               MTL4::ArgumentTable* fragment_table) {
+  m3_ = nullptr;
+  m4_ = encoder;
+  tables_[0] = vertex_table;
+  tables_[1] = fragment_table;
+  // After everything before in the queue: render targets, resolves, texture loads.
+  m4_->barrierAfterQueueStages(kAllStages, kRenderStages, MTL4::VisibilityOptionDevice);
+  m4_->setArgumentTable(vertex_table, MTL::RenderStageVertex);
+  m4_->setArgumentTable(fragment_table, MTL::RenderStageFragment);
+}
+
+void MetalRenderEncoder::End() {
+  if (m3_) {
+    m3_->endEncoding();
+    m3_ = nullptr;
+  }
+  if (m4_) {
+    m4_->endEncoding();
+    m4_ = nullptr;
+  }
+}
+
+void MetalRenderEncoder::setLabel(const char* label) {
+  if (m3_) {
+    m3_->setLabel(Label(label));
+  } else {
+    m4_->setLabel(Label(label));
+  }
+}
+
+#define REX_METAL_RENDER_CALL(call) \
+  if (m3_) {                        \
+    m3_->call;                      \
+  } else {                          \
+    m4_->call;                      \
+  }
+
+void MetalRenderEncoder::setRenderPipelineState(MTL::RenderPipelineState* pipeline) {
+  REX_METAL_RENDER_CALL(setRenderPipelineState(pipeline));
+}
+void MetalRenderEncoder::setDepthStencilState(MTL::DepthStencilState* state) {
+  REX_METAL_RENDER_CALL(setDepthStencilState(state));
+}
+void MetalRenderEncoder::setStencilReferenceValue(uint32_t value) {
+  REX_METAL_RENDER_CALL(setStencilReferenceValue(value));
+}
+void MetalRenderEncoder::setStencilReferenceValues(uint32_t front, uint32_t back) {
+  REX_METAL_RENDER_CALL(setStencilReferenceValues(front, back));
+}
+void MetalRenderEncoder::setCullMode(MTL::CullMode mode) { REX_METAL_RENDER_CALL(setCullMode(mode)); }
+void MetalRenderEncoder::setFrontFacingWinding(MTL::Winding winding) {
+  REX_METAL_RENDER_CALL(setFrontFacingWinding(winding));
+}
+void MetalRenderEncoder::setTriangleFillMode(MTL::TriangleFillMode mode) {
+  REX_METAL_RENDER_CALL(setTriangleFillMode(mode));
+}
+void MetalRenderEncoder::setDepthBias(float bias, float slope_scale, float clamp) {
+  REX_METAL_RENDER_CALL(setDepthBias(bias, slope_scale, clamp));
+}
+void MetalRenderEncoder::setDepthClipMode(MTL::DepthClipMode mode) {
+  REX_METAL_RENDER_CALL(setDepthClipMode(mode));
